---
/**
 * 목록 페이지 머리: 건수 라벨(.k) → h1 → 한 문장(슬롯의 p.lede).
 * 라벨이 제목과 같은 낱말이면 넘기지 않는다(예: 학습 기록).
 */
interface Props {
  title: string
  /** "6편"처럼 건수만. 제목과 같은 낱말이면 생략한다 */
  label?: string
  category?: string
}
const { title, label, category } = Astro.props
---

<header class="phead">
  {label && <p class="k">{label}</p>}
  <h1 data-cat={category}>{title}</h1>
  <slot />
</header>
<style>
  h1[data-cat]::before {
    width: 12px;
    height: 12px;
    margin-right: 0.4em;
    vertical-align: 0.1em;
  }
</style>

---
/**
 * 목록 페이지 머리(시안): h1 + 건수 배지("6편") → 한 문장(슬롯의 p.lede, 작은 회색) → 슬롯의 나머지.
 * 건수가 제목과 같은 낱말이면 넘기지 않는다(예: 학습 기록).
 */
interface Props {
  title: string
  /** "6편"처럼 건수만 */
  label?: string
}
const { title, label } = Astro.props
---

<header class="phead">
  <h1>
    {title}{
      label && (
        <>
          {' '}
          <span class="count-b">{label}</span>
        </>
      )
    }
  </h1>
  <slot />
</header>

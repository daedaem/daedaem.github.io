---
import { SITE } from '@/consts'
const year = new Date().getFullYear()
---

<footer class="ft">
  <p>© {year} {SITE.author} · {SITE.title}</p>
  {/* 작성자 도구(/admin/)는 바닥글에 두지 않는다. 주소로 직접 연다 */}
  <nav aria-label="바닥글 메뉴">
    <a href="/posts/">글</a>
    <a href="/wiki/">위키</a>
    <a href="/learn/">학습 기록</a>
    <a href="/about/">소개</a>
    <a href="/projects/">프로젝트</a>
    <a href="/rss.xml">RSS</a>
    <a href={SITE.githubUrl} rel="me noopener">GitHub</a>
    <a href={`mailto:${SITE.email}`}>Email</a>
    <a href={SITE.linkedinUrl} rel="me noopener">LinkedIn</a>
  </nav>
</footer>

<style>
  /* 시안의 바닥글: 넓은 폭(1180px) 한 줄, 왼쪽 저작권·오른쪽 링크, 작은 회색 글자. 선 없이 여백으로 나눈다 */
  .ft {
    max-width: 1180px;
    margin: 3rem auto 0;
    padding: 1.5rem 1.25rem 2.5rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.75rem;
    line-height: 1.5;
    color: var(--muted);
    /* 첫 화면 밖이라 다가올 때 그린다(global.css의 content-visibility 설명 참고) */
    content-visibility: auto;
    contain-intrinsic-size: auto 120px;
  }
  p {
    margin: 0;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  /* 짧은 낱말('글')도 누를 수 있게 좌우 여백을 두고, 같은 크기의 음수 바깥 여백으로 글자 간격은 유지한다 */
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    padding: 0 0.5rem;
    margin: 0 -0.5rem;
    color: var(--fg2);
    text-decoration: none;
  }
  a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
</style>

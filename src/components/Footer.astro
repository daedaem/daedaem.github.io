---
import { SITE } from '@/consts'
const year = new Date().getFullYear()
---

<footer>
  <div class="wrap-wide inner">
    <p class="brand"><strong>{SITE.title}</strong><span>© {year} {SITE.author}</span></p>
    <ul>
      <li><a href="/posts/">글</a></li>
      <li><a href="/wiki/">위키</a></li>
      <li><a href="/learn/">학습 기록</a></li>
      <li><a href="/about/">소개</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href={SITE.githubUrl} rel="me noopener">GitHub</a></li>
      <li><a href="/admin/">작성자 안내</a></li>
    </ul>
  </div>
</footer>

<style>
  footer {
    margin-top: 2rem;
    border-top: 1px solid var(--border);
    padding-block: 2rem 3rem;
    font-size: 13px;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  p {
    margin: 0;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    min-height: var(--control-size);
  }
  .brand strong {
    color: var(--text);
    font-weight: 650;
  }
  .brand span {
    color: var(--text-muted);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }
</style>

---
import { SITE } from '@/consts'
const year = new Date().getFullYear()
---

<footer>
  <div class="wrap-wide inner">
    <p class="muted">© {year} {SITE.author}</p>
    <ul>
      <li><a href="/notes/">학습 노트 아카이브</a></li>
      <li><a href="/rss.xml">RSS</a></li>
      <li><a href={SITE.githubUrl} rel="me noopener">GitHub</a></li>
    </ul>
  </div>
</footer>

<style>
  footer {
    margin-top: 5rem;
    border-top: 1px solid var(--border);
    padding-block: 2rem 3rem;
    font-size: 0.875rem;
  }

  .inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
  }

  p {
    margin: 0;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  a {
    color: var(--text-muted);
    text-decoration: none;
  }

  a:hover {
    color: var(--text);
  }
</style>

---
import { SITE } from '@/consts'
const year = new Date().getFullYear()
---

<footer class="ft">
  <p>© {year} {SITE.author} · {SITE.title}</p>
  <nav aria-label="바닥글 메뉴">
    <a href="/posts/">글</a>
    <a href="/wiki/">위키</a>
    <a href="/learn/">학습 기록</a>
    <a href="/about/">소개</a>
    <a href="/rss.xml">RSS</a>
    <a href={SITE.githubUrl} rel="me noopener">GitHub</a>
    <a href="/admin/">작성자 안내</a>
  </nav>
</footer>

<style>
  /* 한 줄: 왼쪽 저작권, 오른쪽 링크. 본문과 같은 45rem 폭 */
  .ft {
    max-width: 45rem;
    margin: 2rem auto 0;
    padding: 1.5rem 1rem 3rem;
    border-top: 1px solid var(--line);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }
  p {
    margin: 0;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    color: var(--fg2);
    text-decoration: none;
  }
  a:hover {
    color: var(--fg);
    text-decoration: underline;
  }
</style>

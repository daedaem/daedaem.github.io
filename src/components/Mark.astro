---
import { MONOGRAM_PATH } from '@/utils/brand.mjs'
/** 사용자 승인 네이비 시안의 dd 모노그램. 이름·별명은 그대로 유지한다. */
interface Props {
  size?: number
  class?: string
}
const { size = 18, class: cls } = Astro.props
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 34 34"
  fill="none"
  aria-hidden="true"
  focusable="false"
>
  <rect width="34" height="34" rx="9" fill="var(--mark-bg)"></rect>
  <path d={MONOGRAM_PATH} stroke="var(--mark-ink)" stroke-width="2.8" stroke-linejoin="round"
  ></path>
</svg>

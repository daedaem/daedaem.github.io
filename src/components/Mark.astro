---
import { MARK_DOT, MARK_PATH, MARK_TILE_TRANSFORM, MARK_VIEWBOX } from '@/utils/brand.mjs'
/** 표식 '절개'. 기본은 헤더용 맨 마크, tile이면 파비콘과 같은 타일 판. */
interface Props {
  size?: number
  tile?: boolean
  class?: string
}
const { size = 20, tile = false, class: cls } = Astro.props
---

<svg
  class={cls}
  width={size}
  height={size}
  viewBox={MARK_VIEWBOX}
  aria-hidden="true"
  focusable="false"
>
  {tile && <rect width="32" height="32" rx="8" fill="var(--mark-bg)" />}
  <g transform={tile ? MARK_TILE_TRANSFORM : undefined}>
    <path d={MARK_PATH} fill-rule="evenodd" fill={tile ? 'var(--mark-ink)' : 'var(--accent)'} />
    <circle cx={MARK_DOT.cx} cy={MARK_DOT.cy} r={MARK_DOT.r} fill="var(--mark-dot)" />
  </g>
</svg>

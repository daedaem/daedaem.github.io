---
// 라이트/다크 전환. 저장값이 없으면 시스템 설정을 따르고, 누르면 실효 테마의 반대로 고정한다.
import Icon from './Icon.astro'
---

<button id="theme-toggle" type="button" aria-label="다크 모드로 전환">
  <Icon name="sun" class="sun" />
  <Icon name="moon" class="moon" />
</button>

<script>
  const btn = document.getElementById('theme-toggle')
  const media = window.matchMedia('(prefers-color-scheme: dark)')
  const themeColor = { light: '#ffffff', dark: '#0a0a0a' }

  function effective(): 'light' | 'dark' {
    const set = document.documentElement.getAttribute('data-theme')
    if (set === 'light' || set === 'dark') return set
    return media.matches ? 'dark' : 'light'
  }

  // 다음 동작을 이름으로 알리는 일반 버튼이므로 aria-pressed는 쓰지 않는다.
  function sync() {
    if (!btn) return
    const theme = effective()
    btn.setAttribute('aria-label', theme === 'dark' ? '라이트 모드로 전환' : '다크 모드로 전환')
    // 저장한 테마가 시스템 설정과 다르면 브라우저 틀 색도 실효 테마를 따르게 한다
    for (const meta of document.querySelectorAll('meta[name="theme-color"]'))
      meta.setAttribute('content', themeColor[theme])
  }

  btn?.addEventListener('click', () => {
    const next = effective() === 'dark' ? 'light' : 'dark'
    document.documentElement.setAttribute('data-theme', next)
    try {
      localStorage.setItem('theme', next)
    } catch {}
    sync()
    // 댓글 iframe처럼 테마를 따로 맞춰야 하는 곳에 알린다
    document.dispatchEvent(new CustomEvent('themechange', { detail: next }))
  })

  // 저장값이 없을 때 시스템 설정이 바뀌면 라벨도 따라간다
  media.addEventListener('change', sync)
  sync()
</script>

<style>
  #theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--control-size);
    height: var(--control-size);
    flex-shrink: 0;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }

  #theme-toggle:hover {
    background: var(--soft);
    color: var(--fg);
  }

  #theme-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* 라이트에서는 달, 다크에서는 해를 보여 준다 (누르면 바뀔 테마) */
  #theme-toggle :global(.sun) {
    display: none;
  }

  :global(:root[data-theme='dark']) #theme-toggle :global(.sun) {
    display: block;
  }
  :global(:root[data-theme='dark']) #theme-toggle :global(.moon) {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) #theme-toggle :global(.sun) {
      display: block;
    }
    :global(:root:not([data-theme='light'])) #theme-toggle :global(.moon) {
      display: none;
    }
  }
</style>

---
import { getCategory } from '@/consts'
import { formatDate } from '@/utils/format'

interface Props {
  href: string
  title: string
  description: string
  date: Date
  category?: string
  readingMinutes?: number
  /** 목록 맨 위 한 편을 넓게 세운다 */
  featured?: boolean
}

const { href, title, description, date, category, readingMinutes, featured = false } = Astro.props
const cat = category ? getCategory(category) : undefined
---

<a class:list={['card', { featured }]} href={href}>
  {cat && <span class="cat">{cat.name}</span>}
  <h2>{title}</h2>
  {description && <p>{description}</p>}
  <div class="meta">
    <time datetime={date.toISOString()}>{formatDate(date)}</time>
    {readingMinutes && <span>· {readingMinutes}분</span>}
  </div>
</a>

<style>
  .card {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    background: var(--bg);
    transition:
      border-color 0.15s ease,
      background 0.15s ease;
  }

  .card:hover {
    border-color: var(--border-strong);
    background: var(--bg-card);
  }

  .featured {
    grid-column: 1 / -1;
    background: var(--bg-card);
    padding: 26px 26px 28px;
  }

  .cat {
    font-size: 13px;
    font-weight: 600;
    color: var(--accent);
  }

  h2 {
    margin: 10px 0 0;
    font-size: 19px;
    line-height: 1.55;
  }

  .featured h2 {
    font-size: 26px;
    max-width: 46rem;
  }

  p {
    margin: 10px 0 0;
    font-size: 14.5px;
    line-height: 1.75;
    color: var(--text-muted);
  }

  .featured p {
    font-size: 15.5px;
    line-height: 1.8;
    max-width: 44rem;
  }

  .meta {
    margin-top: 16px;
    font-size: 13px;
    color: var(--text-dim);
    display: flex;
    gap: 5px;
  }

  .featured .meta {
    margin-top: 18px;
    font-size: 13.5px;
  }
</style>

---
/**
 * 학습 기록·알고리즘·학습 노트 목록을 오가는 알약 링크 줄. 각 목록 머리(.phead) 아래에 둔다.
 * 지금 페이지의 알약만 검은 면이다. 상세 페이지에는 두지 않는다.
 */
const path = Astro.url.pathname
const links = [
  { href: '/learn/', label: '학습 기록' },
  { href: '/algorithms/', label: '알고리즘' },
  { href: '/notes/', label: '학습 노트' },
]
---

<nav class="chips subnav" aria-label="학습 기록 탐색" data-pagefind-ignore>
  {
    links.map((link) => (
      <a
        class="chip"
        href={link.href}
        aria-current={
          // 목록 페이지에서만 '현재 페이지'이고, 그 아래 상세 페이지에서는 '현재 구역'이다
          path === link.href ? 'page' : path.startsWith(link.href) ? 'true' : undefined
        }
      >
        {link.label}
      </a>
    ))
  }
</nav>

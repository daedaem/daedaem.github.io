---
import { getCategory } from '@/consts'
import ContentDates from './ContentDates.astro'
import PostCover from './PostCover.astro'
import type { PostCoverData } from '@/utils/editorial.mjs'

interface Props {
  href: string
  title: string
  date: Date
  updated?: Date
  category?: string
  readingMinutes?: number
  /** 목록 페이지에서는 한 줄 요약을 같이 보여 준다. 홈처럼 제목만 둘 때는 생략한다. */
  description?: string
  compact?: boolean
  editorial?: boolean
  cover?: PostCoverData
}

const {
  href,
  title,
  date,
  updated,
  category,
  readingMinutes,
  description,
  compact = false,
  editorial = false,
  cover,
} = Astro.props
const cat = category ? getCategory(category) : undefined
---

<li class:list={['row', { 'no-cat': !cat, editorial, 'with-cover': !!cover }]}>
  <div class="row-content">
    {
      cat && (
        <span class="cat" data-cat={cat.id}>
          {cat.name}
        </span>
      )
    }
    <span class="body">
      <a class="title" href={href}>{title}</a>
      {!compact && description && <span class="desc">{description}</span>}
    </span>
    <span class="meta">
      <ContentDates date={date} updated={updated} compact />
      {readingMinutes && <span>{readingMinutes}분</span>}
    </span>
    {
      cover && (
        <div class="row-cover">
          <PostCover kind={cover.kind} src={cover.src} thumbnail />
        </div>
      )
    }
  </div>
</li>

<style>
  .row {
    position: relative;
    border-top: 1px solid var(--border);
  }

  .row-content {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0 16px;
    padding: 15px 0;
  }

  /* 카테고리 페이지처럼 라벨이 없는 곳에서는 첫 열을 비워 두지 않는다 */
  .row.no-cat .row-content {
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .title::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 4px;
  }
  .title:focus-visible {
    outline: none;
  }
  .title:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .cat {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-muted);
    white-space: nowrap;
  }

  .body {
    display: block;
    min-width: 0;
  }

  .title {
    display: block;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.02em;
  }

  .row:hover .title {
    color: var(--accent);
  }

  .desc {
    display: block;
    margin-top: 4px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 13px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .row.editorial .row-content {
    grid-template-columns: minmax(0, 1fr);
    gap: 0.375rem;
    padding: 1.375rem 0;
  }
  .editorial .cat {
    font-size: 13px;
    font-weight: 400;
  }
  .editorial .cat::before {
    display: none;
  }
  .editorial .title {
    font-size: 17px;
  }
  .editorial .meta {
    flex-direction: row;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .row.with-cover .row-content {
    grid-template-columns: minmax(0, 1fr) 9rem;
    grid-template-areas: 'cat cover' 'title cover' 'desc desc' 'meta meta';
    grid-template-rows: min-content 1fr auto auto;
    align-items: start;
    gap: 0.5rem 1.25rem;
    padding: 1.375rem 0;
  }
  .row.with-cover.no-cat .row-content {
    grid-template-areas: 'title cover' 'desc desc' 'meta meta';
    grid-template-rows: auto auto auto;
  }
  .with-cover .body {
    display: contents;
  }
  .with-cover .cat {
    grid-area: cat;
  }
  .with-cover .title {
    grid-area: title;
  }
  .with-cover .desc {
    grid-area: desc;
    margin-top: 0;
  }
  .with-cover .meta {
    grid-area: meta;
    flex-direction: row;
    flex-wrap: wrap;
  }
  .row-cover {
    grid-area: cover;
    min-width: 0;
    pointer-events: none;
  }

  @media (max-width: 640px) {
    .row-content,
    .row.no-cat .row-content {
      grid-template-columns: 1fr;
      gap: 3px 0;
    }
    .meta {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.15rem 0.75rem;
    }
    .row.with-cover .row-content {
      grid-template-columns: minmax(0, 1fr) 5.5rem;
      column-gap: 1rem;
    }
  }
</style>

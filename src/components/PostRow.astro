---
import { getCategory } from '@/consts'
import { formatCompactDate } from '@/utils/format'

/**
 * 목록 행. 위줄(.k) "●분류 · 2026.09.24" → 제목 → 요약(.row-d) 또는 원인 한 줄(.row-c).
 * 표지 썸네일과 읽기 시간은 두지 않는다. 행 전체가 링크다.
 * 위줄은 [prefix] · [분류(점) | label(점)] · [extra] · 날짜 순으로 있는 것만 잇는다.
 */
interface Props {
  href: string
  title: string
  date: Date
  /** 글 분류 id. 점은 [data-cat]::before가 그린다 */
  category?: string
  /** 분류 대신 쓰는 이름(위키 주제 등). hue가 있으면 색점을 앞에 붙인다 */
  label?: string
  hue?: number
  /** 위줄 맨 앞 글자(예: '아카이브', '위키') */
  prefix?: string
  /** 이름과 날짜 사이의 글자(예: '정리됨') */
  extra?: string
  /** 한 줄 요약. cause가 있으면 대신 원인 한 줄을 보인다 */
  description?: string
  cause?: string
  /** 목록 스크립트가 행을 찾는 열쇠(li의 data-id) */
  dataId?: string
}

const { href, title, date, category, label, hue, prefix, extra, description, cause, dataId } =
  Astro.props
const cat = category ? getCategory(category) : undefined
const name = cat?.name ?? label
---

<li class="row" data-id={dataId}>
  <a class="row-a" href={href}>
    <span class="row-b">
      <span class="k">
        {prefix}
        {
          prefix && (name || extra) && (
            <span class="sep" aria-hidden="true">
              ·
            </span>
          )
        }
        {
          cat && (
            <span data-cat={cat.id}>
              <span class="name">{cat.name}</span>
            </span>
          )
        }
        {
          !cat && label && (
            <span class="topic">
              {hue !== undefined && <i class="dot hue" style={`--wt: ${hue}`} aria-hidden="true" />}
              <span class="name">{label}</span>
            </span>
          )
        }
        {
          name && extra && (
            <span class="sep" aria-hidden="true">
              ·
            </span>
          )
        }
        {extra}
        {
          (prefix || name || extra) && (
            <span class="sep" aria-hidden="true">
              ·
            </span>
          )
        }
        <time datetime={date.toISOString()}>{formatCompactDate(date)}</time>
      </span>
      <span class="row-t">{title}</span>
      {
        cause ? (
          <span class="row-c">
            <span class="row-ck">원인</span>
            {cause}
          </span>
        ) : (
          description && <span class="row-d">{description}</span>
        )
      }
    </span>
  </a>
</li>

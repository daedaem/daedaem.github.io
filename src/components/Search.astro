---
// Pagefind는 빌드 후 dist/pagefind 에 생성된다. 개발 서버에서는 동작하지 않는다.
import { SEARCH_SCOPES } from '@/utils/search-scope.mjs'
---

<button
  id="search-open"
  type="button"
  aria-label="검색 열기"
  aria-haspopup="dialog"
  aria-controls="search-dialog"
>
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span>검색</span>
  <kbd id="search-shortcut">Ctrl K</kbd>
</button>

<dialog id="search-dialog" aria-label="검색">
  <div class="search-heading">
    <span>글·위키·학습 기록 검색</span>
    <button id="search-close" type="button" aria-label="검색 닫기">닫기 ×</button>
  </div>
  <label class="search-scope" id="search-scope-label" hidden>
    검색 범위
    <select id="search-scope" class="list-input">
      <option value="">전체</option>
      {SEARCH_SCOPES.map((scope) => <option value={scope}>{scope}</option>)}
    </select>
  </label>
  <p id="search-status" class="visually-hidden" role="status" aria-atomic="true"></p>
  <p id="search-partial" class="search-partial" hidden>
    입력한 낱말과 똑같이 일치하는 곳이 없어, 앞부분이 같은 낱말로 찾은 결과입니다.
  </p>
  <p id="search-weak" class="search-partial" hidden>
    <strong id="search-weak-term"></strong>에 맞는 결과가 없습니다. 낱말을 줄이거나 다른 말로 찾아
    보세요.
  </p>
  <div id="search-mount"></div>
</dialog>

<script>
  import { dismissSearchForAnchor } from '@/utils/search-navigation.mjs'
  const openBtn = document.getElementById('search-open') as HTMLButtonElement | null
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null
  const mount = document.getElementById('search-mount')
  const closeBtn = document.getElementById('search-close')
  const shortcut = document.getElementById('search-shortcut')
  const scope = document.getElementById('search-scope') as HTMLSelectElement
  const scopeLabel = document.getElementById('search-scope-label')!
  let searchUI:
    | {
        triggerFilters: (filters: Record<string, string[]>) => void
        triggerSearch: (term: string) => void
      }
    | undefined
  scope.addEventListener('change', () => {
    searchUI?.triggerFilters({ 구분: scope.value ? [scope.value] : [] })
  })
  if (shortcut)
    shortcut.textContent = /Macintosh|Mac OS X|iPhone|iPad|iPod/.test(navigator.userAgent)
      ? '⌘K'
      : 'Ctrl K'
  let loaded = false
  let loading: Promise<void> | undefined

  async function ensureLoaded() {
    if (loaded || !mount) return
    // Pagefind 번들은 astro build 이후에 생성되므로 번들러가 미리 해석하면 안 된다.
    // 경로를 변수에 담아 정적 분석을 피한다.
    const base = '/pagefind/'

    if (!document.getElementById('pagefind-css')) {
      const css = document.createElement('link')
      css.id = 'pagefind-css'
      css.rel = 'stylesheet'
      css.href = base + 'pagefind-ui.css'
      document.head.appendChild(css)
    }

    // pagefind-ui.js는 ES 모듈이 아니라 window.PagefindUI에 붙는 일반 스크립트다.
    // 문서대로 <script> 태그로 싣는다. import()로 실으면 Pagefind가 자기 경로를 찾지 못한다.
    await new Promise<void>((resolve, reject) => {
      const s = document.createElement('script')
      s.src = base + 'pagefind-ui.js'
      s.onload = () => resolve()
      s.onerror = () => {
        s.remove()
        reject(new Error('pagefind-ui.js load failed'))
      }
      document.head.appendChild(s)
    }).catch(() => {})
    const PagefindUI = (window as any).PagefindUI
    if (!PagefindUI) {
      mount.textContent = '검색을 불러오지 못했습니다. 연결을 확인한 뒤 검색창을 다시 열어 주세요.'
      return
    }
    mount.replaceChildren()
    searchUI = new PagefindUI({
      element: '#search-mount',
      bundlePath: base,
      showSubResults: true,
      showImages: false,
      pageSize: 8,
      // 기본값(0.75)은 긴 글을 크게 깎아, 주제를 깊게 다룬 사례 글이 스치듯 언급한 짧은 문서보다
      // 뒤로 밀린다('주소' → 브라우저 렌더링 위키가 1위). 0.3이면 사례 글이 앞선다.
      ranking: { pageLength: 0.3 },
      translations: {
        placeholder: '검색어를 입력하세요',
        clear_search: '지우기',
        load_more: '더 보기',
        search_label: '검색',
        zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다',
        many_results: '"[SEARCH_TERM]" 결과 [COUNT]건',
        one_result: '"[SEARCH_TERM]" 결과 1건',
        searching: '검색 중…',
      },
    })
    scopeLabel.hidden = false
    loaded = true
  }

  async function open() {
    if (!dialog) return
    if (!dialog.open) dialog.showModal()
    if (!loaded && !loading) {
      if (mount) mount.textContent = '검색을 준비하고 있습니다…'
      loading = ensureLoaded()
        .catch(() => {
          if (mount) mount.textContent = '검색을 시작하지 못했습니다. 창을 닫고 다시 열어 주세요.'
        })
        .finally(() => {
          loading = undefined
        })
    }
    await loading
    if (dialog.open) dialog.querySelector<HTMLInputElement>('input')?.focus()
  }

  /*
   * Pagefind UI는 결과 수와 '결과 없음'을 스크린리더에 알리지 않는다. 결과가 다 그려진 뒤
   * 문구를 상태 영역에 옮겨 한 번만 읽히게 한다. 같은 문구는 다시 넣지 않는다.
   * 또 색인에 없는 낱말은 앞 글자만 같은 낱말로 채워지므로(kafka → k), 첫 쪽 강조 중
   * 검색어 전체를 담은 것이 없으면 그 사실을 화면에 적는다.
   */
  const status = document.getElementById('search-status')
  const partial = document.getElementById('search-partial')
  const weak = document.getElementById('search-weak')
  const weakTerm = document.getElementById('search-weak-term')
  let settle: number | undefined
  function describeResults() {
    if (!mount || !status || !partial || !weak || !weakTerm) return
    const message = mount.querySelector('.pagefind-ui__message')?.textContent?.trim() ?? ''
    const raw = mount.querySelector<HTMLInputElement>('input')?.value.trim() ?? ''
    const marks = [...mount.querySelectorAll('mark')].map((m) => m.textContent?.toLowerCase() ?? '')
    const terms = raw.toLowerCase().split(/\s+/).filter(Boolean)
    const missing = terms.filter((term) => !marks.some((mark) => mark.includes(term)))
    const isPartial = marks.length > 0 && missing.length > 0
    // 'qwxzv'가 'q' 한 글자로 채워지듯, 맞은 앞부분이 낱말의 절반에 못 미치면 결과가 없는 것과 같다.
    const isWeak =
      isPartial && missing.every((term) => weakestPrefix(term, marks) < Math.ceil(term.length / 2))
    mount.classList.toggle('is-weak', isWeak)
    weak.hidden = !isWeak
    weakTerm.textContent = `"${raw}"`
    partial.hidden = !isPartial || isWeak
    const text = isWeak
      ? weak.textContent!.replace(/\s+/g, ' ').trim()
      : message && isPartial
        ? `${message}. ${partial.textContent?.trim()}`
        : message
    if (status.textContent !== text) status.textContent = text
  }
  /** 강조된 낱말 가운데 검색어와 앞부분이 가장 길게 같은 글자 수 */
  function weakestPrefix(term: string, marks: string[]) {
    let best = 0
    for (const mark of marks) {
      const word = mark.replace(/[^\p{L}\p{N}]/gu, '')
      let n = 0
      while (n < word.length && n < term.length && word[n] === term[n]) n++
      best = Math.max(best, n)
    }
    return best
  }
  if (mount)
    new MutationObserver(() => {
      clearTimeout(settle)
      settle = window.setTimeout(describeResults, 400)
    }).observe(mount, { childList: true, subtree: true, characterData: true })

  /*
   * 키보드로 결과를 고른다. 입력창에서 ↓는 첫 결과로, 결과에서 ↑↓는 이웃 결과로 옮긴다.
   * 입력창에서 Enter는 첫 결과를 연다(한글 조합 중인 Enter는 건드리지 않는다).
   */
  const links = () =>
    mount?.classList.contains('is-weak')
      ? []
      : [...(mount?.querySelectorAll<HTMLAnchorElement>('a.pagefind-ui__result-link') ?? [])]
  mount?.addEventListener('keydown', (event) => {
    if (event.isComposing) return
    const input = mount.querySelector<HTMLInputElement>('input')
    const all = links()
    const at = all.indexOf(document.activeElement as HTMLAnchorElement)
    if (event.key === 'ArrowDown' && all.length) {
      event.preventDefault()
      all[Math.min(at + 1, all.length - 1)].focus()
    } else if (event.key === 'ArrowUp' && at >= 0) {
      event.preventDefault()
      ;(at === 0 ? input : all[at - 1])?.focus()
    } else if (event.key === 'Enter' && event.target === input && all.length) {
      event.preventDefault()
      all[0].click()
    }
  })

  // 다른 화면(위키 빈 결과, 404)에서 검색어를 넘겨 검색창을 연다.
  addEventListener('site-search', async (event) => {
    await open()
    const term = (event as CustomEvent<string>).detail
    if (term && searchUI) searchUI.triggerSearch(term)
  })

  openBtn?.addEventListener('click', open)
  closeBtn?.addEventListener('click', () => dialog?.close())
  mount?.addEventListener('click', (event) => {
    dismissSearchForAnchor(event, dialog, location.href)
  })

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault()
      dialog?.open ? dialog.close() : open()
    }
  })

  // 대화상자 내부의 빈 여백이 아니라 실제 바깥 영역을 눌렀을 때만 닫는다.
  dialog?.addEventListener('click', (e) => {
    if (e.target !== dialog) return
    const rect = dialog.getBoundingClientRect()
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      dialog.close()
    }
  })
</script>

<style is:global>
  .search-scope {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.75rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .search-scope select {
    width: auto;
    min-width: 9rem;
  }
  /* The native selector above controls the same filters without a second filter panel. */
  #search-mount .pagefind-ui__filter-panel {
    display: none;
  }
  /*
   * 검색 결과 링크는 글자 높이가 20–23px이라 손가락으로 누르기 어렵다.
   * 여백으로 누르는 영역을 제어 크기까지 넓히고, 같은 크기의 음수 바깥 여백으로
   * 되돌려 결과 목록이 세로로 길어지지 않게 한다.
   */
  #search-mount .pagefind-ui__result-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    padding-block: 0.375rem;
    margin-block: -0.375rem;
  }
  /* Pagefind 기본값은 안내 글자를 opacity 0.2로 흐리게 해 배경 대비가 1.5:1까지 떨어진다 */
  #search-mount .pagefind-ui__search-input::placeholder {
    color: var(--text-muted);
    opacity: 1;
  }
  #search-mount.is-weak .pagefind-ui__drawer {
    display: none;
  }
  #search-mount .pagefind-ui__result-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #search-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: var(--control-size);
    min-width: var(--control-size);
    padding: 0 0.6rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  #search-open:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  #search-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #search-open kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.7;
  }

  #search-dialog {
    width: min(38rem, 92vw);
    margin-top: 12vh;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    /* 결과가 길면 대화상자 안에서 스크롤한다. 없으면 뷰포트 높이에서 그대로 잘린다 */
    max-height: min(72vh, calc(100vh - 14vh - 2rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    /* 결과를 거꾸로 훑을 때 초점 받은 링크가 위에 붙은 제목 띠 밑으로 숨지 않게 한다 */
    scroll-padding-top: 4.5rem;
  }
  .search-partial {
    margin: 0 0 0.75rem;
    padding: 0.5rem 0.75rem;
    border-left: 2px solid var(--border-strong);
    color: var(--text-muted);
    font-size: 0.8125rem;
  }
  #search-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  .search-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    position: sticky;
    top: -1rem;
    z-index: 1;
    margin: -1rem -1rem 0.75rem;
    padding: 0.5rem 1rem;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  #search-close {
    min-width: 44px;
    min-height: 44px;
    padding: 0.5rem;
    border: 0;
    border-radius: 6px;
    background: var(--bg-subtle);
    color: var(--text);
    font: inherit;
    cursor: pointer;
  }
  #search-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  #search-dialog {
    --pagefind-ui-primary: var(--text);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-font: var(--font-sans);
    --pagefind-ui-scale: 0.9;
  }

  /* 좁은 화면과 터치 기기에서는 단축키 안내가 의미 없으므로 숨기고, '검색' 글자는 남긴다 */
  @media (max-width: 40rem), (hover: none) {
    #search-open kbd {
      display: none;
    }
  }
</style>

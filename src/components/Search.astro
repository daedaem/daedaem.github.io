---
// Pagefind는 빌드 후 dist/pagefind 에 생성된다. 개발 서버에서는 동작하지 않는다.
---

<button id="search-open" type="button" aria-label="검색 열기">
  <svg
    width="15"
    height="15"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2.2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span>검색</span>
  <kbd>⌘K</kbd>
</button>

<dialog id="search-dialog" aria-label="검색">
  <div id="search-mount"></div>
</dialog>

<script>
  const openBtn = document.getElementById('search-open') as HTMLButtonElement | null
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null
  const mount = document.getElementById('search-mount')
  let loaded = false

  async function ensureLoaded() {
    if (loaded || !mount) return
    loaded = true
    // Pagefind 번들은 astro build 이후에 생성되므로 번들러가 미리 해석하면 안 된다.
    // 경로를 변수에 담아 정적 분석을 피한다.
    const base = '/pagefind/'

    const css = document.createElement('link')
    css.rel = 'stylesheet'
    css.href = base + 'pagefind-ui.css'
    document.head.appendChild(css)

    // pagefind-ui.js는 ES 모듈이 아니라 window.PagefindUI에 붙는 일반 스크립트다.
    // 문서대로 <script> 태그로 싣는다. import()로 실으면 Pagefind가 자기 경로를 찾지 못한다.
    await new Promise<void>((resolve, reject) => {
      const s = document.createElement('script')
      s.src = base + 'pagefind-ui.js'
      s.onload = () => resolve()
      s.onerror = () => reject(new Error('pagefind-ui.js load failed'))
      document.head.appendChild(s)
    }).catch(() => {})
    const PagefindUI = (window as any).PagefindUI
    if (!PagefindUI) {
      mount.textContent = '검색 색인을 불러오지 못했습니다. 빌드 후에만 동작합니다.'
      return
    }
    new PagefindUI({
      element: '#search-mount',
      bundlePath: base,
      showSubResults: true,
      showImages: false,
      pageSize: 8,
      translations: {
        placeholder: '검색어를 입력하세요',
        clear_search: '지우기',
        load_more: '더 보기',
        search_label: '검색',
        zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다',
        many_results: '"[SEARCH_TERM]" 결과 [COUNT]건',
        one_result: '"[SEARCH_TERM]" 결과 1건',
        searching: '검색 중…',
      },
    })
  }

  async function open() {
    if (!dialog) return
    await ensureLoaded()
    dialog.showModal()
    dialog.querySelector<HTMLInputElement>('input')?.focus()
  }

  openBtn?.addEventListener('click', open)

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault()
      dialog?.open ? dialog.close() : open()
    }
  })

  // 바깥을 누르면 닫는다
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close()
  })
</script>

<style is:global>
  #search-open {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    height: 34px;
    padding: 0 0.6rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  #search-open:hover {
    border-color: var(--accent);
    color: var(--text);
  }
  #search-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #search-open kbd {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    opacity: 0.7;
  }

  #search-dialog {
    width: min(38rem, 92vw);
    margin-top: 12vh;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--bg);
    color: var(--text);
    /* 결과가 길면 대화상자 안에서 스크롤한다. 없으면 뷰포트 높이에서 그대로 잘린다 */
    max-height: min(72vh, calc(100vh - 14vh - 2rem));
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  #search-dialog::backdrop {
    background: rgb(0 0 0 / 0.45);
  }

  :root {
    --pagefind-ui-primary: var(--text);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--border);
    --pagefind-ui-tag: var(--bg-subtle);
    --pagefind-ui-font: var(--font-sans);
    --pagefind-ui-scale: 0.9;
  }

  /* 좁은 화면과 터치 기기에서는 단축키 안내가 의미 없으므로 돋보기만 남긴다 */
  @media (max-width: 40rem), (hover: none) {
    #search-open span,
    #search-open kbd {
      display: none;
    }
    #search-open {
      width: 34px;
      padding: 0;
      justify-content: center;
    }
  }
</style>

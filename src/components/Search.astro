---
// Pagefind는 빌드 후 dist/pagefind 에 생성된다. 개발 서버에서는 동작하지 않는다.
import { SEARCH_SCOPES } from '@/utils/search-scope.mjs'
---

<button
  id="search-open"
  type="button"
  aria-haspopup="dialog"
  aria-controls="search-dialog"
  aria-keyshortcuts="Control+K"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="tb-l">검색</span>
  <kbd id="search-shortcut" aria-hidden="true">Ctrl K</kbd>
</button>

<dialog id="search-dialog" class="cmd" aria-label="검색">
  <div class="search-heading">
    <label class="search-scope" id="search-scope-label" hidden>
      검색 범위
      <select id="search-scope" class="list-input">
        <option value="">전체</option>
        {SEARCH_SCOPES.map((scope) => <option value={scope}>{scope}</option>)}
      </select>
    </label>
    <button id="search-close" type="button" aria-label="검색 닫기">닫기</button>
  </div>
  <div id="search-mount"></div>
  <p id="search-status" class="visually-hidden" role="status" aria-atomic="true"></p>
  <p id="search-partial" class="search-partial" hidden>
    입력한 낱말과 똑같이 일치하는 곳이 없어, 앞부분이 같은 낱말로 찾은 결과입니다.
  </p>
  <p id="search-weak" class="search-partial" hidden>
    <strong id="search-weak-term"></strong>에 맞는 결과가 없습니다. 낱말을 줄이거나 다른 말로 찾아
    보세요.
  </p>
  <nav id="search-help" class="search-help" aria-label="목록에서 찾기" hidden>
    목록에서 찾기:
    <a href="/posts/">글</a>
    <a href="/wiki/">위키</a>
    <a href="/notes/">학습 노트</a>
    <a href="/algorithms/">알고리즘</a>
  </nav>
  <p class="cmd-foot">
    <span><kbd>↑</kbd><kbd>↓</kbd> 이동</span>
    <span><kbd>↵</kbd> 열기</span>
    <span><kbd>Esc</kbd> 닫기</span>
  </p>
</dialog>

<script>
  import { dismissSearchForAnchor } from '@/utils/search-navigation.mjs'
  const openBtn = document.getElementById('search-open') as HTMLButtonElement | null
  const dialog = document.getElementById('search-dialog') as HTMLDialogElement | null
  const mount = document.getElementById('search-mount')
  const closeBtn = document.getElementById('search-close')
  const shortcut = document.getElementById('search-shortcut')
  const scope = document.getElementById('search-scope') as HTMLSelectElement
  const scopeLabel = document.getElementById('search-scope-label')!
  let searchUI:
    | {
        triggerFilters: (filters: Record<string, string[]>) => void
        triggerSearch: (term: string) => void
      }
    | undefined
  scope.addEventListener('change', () => {
    searchUI?.triggerFilters({ 구분: scope.value ? [scope.value] : [] })
  })
  if (shortcut)
    shortcut.textContent = /Macintosh|Mac OS X|iPhone|iPad|iPod/.test(navigator.userAgent)
      ? '⌘K'
      : 'Ctrl K'
  let loaded = false
  let loading: Promise<void> | undefined

  // Pagefind UI의 입력은 title(안내 문구)만 있어 이름이 없다. 짧은 이름을 따로 붙인다.
  function labelInput() {
    const input = mount?.querySelector<HTMLInputElement>('input')
    if (input && !input.hasAttribute('aria-label')) input.setAttribute('aria-label', '검색어')
    return input
  }

  async function ensureLoaded() {
    if (loaded || !mount) return
    // Pagefind 번들은 astro build 이후에 생성되므로 번들러가 미리 해석하면 안 된다.
    // 경로를 변수에 담아 정적 분석을 피한다.
    const base = '/pagefind/'

    if (!document.getElementById('pagefind-css')) {
      const css = document.createElement('link')
      css.id = 'pagefind-css'
      css.rel = 'stylesheet'
      css.href = base + 'pagefind-ui.css'
      document.head.appendChild(css)
    }

    // pagefind-ui.js는 ES 모듈이 아니라 window.PagefindUI에 붙는 일반 스크립트다.
    // 문서대로 <script> 태그로 싣는다. import()로 실으면 Pagefind가 자기 경로를 찾지 못한다.
    await new Promise<void>((resolve, reject) => {
      const s = document.createElement('script')
      s.src = base + 'pagefind-ui.js'
      s.onload = () => resolve()
      s.onerror = () => {
        s.remove()
        reject(new Error('pagefind-ui.js load failed'))
      }
      document.head.appendChild(s)
    }).catch(() => {})
    const PagefindUI = (window as any).PagefindUI
    if (!PagefindUI) {
      mount.textContent = '검색을 불러오지 못했습니다. 연결을 확인한 뒤 검색창을 다시 열어 주세요.'
      return
    }
    mount.replaceChildren()
    searchUI = new PagefindUI({
      element: '#search-mount',
      bundlePath: base,
      showSubResults: true,
      showImages: false,
      pageSize: 8,
      // 기본값(0.75)은 긴 글을 크게 깎아, 주제를 깊게 다룬 사례 글이 스치듯 언급한 짧은 문서보다
      // 뒤로 밀린다('주소' → 브라우저 렌더링 위키가 1위). 0.3이면 사례 글이 앞선다.
      ranking: { pageLength: 0.3 },
      // 결과가 글인지 위키인지 학습 노트인지 제목 앞에 붙인다(범위 필터와 같은 이름).
      processResult: (result: { filters?: Record<string, string[]>; meta: { title?: string } }) => {
        const kind = result.filters?.['구분']?.[0]
        if (kind && result.meta.title) result.meta.title = `${kind} · ${result.meta.title}`
        return result
      },
      translations: {
        placeholder: '검색어를 입력하세요',
        clear_search: '지우기',
        load_more: '더 보기',
        search_label: '검색',
        zero_results: '"[SEARCH_TERM]"에 대한 결과가 없습니다',
        many_results: '"[SEARCH_TERM]" 결과 [COUNT]건',
        one_result: '"[SEARCH_TERM]" 결과 1건',
        searching: '검색 중…',
      },
    })
    labelInput()
    scopeLabel.hidden = false
    loaded = true
  }

  async function open() {
    if (!dialog) return
    if (!dialog.open) dialog.showModal()
    if (!loaded && !loading) {
      if (mount) mount.textContent = '검색을 준비하고 있습니다…'
      loading = ensureLoaded()
        .catch(() => {
          if (mount) mount.textContent = '검색을 시작하지 못했습니다. 창을 닫고 다시 열어 주세요.'
        })
        .finally(() => {
          loading = undefined
        })
    }
    await loading
    if (dialog.open) labelInput()?.focus()
  }

  /*
   * Pagefind UI는 결과 수와 '결과 없음'을 스크린리더에 알리지 않는다. 결과가 다 그려진 뒤
   * 문구를 상태 영역에 옮겨 한 번만 읽히게 한다. 같은 문구는 다시 넣지 않는다.
   * 또 색인에 없는 낱말은 앞 글자만 같은 낱말로 채워지므로(kafka → k), 첫 쪽 강조 중
   * 검색어 전체를 담은 것이 없으면 그 사실을 화면에 적는다.
   */
  const status = document.getElementById('search-status')
  const partial = document.getElementById('search-partial')
  const weak = document.getElementById('search-weak')
  const weakTerm = document.getElementById('search-weak-term')
  let settle: number | undefined
  function describeResults() {
    if (!mount || !status || !partial || !weak || !weakTerm) return
    labelInput()
    const message = mount.querySelector('.pagefind-ui__message')?.textContent?.trim() ?? ''
    const raw = mount.querySelector<HTMLInputElement>('input')?.value.trim() ?? ''
    const marks = [...mount.querySelectorAll('mark')].map((m) => m.textContent?.toLowerCase() ?? '')
    const terms = raw.toLowerCase().split(/\s+/).filter(Boolean)
    const missing = terms.filter((term) => !marks.some((mark) => mark.includes(term)))
    const isPartial = marks.length > 0 && missing.length > 0
    // 'qwxzv'가 'q' 한 글자로 채워지듯, 맞은 앞부분이 낱말의 절반에 못 미치면 결과가 없는 것과 같다.
    const isWeak =
      isPartial && missing.every((term) => weakestPrefix(term, marks) < Math.ceil(term.length / 2))
    mount.classList.toggle('is-weak', isWeak)
    // 결과가 없거나 사실상 없을 때는 목록으로 가는 길을 함께 보인다.
    const zero = !!raw && !isWeak && !mount.querySelector('.pagefind-ui__result')
    document.getElementById('search-help')!.hidden = !(isWeak || (zero && message))
    weak.hidden = !isWeak
    weakTerm.textContent = `"${raw}"`
    partial.hidden = !isPartial || isWeak
    const text = isWeak
      ? weak.textContent!.replace(/\s+/g, ' ').trim()
      : message && isPartial
        ? `${message}. ${partial.textContent?.trim()}`
        : message
    if (status.textContent !== text) status.textContent = text
  }
  /** 강조된 낱말 가운데 검색어와 앞부분이 가장 길게 같은 글자 수 */
  function weakestPrefix(term: string, marks: string[]) {
    let best = 0
    for (const mark of marks) {
      const word = mark.replace(/[^\p{L}\p{N}]/gu, '')
      let n = 0
      while (n < word.length && n < term.length && word[n] === term[n]) n++
      best = Math.max(best, n)
    }
    return best
  }
  if (mount)
    new MutationObserver(() => {
      clearTimeout(settle)
      settle = window.setTimeout(describeResults, 400)
    }).observe(mount, { childList: true, subtree: true, characterData: true })

  /*
   * 키보드로 결과를 고른다. 입력창에서 ↓는 첫 결과로, 결과에서 ↑↓는 이웃 결과로 옮긴다.
   * 입력창에서 Enter는 첫 결과를 연다(한글 조합 중인 Enter는 건드리지 않는다).
   */
  const links = () =>
    mount?.classList.contains('is-weak')
      ? []
      : [...(mount?.querySelectorAll<HTMLAnchorElement>('a.pagefind-ui__result-link') ?? [])]
  mount?.addEventListener('keydown', (event) => {
    if (event.isComposing) return
    const input = mount.querySelector<HTMLInputElement>('input')
    const all = links()
    const at = all.indexOf(document.activeElement as HTMLAnchorElement)
    if (event.key === 'ArrowDown' && all.length) {
      event.preventDefault()
      all[Math.min(at + 1, all.length - 1)].focus()
    } else if (event.key === 'ArrowUp' && at >= 0) {
      event.preventDefault()
      ;(at === 0 ? input : all[at - 1])?.focus()
    } else if (event.key === 'Enter' && event.target === input && all.length) {
      event.preventDefault()
      all[0].click()
    }
  })

  // 다른 화면(위키 빈 결과, 404)에서 검색어를 넘겨 검색창을 연다.
  addEventListener('site-search', async (event) => {
    await open()
    const term = (event as CustomEvent<string>).detail
    if (term && searchUI) searchUI.triggerSearch(term)
  })

  openBtn?.addEventListener('click', open)
  closeBtn?.addEventListener('click', () => dialog?.close())
  mount?.addEventListener('click', (event) => {
    dismissSearchForAnchor(event, dialog, location.href)
  })

  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault()
      dialog?.open ? dialog.close() : open()
    }
  })

  // 대화상자 내부의 빈 여백이 아니라 실제 바깥 영역을 눌렀을 때만 닫는다.
  dialog?.addEventListener('click', (e) => {
    if (e.target !== dialog) return
    const rect = dialog.getBoundingClientRect()
    if (
      e.clientX < rect.left ||
      e.clientX > rect.right ||
      e.clientY < rect.top ||
      e.clientY > rect.bottom
    ) {
      dialog.close()
    }
  })
</script>

<style is:global>
  /* 머리줄의 검색 버튼: 아이콘 + '검색'. 단축키 표시는 넓은 화면에서만 */
  #search-open {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    min-height: var(--control-size);
    min-width: var(--control-size);
    padding: 0 0.6rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg2);
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 600;
    cursor: pointer;
  }
  #search-open:hover {
    background: var(--soft);
    color: var(--fg);
  }
  #search-open:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #search-open svg {
    flex-shrink: 0;
  }
  #search-open kbd {
    display: none;
  }
  @media (min-width: 46em) {
    #search-open kbd {
      display: inline-block;
    }
  }

  /* 대화상자: 위 10vh, 폭 40rem, 반경 4px. 위 띠(범위·닫기) → 입력 54px → 결과 → 안내 */
  #search-dialog {
    width: min(40rem, calc(100vw - 2rem));
    max-height: min(80dvh, calc(100dvh - 10vh - 1rem));
    margin: 10vh auto 0;
    padding: 0;
    border: 1px solid var(--line2);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--fg);
    box-shadow: var(--shadow);
    /* 결과가 길면 대화상자 안에서 스크롤한다. 없으면 뷰포트 높이에서 그대로 잘린다 */
    overflow-y: auto;
    overscroll-behavior: contain;
    /* 결과를 거꾸로 훑을 때 초점 받은 링크가 위에 붙은 띠 밑으로 숨지 않게 한다 */
    scroll-padding-top: 3.5rem;
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--fg);
    --pagefind-ui-text: var(--fg);
    --pagefind-ui-background: var(--bg);
    --pagefind-ui-border: var(--line);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: var(--radius);
    --pagefind-ui-tag: var(--soft);
    --pagefind-ui-font: var(--font-sans);
  }
  #search-dialog[open] {
    animation: search-fade 0.18s ease-out;
  }
  @keyframes search-fade {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .search-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    position: sticky;
    top: 0;
    z-index: 1;
    min-height: 40px;
    padding: 0 0.25rem 0 0.9rem;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .search-scope {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .search-scope select {
    width: auto;
    min-width: 7rem;
    min-height: 32px;
    padding: 0 0.5rem;
    font-size: 0.875rem;
    letter-spacing: 0;
  }
  #search-close {
    min-width: var(--control-size);
    min-height: 40px;
    padding: 0 0.65rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg2);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
  }
  #search-close:hover {
    background: var(--soft);
    color: var(--fg);
  }
  #search-close:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }

  /* 준비 중·실패 문구 */
  #search-mount:empty,
  #search-mount:not(:has(.pagefind-ui__form)) {
    padding: 0.9rem 1rem;
    font-size: 0.9375rem;
    color: var(--fg2);
  }
  /* 선택 상자가 같은 필터를 맡으므로 Pagefind의 필터 판은 쓰지 않는다 */
  #search-mount .pagefind-ui__filter-panel {
    display: none;
  }
  /* 입력 한 줄: 54px, 테두리 대신 아래 선. 초점은 아래 2px 강조선으로 */
  #search-mount .pagefind-ui__form::before {
    top: 18px;
    left: 1rem;
    width: 18px;
    height: 18px;
    background-color: var(--muted);
    opacity: 1;
  }
  #search-mount .pagefind-ui__search-input {
    height: 54px;
    padding: 0 4rem 0 2.75rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    font: inherit;
    font-size: 1rem;
    font-weight: 400;
    color: var(--fg);
  }
  #search-mount .pagefind-ui__search-input:focus-visible {
    outline: none;
    box-shadow: inset 0 -2px 0 var(--accent);
  }
  /* Pagefind 기본값은 안내 글자를 opacity 0.2로 흐리게 해 배경 대비가 1.5:1까지 떨어진다 */
  #search-mount .pagefind-ui__search-input::placeholder {
    color: var(--muted);
    opacity: 1;
  }
  #search-mount .pagefind-ui__search-clear {
    top: 5px;
    right: 0.4rem;
    height: 44px;
    padding: 0 0.65rem;
    border: 0;
    border-radius: var(--radius);
    background: transparent;
    color: var(--fg2);
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  #search-mount .pagefind-ui__search-clear:hover {
    background: var(--soft);
    color: var(--fg);
  }
  #search-mount .pagefind-ui__drawer {
    display: block;
  }
  #search-mount .pagefind-ui__results-area {
    min-width: 0;
    margin: 0;
  }
  /* 결과 수: 작은 라벨 */
  #search-mount .pagefind-ui__message {
    height: auto;
    padding: 0.6rem 1rem 0.1rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  #search-mount .pagefind-ui__results {
    margin: 0;
    padding: 0.3rem 0.5rem 0.5rem;
    list-style: none;
  }
  /* 결과 행: 제목 1rem/600 + 설명 .875rem 2줄. 고른 행은 옅은 면 + 왼쪽 3px 강조선 */
  #search-mount .pagefind-ui__result {
    display: block;
    padding: 0.55rem 0.6rem;
    border: 0;
    border-radius: var(--radius);
  }
  #search-mount .pagefind-ui__result:last-of-type {
    border: 0;
  }
  #search-mount .pagefind-ui__result:hover,
  #search-mount .pagefind-ui__result:focus-within {
    background: var(--soft);
    box-shadow: inset 3px 0 0 var(--accent);
  }
  #search-mount .pagefind-ui__result-inner {
    display: block;
    margin: 0;
  }
  #search-mount .pagefind-ui__result-title {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }
  /*
   * 검색 결과 링크는 글자 높이가 20–23px이라 손가락으로 누르기 어렵다.
   * 여백으로 누르는 영역을 제어 크기까지 넓히고, 같은 크기의 음수 바깥 여백으로
   * 되돌려 결과 목록이 세로로 길어지지 않게 한다.
   */
  #search-mount .pagefind-ui__result-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    padding-block: 0.375rem;
    margin-block: -0.375rem;
  }
  #search-mount .pagefind-ui__result-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #search-mount .pagefind-ui__result-excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    min-width: 0;
    margin-top: 0.1rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--fg2);
  }
  #search-mount .pagefind-ui__result-nested {
    padding-left: 1rem;
  }
  #search-mount .pagefind-ui__result-nested:first-of-type {
    padding-top: 0.35rem;
  }
  #search-mount .pagefind-ui__result-nested .pagefind-ui__result-link {
    font-size: 0.9375rem;
  }
  /* 하위 결과의 ↳ 화살표를 링크 밖 절대 위치 대신 글자 앞에 둔다 */
  #search-mount .pagefind-ui__result-nested .pagefind-ui__result-link::before {

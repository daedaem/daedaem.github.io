---
// giscus 댓글. 저장소의 GitHub Discussions를 댓글 저장소로 쓴다. 서버·DB 없음.
// 글 경로(pathname)마다 Discussion 하나가 자동으로 만들어진다.
import { SITE } from '@/consts'
const g = SITE.giscus
---

{
  g.repoId && (
    <section
      class="comments"
      aria-label="댓글"
      data-pagefind-ignore
      data-repo={g.repo}
      data-repo-id={g.repoId}
      data-category={g.category}
      data-category-id={g.categoryId}
    >
      <h2>댓글</h2>
      <p class="muted">GitHub 계정으로 남길 수 있습니다. 저장소의 Discussions에 기록됩니다.</p>
      <div class="giscus" />
    </section>
  )
}

<script>
  import { connectCommentTheme } from '@/utils/comment-theme.mjs'
  import { loadWhenVisible } from '@/utils/visible-module.mjs'
  // 테마는 사이트 토글을 따른다. 처음에는 실효 테마로 띄우고, 토글되면 iframe에 알린다.
  const host = document.querySelector<HTMLElement>('.comments')
  if (host) {
    const effective = () => {
      const set = document.documentElement.getAttribute('data-theme')
      if (set === 'light' || set === 'dark') return set
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'
    }

    // iframe뿐 아니라 외부 스크립트와 스타일도 댓글 영역 근처에서 받는다.
    loadWhenVisible(host, () => {
      const s = document.createElement('script')
      s.src = 'https://giscus.app/client.js'
      s.async = true
      s.crossOrigin = 'anonymous'
      const attrs: Record<string, string> = {
        repo: host.dataset.repo!,
        'repo-id': host.dataset.repoId!,
        category: host.dataset.category!,
        'category-id': host.dataset.categoryId!,
        mapping: 'pathname',
        strict: '1',
        'reactions-enabled': '1',
        'emit-metadata': '0',
        'input-position': 'top',
        theme: effective(),
        lang: 'ko',
        loading: 'lazy',
      }
      for (const [k, v] of Object.entries(attrs)) s.setAttribute(`data-${k}`, v)
      connectCommentTheme({
        host,
        script: s,
        readTheme: effective,
        page: window,
        document,
        media: window.matchMedia('(prefers-color-scheme: dark)'),
      })
      host.querySelector('.giscus')?.appendChild(s)
    })
  }
</script>

<style>
  .comments {
    margin-top: 3.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
  .comments h2 {
    margin: 0;
    font-size: 1.125rem;
  }
  .comments p {
    margin: 0.4rem 0 1.25rem;
    font-size: 0.875rem;
  }
  /* 외부 CSS가 늦게 와도 iframe 기본 너비(300px)가 좁은 본문을 밀어내지 않는다. */
  .comments :global(iframe.giscus-frame) {
    width: 100%;
    max-width: 100%;
    border: 0;
  }
</style>

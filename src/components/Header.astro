---
import { SITE } from '@/consts'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'
import Mark from './Mark.astro'
import { PRIMARY_NAV, activeNavigation } from '@/utils/navigation.mjs'

const path = Astro.url.pathname
const active = activeNavigation(path)
---

<header id="site-header" class="top">
  <div class="top-in">
    <a href="/" class="brand">
      <Mark size={22} class="brand-mark" />
      <span>{SITE.title}</span>
    </a>
    <nav class="nav" aria-label="주요 메뉴">
      <ul>
        {
          PRIMARY_NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  active !== item.href ? undefined : path === item.href ? 'page' : 'true'
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools">
      <Search />
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  /*
   * 모든 폭에서, 아래로 120px 넘게 읽어 내려가면 머리줄을 위로 올려 두고 위로 스크롤하면 다시 내린다.
   * 머리줄 안에 키보드 초점이 있거나 대화상자가 열려 있으면 숨기지 않는다.
   */
  const header = document.getElementById('site-header')!
  let lastY = scrollY
  let scheduled = false
  function place() {
    scheduled = false
    const y = scrollY
    const keep =
      y < 120 || header.contains(document.activeElement) || document.querySelector('dialog[open]')
    if (keep || y < lastY - 6) header.classList.remove('is-away')
    else if (y > lastY + 6) header.classList.add('is-away')
    lastY = y
  }
  addEventListener(
    'scroll',
    () => {
      if (scheduled) return
      scheduled = true
      requestAnimationFrame(place)
    },
    { passive: true },
  )
  header.addEventListener('focusin', () => header.classList.remove('is-away'))
</script>

<style>
  /* 위 3px 남색 선 위에 한 줄. 모바일은 로고줄 48 + 메뉴줄 44(메뉴 링크가 44px 조작 크기), 데스크톱은 57 */
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    border-top: 3px solid var(--mark-bg);
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    transition: translate 0.2s ease-out;
  }
  header.is-away {
    translate: 0 -100%;
  }
  @media (prefers-reduced-motion: reduce) {
    header {
      transition: none;
    }
  }

  .top-in {
    max-width: 45rem;
    margin: 0 auto;
    padding: 0 1rem;
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'brand tools'
      'nav nav';
    align-items: center;
  }

  .brand {
    grid-area: brand;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 48px;
    font-size: 1rem;
    font-weight: 650;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand :global(.brand-mark) {
    flex-shrink: 0;
  }

  /* 모바일 둘째 줄: 가로로 넘기는 메뉴 */
  .nav {
    grid-area: nav;
    height: 44px;
    margin: 0 -1rem;
    padding: 0 0.5rem;
    border-top: 1px solid var(--line);
    overflow-x: auto;
    scrollbar-width: none;
  }
  .nav::-webkit-scrollbar {
    display: none;
  }
  .nav ul {
    display: flex;
    height: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    height: 100%;
    min-height: var(--control-size);
    min-width: var(--control-size);
    padding: 0 0.55rem;
    font-size: 0.9375rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--fg2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a:hover {
    background: var(--soft);
    color: var(--fg);
  }
  /* 현재 메뉴: 아래 2px 강조선 */
  nav a[aria-current] {
    color: var(--fg);
    box-shadow: inset 0 -2px 0 var(--accent);
  }

  .tools {
    grid-area: tools;
    display: flex;
    align-items: center;
    gap: 0.125rem;
    margin-right: -0.5rem;
  }

  @media (min-width: 46em) {
    .top-in {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: 'brand nav tools';
      min-height: 57px;
    }
    .brand {
      min-height: var(--control-size);
    }
    .nav {
      height: auto;
      margin: 0 0 0 1.25rem;
      padding: 0;
      border: 0;
      overflow: visible;
    }
    .nav a {
      min-height: var(--control-size);
      padding: 0 0.7rem;
    }
  }
  @media (min-width: 75em) {
    .top-in {
      max-width: none;
      padding: 0 2rem;
    }
  }
</style>

---
import { SITE } from '@/consts'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'
import Mark from './Mark.astro'
import { PRIMARY_NAV, activeNavigation } from '@/utils/navigation.mjs'

const path = Astro.url.pathname
const active = activeNavigation(path)
---

<header>
  <div class="wrap-wide bar">
    <a href="/" class="brand">
      <Mark size={34} class="brand-mark" />
      {SITE.title}
    </a>
    <div class="right">
      <nav aria-label="주요 메뉴">
        <ul>
          {
            PRIMARY_NAV.map((item) => (
              <li>
                <a href={item.href} aria-current={active === item.href ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="tools">
        <Search />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 28px;
    min-height: 80px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    gap: 10px;
    font-size: 1.4375rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }
  .brand :global(.brand-mark) {
    color: var(--accent);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 24px;
    flex-wrap: wrap;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 0;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }

  nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-size);
    min-width: var(--control-size);
    padding-inline: 6px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
  }
  nav a[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: 1px;
    inset-inline: 6px;
    height: 2px;
    background: var(--accent);
  }
  .tools :global(#search-open),
  .tools :global(#theme-toggle) {
    background: transparent;
    border-color: transparent;
    width: var(--control-size);
    padding-inline: 0;
  }
  .tools :global(#search-open span),
  .tools :global(#search-open kbd) {
    display: none;
  }

  @media (min-width: 1024px) and (hover: hover) {
    .tools :global(#search-open) {
      width: auto;
      min-width: var(--control-size);
      padding-inline: 0.625rem;
      font-size: var(--type-label);
    }
    .tools :global(#search-open span),
    .tools :global(#search-open kbd) {
      display: inline;
    }
    .tools :global(#search-open kbd) {
      font-size: 0.75rem;
      opacity: 1;
    }
  }

  /* 좁은 화면: 첫 줄에 로고와 검색·테마 버튼, 둘째 줄에 가로로 넘기는 메뉴. 두 줄로 끝낸다. */
  @media (max-width: 640px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto;
      row-gap: 4px;
      min-height: 0;
      padding-block: 14px 4px;
    }
    .right {
      display: contents;
    }
    .tools {
      grid-column: 2;
      grid-row: 1;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: 0;
      padding-inline: 0;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav ul {
      flex-wrap: nowrap;
      justify-content: space-between;
      gap: 8px;
    }
  }
</style>

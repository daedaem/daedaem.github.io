---
import { SITE } from '@/consts'
import Mark from './Mark.astro'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'
import { PRIMARY_NAV, activeNavigation } from '@/utils/navigation.mjs'
const path = Astro.url.pathname
const active = path === '/' ? '/posts/' : activeNavigation(path)
// 학습 기록(노트·알고리즘 풀이)도 머리줄에서 바로 들어간다
const visibleNav = PRIMARY_NAV
---

<header id="site-header" class="top">
  <div class="top-in">
    <a href="/" class="brand" aria-label={`${SITE.title} 홈`}
      ><Mark size={20} class="mark" />{SITE.title}</a
    >
    <nav class="nav" aria-label="주요 메뉴">
      <ul>
        {
          visibleNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  active !== item.href ? undefined : path === item.href ? 'page' : 'true'
                }
                aria-label={item.short ? item.label : undefined}
              >
                {item.short ? (
                  <>
                    {item.short}
                    <span class="nav-more">
                      {'\u00a0' + item.label.slice(item.short.length).trim()}
                    </span>
                  </>
                ) : (
                  item.label
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools"><Search /><ThemeToggle /></div>
  </div>
</header>
<style>
  .top {
    background: var(--bg);
  }
  .top-in {
    max-width: 1184px;
    margin: 0 auto;
    padding: 0 32px;
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
  }
  .top-in::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 32px;
    right: 32px;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 20px;
    line-height: 28px;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand :global(.mark) {
    flex: none;
    width: 20px;
    height: 20px;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    font-size: 15px;
    line-height: 24px;
    font-weight: 500;
    color: var(--fg2);
    text-decoration: none;
    white-space: nowrap;
  }
  .nav a[aria-current] {
    color: var(--fg);
    font-weight: 600;
    box-shadow: inset 0 -2px var(--accent);
  }
  .nav a:hover {
    background: var(--soft);
  }
  .tools {
    display: flex;
    align-items: center;
  }
  @media (max-width: 760px) {
    .top-in {
      padding: 0 16px;
    }
    .top-in::after {
      left: 16px;
      right: 16px;
    }
    .brand {
      font-size: 18px;
      gap: 8px;
    }
    .brand :global(.mark) {
      width: 18px;
      height: 18px;
    }
    .nav ul {
      gap: 0;
    }
    .nav a {
      font-size: 14px;
      padding: 0;
    }
    .tools :global(#search-open) {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
    .tools :global(#search-open .tb-l),
    .tools :global(#search-open kbd) {
      display: none;
    }
  }
  /* 모바일은 이름을 숨기지 않는다. 읽기/키보드 순서대로 이름, 메뉴, 도구를 두 줄로 둔다. */
  @media (max-width: 640px) {
    .top-in {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'brand brand' 'nav tools';
      padding: 0 20px;
      gap: 0;
    }
    .brand {
      grid-area: brand;
      justify-self: start;
      font-size: 21px;
      gap: 8px;
    }
    .brand :global(.mark) {
      width: 20px;
      height: 20px;
    }
    .nav {
      grid-area: nav;
      margin-left: 0;
    }
    .nav ul {
      justify-content: flex-start;
      gap: 0;
    }
    .nav a {
      padding: 0 6px;
    }
    .top-in::after {
      left: 20px;
      right: 20px;
    }
    .tools {
      grid-area: tools;
    }
  }
  @media (max-width: 374px) {
    .nav-more {
      display: none;
    }
    .nav a {
      padding-inline: 0;
    }
    .top-in {
      padding-inline: 16px;
    }
    .top-in::after {
      left: 16px;
      right: 16px;
    }
  }
  @media (forced-colors: active) {
    .nav a[aria-current] {
      border-bottom: 2px solid LinkText;
    }
  }
</style>

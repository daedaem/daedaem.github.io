---
import { SITE } from '@/consts'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'
import Mark from './Mark.astro'

const path = Astro.url.pathname
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href))

const NAV = [
  { href: '/posts/', label: '글' },
  { href: '/projects/', label: '프로젝트' },
  { href: '/wiki/', label: '위키' },
  { href: '/algorithms/', label: '알고리즘' },
  { href: '/notes/', label: '노트' },
  { href: '/about/', label: '소개' },
]
---

<header>
  <div class="wrap-wide bar">
    <a href="/" class="brand">
      <Mark size={22} class="brand-mark" />
      {SITE.title}
    </a>
    <div class="right">
      <nav aria-label="주요 메뉴">
        <ul>
          {
            NAV.map(item => (
              <li>
                <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="tools">
        <Search />
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px 24px;
    min-height: 64px;
    flex-wrap: wrap;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 17px;
    font-weight: 700;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }
  .brand :global(.brand-mark) {
    color: var(--accent);
  }

  .right {
    display: flex;
    align-items: center;
    gap: 22px;
    flex-wrap: wrap;
  }

  .tools {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 14px;
  }

  nav a {
    color: var(--text-muted);
    white-space: nowrap;
  }

  nav a:hover {
    color: var(--text);
  }

  nav a[aria-current='page'] {
    color: var(--text);
    font-weight: 500;
  }

  /* 좁은 화면: 첫 줄에 로고와 검색·테마 버튼, 둘째 줄에 가로로 넘기는 메뉴. 두 줄로 끝낸다. */
  @media (max-width: 640px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto;
      row-gap: 4px;
      min-height: 0;
      padding-block: 10px 8px;
    }
    .right {
      display: contents;
    }
    .tools {
      grid-column: 2;
      grid-row: 1;
    }
    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      overflow-x: auto;
      scrollbar-width: none;
      margin-inline: -24px;
      padding-inline: 24px;
    }
    nav::-webkit-scrollbar {
      display: none;
    }
    nav ul {
      flex-wrap: nowrap;
      gap: 20px;
      padding-block: 4px;
    }
  }
</style>

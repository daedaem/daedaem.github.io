---
import { SITE } from '@/consts'
import Mark from './Mark.astro'
import Search from './Search.astro'
import ThemeToggle from './ThemeToggle.astro'
import { PRIMARY_NAV, activeNavigation } from '@/utils/navigation.mjs'
const path = Astro.url.pathname
const active = path === '/' ? '/posts/' : activeNavigation(path)
// Saved s4 has three primary links; learning archives remain linked from the footer and wiki.
const visibleNav = PRIMARY_NAV.filter((item) => item.href !== '/learn/')
---

<header id="site-header" class="top">
  <div class="top-in">
    <a href="/" class="brand" aria-label={`${SITE.author} — ${SITE.title} 홈`}
      ><Mark size={20} class="mark" />{SITE.author}</a
    >
    <nav class="nav" aria-label="주요 메뉴">
      <ul>
        {
          visibleNav.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={
                  active !== item.href ? undefined : path === item.href ? 'page' : 'true'
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="tools"><Search /><ThemeToggle /></div>
  </div>
</header>
<style>
  .top {
    background: var(--bg);
  }
  .top-in {
    max-width: 1184px;
    margin: 0 auto;
    padding: 0 32px;
    min-height: 64px;
    display: flex;
    align-items: center;
    gap: 4px;
    position: relative;
  }
  .top-in::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 32px;
    right: 32px;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    font-size: 20px;
    line-height: 28px;
    font-weight: 700;
    letter-spacing: -0.015em;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand :global(.mark) {
    flex: none;
    width: 20px;
    height: 20px;
  }
  .nav {
    margin-left: auto;
  }
  .nav ul {
    display: flex;
    gap: 4px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .nav a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    padding: 0 12px;
    font-size: 15px;
    line-height: 24px;
    font-weight: 500;
    color: var(--fg2);
    text-decoration: none;
  }
  .nav a[aria-current] {
    color: var(--fg);
    font-weight: 600;
    box-shadow: inset 0 -2px var(--accent);
  }
  .nav a:hover {
    background: var(--soft);
  }
  .tools {
    display: flex;
    align-items: center;
  }
  @media (max-width: 760px) {
    .top-in {
      padding: 0 16px;
    }
    .top-in::after {
      left: 16px;
      right: 16px;
    }
    .brand {
      font-size: 18px;
      gap: 8px;
    }
    .brand :global(.mark) {
      width: 18px;
      height: 18px;
    }
    .nav ul {
      gap: 0;
    }
    .nav a {
      font-size: 14px;
      padding: 0;
    }
    .tools :global(#search-open) {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
    .tools :global(#search-open .tb-l),
    .tools :global(#search-open kbd) {
      display: none;
    }
  }
  @media (max-width: 359px) {
    .brand {
      font-size: 16px;
    }
    .brand :global(.mark) {
      display: none;
    }
    .top-in {
      gap: 0;
    }
  }
  @media (forced-colors: active) {
    .nav a[aria-current] {
      border-bottom: 2px solid LinkText;
    }
  }
</style>

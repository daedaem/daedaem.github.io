---
import { CATEGORIES } from '@/consts'

/** 글 목록 머리 아래 분류 칩 한 줄. 사이드바나 접이식 없이 링크로 오간다 */
interface Props {
  /** 카테고리 id별 글 수 */
  counts: Map<string, number>
  total: number
  /** 현재 선택된 카테고리 id. 없으면 "전체"가 선택된 상태 */
  active?: string
}

const { counts, total, active } = Astro.props
---

<nav class="chips catnav" aria-label="카테고리">
  <a href="/posts/" class="chip" aria-current={!active ? 'page' : undefined}>
    전체 <span class="n">{total}</span>
  </a>
  {
    CATEGORIES.filter((c) => (counts.get(c.id) ?? 0) > 0).map((c) => (
      <a
        href={`/categories/${c.id}/`}
        class="chip"
        aria-current={active === c.id ? 'page' : undefined}
      >
        {c.name} <span class="n">{counts.get(c.id) ?? 0}</span>
      </a>
    ))
  }
</nav>

<style>
  .catnav {
    margin-top: 14px;
  }
</style>

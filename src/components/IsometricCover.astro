---
interface Props {
  kind: string
}
const { kind } = Astro.props
const files = import.meta.glob('../assets/isometric/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
})
const svg = files[`../assets/isometric/iso-${kind}.svg`] as string | undefined
---

{svg && <div class="isometric-cover" aria-hidden="true" set:html={svg} />}
<style>
  .isometric-cover {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 10px;
    background: var(--cv-bg);
  }
  .isometric-cover :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>

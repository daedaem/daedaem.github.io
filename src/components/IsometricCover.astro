---
import { isometricCoverSources } from '@/utils/isometric-covers.mjs'
interface Props {
  kind: string
  sizes?: string
  priority?: boolean
}
const {
  kind,
  sizes = '(max-width: 760px) calc(100vw - 40px), 240px',
  priority = false,
} = Astro.props
const sources = isometricCoverSources(kind)
---

{
  sources && (
    <div class="isometric-cover" aria-hidden="true">
      <img
        class="cover-light"
        src={sources.light.src}
        srcset={sources.light.srcset}
        sizes={sizes}
        width={sources.width}
        height={sources.height}
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
      <img
        class="cover-dark"
        src={sources.dark.src}
        srcset={sources.dark.srcset}
        sizes={sizes}
        width={sources.width}
        height={sources.height}
        alt=""
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        decoding="async"
      />
    </div>
  )
}
<style>
  .isometric-cover {
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 10px;
    background: var(--cv-bg);
  }
  .isometric-cover img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  /* 그림은 밝은 판과 어두운 판을 따로 그렸다. 사이트 테마 규칙(global.css)과 같은 순서로 고른다. */
  .cover-dark {
    display: none;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .cover-light {
      display: none;
    }
    :global(:root:not([data-theme='light'])) .cover-dark {
      display: block;
    }
  }
  :global(:root[data-theme='dark']) .cover-light {
    display: none;
  }
  :global(:root[data-theme='dark']) .cover-dark {
    display: block;
  }
</style>

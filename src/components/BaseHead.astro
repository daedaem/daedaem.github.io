---
import { SITE } from '@/consts'
import '@/styles/global.css'
import jetbrainsCss from '../../public/fonts/jetbrains-mono.css?raw'

interface Props {
  title: string
  description?: string
  type?: 'website' | 'article'
  publishedAt?: Date
  updatedAt?: Date
  /** OG 카드 경로. 없으면 사이트 기본 카드를 쓴다 */
  ogSlug?: string
  /** 404처럼 검색 결과에 나오면 안 되는 페이지 */
  noindex?: boolean
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedAt,
  updatedAt,
  ogSlug = 'site',
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title === SITE.title ? title : `${title} · ${SITE.title}`
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site)

/** 검색엔진이 저자와 글을 이해하도록 구조화 데이터를 넣는다 */
const person = {
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  jobTitle: '백엔드 개발자',
  sameAs: [SITE.githubUrl, SITE.linkedinUrl],
}
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonical.href,
        inLanguage: 'ko-KR',
        author: person,
        publisher: person,
        ...(publishedAt && { datePublished: publishedAt.toISOString() }),
        ...(updatedAt && { dateModified: updatedAt.toISOString() }),
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: SITE.title,
        description,
        url: SITE.url,
        inLanguage: 'ko-KR',
        author: person,
      }
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* 저장된 테마를 그리기 전에 적용한다. 값이 없으면 시스템 설정을 따른다. */}
<script is:inline>
  try {
    var t = localStorage.getItem('theme')
    if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t)
  } catch (e) {}
</script>
<title>{fullTitle}</title>
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
{/* 폰트는 셀프 호스팅한다. CDN 장애·차단 환경에서도 글꼴이 유지되고 외부 요청이 없다 */}
{/* 모든 페이지가 쓰는 한글 서브셋은 CSS 파싱을 기다리지 않고 먼저 받는다 */}
{
  [90, 89, 91].map((n) => (
    <link
      rel="preload"
      href={`/fonts/pretendard/woff2/PretendardVariable.subset.${n}.woff2`}
      as="font"
      type="font/woff2"
      crossorigin
    />
  ))
}
<link rel="stylesheet" href="/fonts/pretendard/pretendardvariable-dynamic-subset.min.css" />
<style is:inline set:html={jetbrainsCss}></style>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>
{
  SITE.verification.google && (
    <meta name="google-site-verification" content={SITE.verification.google} />
  )
}
{
  SITE.verification.naver && (
    <meta name="naver-site-verification" content={SITE.verification.naver} />
  )
}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

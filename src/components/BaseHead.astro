---
import { SITE } from '@/consts'
import '@/styles/global.css'
import jetbrainsCss from '../../public/fonts/jetbrains-mono.css?raw'

interface Props {
  title: string
  description?: string
  /** profile은 소개 페이지. JSON-LD를 ProfilePage로 낸다 */
  type?: 'website' | 'article' | 'profile'
  publishedAt?: Date
  updatedAt?: Date
  /** OG 카드 경로. 없으면 사이트 기본 카드를 쓴다 */
  ogSlug?: string
  /** 404처럼 검색 결과에 나오면 안 되는 페이지 */
  noindex?: boolean
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedAt,
  updatedAt,
  ogSlug = 'site',
  noindex = false,
} = Astro.props

const canonical = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title === SITE.title ? SITE.homeTitle : `${title} · ${SITE.title}`
const ogImage = new URL(`/og/${ogSlug}.png`, Astro.site)

/** 검색엔진이 저자와 글을 이해하도록 구조화 데이터를 넣는다 */
const person = {
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  /* 국내 채용은 한국어 직무명(SITE.role), 영문·외국계는 Software Engineer로 찾는다. 둘 다 남긴다 */
  jobTitle: [SITE.role, 'Software Engineer'],
  sameAs: [SITE.githubUrl, SITE.linkedinUrl],
}
const jsonLd =
  type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: title,
        description,
        url: canonical.href,
        inLanguage: 'ko-KR',
        author: person,
        publisher: person,
        ...(publishedAt && { datePublished: publishedAt.toISOString() }),
        ...(updatedAt && { dateModified: updatedAt.toISOString() }),
      }
    : type === 'profile'
      ? {
          '@context': 'https://schema.org',
          '@type': 'ProfilePage',
          url: canonical.href,
          inLanguage: 'ko-KR',
          mainEntity: { ...person, email: SITE.email, description },
        }
      : {
          '@context': 'https://schema.org',
          '@type': 'WebSite',
          name: SITE.title,
          alternateName: SITE.altNames,
          description: SITE.description,
          url: SITE.url,
          inLanguage: 'ko-KR',
          author: person,
        }
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
{/* 브라우저 틀 색. 테마 토글은 두 값을 실효 테마의 색으로 바꾼다 */}
<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#14181f" />
{/* 저장된 테마를 그리기 전에 적용한다. 값이 없으면 시스템 설정을 따른다. */}
<script is:inline>
  try {
    var t = localStorage.getItem('theme')
    if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t)
  } catch (e) {}
</script>
<title>{fullTitle}</title>
{
  /* SVG를 못 읽는 크롤러·구형 브라우저용 ico/png를 함께 둔다. 구글 검색 결과 아이콘은 48의 배수 크기 PNG를 본다 */
}
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon-96x96.png" type="image/png" sizes="96x96" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
{/* 폰트는 셀프 호스팅한다. CDN 장애·차단 환경에서도 글꼴이 유지되고 외부 요청이 없다 */}
{
  /* 사이트 전체 글자만 모은 글꼴 파일 하나를 CSS 파싱을 기다리지 않고 먼저 받는다.
     파일은 빌드 뒤 scripts/subset-fonts.mjs가 만들고, 이 주소를 해시가 붙은 이름으로 바꾼다 */
}
<link
  rel="preload"
  href="/fonts/pretendard/woff2/PretendardVariable.site.woff2"
  as="font"
  type="font/woff2"
  crossorigin
/>
<link rel="stylesheet" href="/fonts/pretendard/pretendardvariable-dynamic-subset.min.css" />
<style is:inline set:html={jetbrainsCss}></style>
<meta name="description" content={description} />
<meta name="author" content={SITE.author} />
<link rel="canonical" href={canonical} />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE.title}
  href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />
<meta
  name="robots"
  content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
/>
{
  SITE.verification.google && (
    <meta name="google-site-verification" content={SITE.verification.google} />
  )
}
{
  SITE.verification.naver && (
    <meta name="naver-site-verification" content={SITE.verification.naver} />
  )
}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE.title} />
<meta property="og:locale" content="ko_KR" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

---
// 위키 문서 끝의 '이어 읽기'. 역링크("이 문서를 참고하는 글")는 문서 페이지가 따로 그린다.
import { getCollection } from 'astro:content'
import { selectWikiReading } from '@/utils/wiki-reading.mjs'
interface Props {
  current: string
}
const { current } = Astro.props
const pool = [
  ...(await getCollection('wiki', ({ data }) => !data.draft)),
  ...(await getCollection('posts', ({ data }) => !data.draft)),
]
const currentEntry = pool.find((entry) => entry.collection === 'wiki' && entry.id === current)
const { related } = currentEntry ? selectWikiReading(pool, currentEntry) : { related: [] }
---

{
  related.length > 0 && (
    <section class="back" aria-label="이어 읽을 글" data-pagefind-ignore>
      <h2 class="k">이어 읽기</h2>
      <ul>
        {related.map((e) => (
          <li>
            <a href={'/' + e.collection + '/' + e.id + '/'}>{e.data.title}</a>
            <span class="badge">{e.collection === 'posts' ? '글' : '위키'}</span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

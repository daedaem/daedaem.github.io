---
import { getCollection } from 'astro:content'
import { selectWikiReading } from '@/utils/wiki-reading.mjs'
interface Props {
  current: string
}
const { current } = Astro.props
const pool = [
  ...(await getCollection('wiki', ({ data }) => !data.draft)),
  ...(await getCollection('posts', ({ data }) => !data.draft)),
]
const currentEntry = pool.find((entry) => entry.collection === 'wiki' && entry.id === current)
const { references, related } = currentEntry
  ? selectWikiReading(pool, currentEntry)
  : { references: [], related: [] }
---

{
  (references.length > 0 || related.length > 0) && (
    <aside class="related" data-pagefind-ignore aria-label="연결된 문서">
      {references.length > 0 && (
        <section>
          <h2>이 문서를 참고한 글</h2>
          <ul>
            {references.map((e) => (
              <li>
                <span>{e.collection === 'posts' ? '사례' : '위키'}</span>
                <a href={'/' + e.collection + '/' + e.id + '/'}>{e.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      {related.length > 0 && (
        <section>
          <h2>같은 주제로 이어 읽기</h2>
          <ul>
            {related.map((e) => (
              <li>
                <span>{e.collection === 'posts' ? '사례' : '위키'}</span>
                <a href={'/' + e.collection + '/' + e.id + '/'}>{e.data.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </aside>
  )
}
<style>
  .related {
    border-top: 1px solid var(--border-strong);
    margin-top: 3rem;
    padding-top: 1rem;
  }
  section + section {
    margin-top: 1.5rem;
  }
  h2 {
    font-size: 1rem;
  }
  ul {
    list-style: none;
    padding: 0;
  }
  li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 0.75rem;
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  li span {
    font-size: 0.8125rem;
    color: var(--text-muted);
    white-space: nowrap;
  }
  a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    padding-block: 0.5rem;
    font-size: var(--type-body);
    line-height: 1.65;
  }
  a:hover {
    color: var(--accent);
  }
  a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
</style>

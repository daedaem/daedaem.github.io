---
import { formatDate, formatCompactDate } from '@/utils/format'

interface Props {
  date: Date
  updated?: Date
  original?: boolean
  stacked?: boolean
  compact?: boolean
  dateLabel?: string
  updatedLabel?: string
}
const {
  date,
  updated,
  original = false,
  stacked = false,
  compact = false,
  dateLabel = original ? '원문 작성' : '작성',
  updatedLabel = '수정',
} = Astro.props
const displayDate = compact ? formatCompactDate : formatDate
---

<span class:list={['content-dates', { stacked, compact }]}>
  <time datetime={date.toISOString()}>{dateLabel} {displayDate(date)}</time>
  {
    updated && updated.getTime() !== date.getTime() && (
      <time datetime={updated.toISOString()}>
        {updatedLabel} {displayDate(updated)}
      </time>
    )
  }
</span>

<style>
  .content-dates {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.8rem;
    color: var(--text-dim);
    font-size: var(--type-caption);
    font-variant-numeric: tabular-nums;
  }
  time {
    white-space: nowrap;
  }
  .stacked {
    flex-direction: column;
  }
  /* 목록에서는 각 날짜와 읽기 시간이 같은 flex 줄에서 자연스럽게 감긴다. */
  .compact {
    display: contents;
  }
  .compact time {
    white-space: normal;
  }
  @media (max-width: 640px) {
    .stacked {
      flex-direction: row;
    }
  }
</style>

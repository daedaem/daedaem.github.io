---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import RelatedReading from '@/components/RelatedReading.astro'
import ContentDates from '@/components/ContentDates.astro'
import { getWikiTopic } from '@/consts'
import { tagSlug } from '@/utils/format'
import { linkableTagSlugs } from '@/utils/tags'
import { selectWikiReferences } from '@/utils/wiki-reading.mjs'

export const getStaticPaths = async () => {
  const entries = await getCollection('wiki', ({ data }) => !data.draft)
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  const pool = [...entries, ...posts]
  const revised = (e: (typeof entries)[number]) => (e.data.updated ?? e.data.created).valueOf()
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      // 이 문서를 본문에서 가리키는 글·문서, 최신순
      references: selectWikiReferences(pool, entry).map((e) => ({
        href: `/${e.collection}/${e.id}/`,
        title: e.data.title,
        kind: e.collection === 'posts' ? '글' : '위키',
      })),
      // 같은 주제의 다른 문서, 최근 갱신순 최대 8편
      siblings: entries
        .filter((e) => e.id !== entry.id && e.data.topic === entry.data.topic)
        .sort((a, b) => revised(b) - revised(a) || a.data.title.localeCompare(b.data.title, 'ko'))
        .slice(0, 8)
        .map((e) => ({ href: `/wiki/${e.id}/`, title: e.data.title })),
    },
  }))
}

const { entry, references, siblings } = Astro.props
const { Content, headings } = await render(entry)
const linkable = await linkableTagSlugs()
const topic = getWikiTopic(entry.data.topic)
const status = entry.data.status === 'stable' ? '정리됨' : '보완 중'
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const hasToc = toc.length >= 4
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedAt={entry.data.created}
  updatedAt={entry.data.updated}
  ogSlug={`wiki/${entry.id}`}
>
  <div class="page">
    <article class="art post">
      <header class="art-head">
        <p class="meta" data-pagefind-ignore>
          <a href="/wiki/" set:text="위키" />
          {topic && <span class="sep" aria-hidden="true" set:text="›" />}
          {topic && <i class="dot" style={`--wt: ${topic.hue}`} aria-hidden="true" />}
          {topic && <a href={`/wiki/#${topic.id}`} set:text={topic.name} />}
          <span class="sep" aria-hidden="true" set:text="·" />
          <span set:text={status} />
          <span class="sep" aria-hidden="true" set:text="·" />
          <ContentDates
            date={entry.data.created}
            updated={entry.data.updated}
            dateLabel="만듦"
            updatedLabel="갱신"
            inline
          />
        </p>
        <h1 tabindex="-1">{entry.data.title}</h1>
        <p class="deck">{entry.data.description}</p>
      </header>

      {
        hasToc && (
          <details class="toc" data-pagefind-ignore>
            <summary>
              <span class="k">
                차례<span class="n">{toc.length}</span>
              </span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <ol>
              {toc.map((h) => (
                <li class:list={{ d3: h.depth === 3 }}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      <div class="prose">
        <Content />
      </div>

      <footer class="art-end">
        {
          entry.data.tags.length > 0 && (
            <p class="tags">
              <span class="k">태그</span>
              {entry.data.tags.map((t) =>
                linkable.has(tagSlug(t)) ? (
                  <a href={`/tags/${tagSlug(t)}/`}>{t}</a>
                ) : (
                  <span>{t}</span>
                ),
              )}
            </p>
          )
        }
        {
          references.length > 0 && (
            <section class="back" aria-label="이 문서를 참고하는 글" data-pagefind-ignore>
              <h2 class="k">이 문서를 참고하는 글</h2>
              <ul>
                {references.map((r) => (
                  <li>
                    <a href={r.href}>{r.title}</a>
                    <span class="k-in">{r.kind}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        {
          siblings.length > 0 && (
            <section class="back" aria-label="같은 주제의 문서" data-pagefind-ignore>
              <h2 class="k">같은 주제의 문서</h2>
              <ul>
                {siblings.map((s) => (
                  <li>
                    <a href={s.href}>{s.title}</a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
        <RelatedReading current={entry.id} />
      </footer>

      {
        hasToc && (
          <nav class="rail" aria-label="차례" data-pagefind-ignore>
            <p class="k">차례</p>
            <ol>
              {toc.map((h) => (
                <li class:list={{ d3: h.depth === 3 }}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ol>
            <button type="button" class="totop">
              맨 위로
            </button>
          </nav>
        )
      }
    </article>
  </div>
</BaseLayout>

<script>
  import { initCurrentHeading } from '@/utils/current-heading.mjs'
  import { initTocSheet } from '@/utils/toc-sheet.mjs'
  initCurrentHeading()
  initTocSheet()
  document.querySelector<HTMLButtonElement>('.rail .totop')?.addEventListener('click', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
    document.querySelector<HTMLElement>('.art-head h1')?.focus({ preventScroll: true })
  })
</script>

<style>
  /* 주제 점. 색은 점에만 쓰고 글자는 --muted다 */
  .meta .dot {
    --dot: hsl(var(--wt) 65% 48%);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .meta .dot {
      --dot: hsl(var(--wt) 70% 65%);
    }
  }
  :global(:root[data-theme='dark']) .meta .dot {
    --dot: hsl(var(--wt) 70% 65%);
  }
  /* 본문이 제목으로 시작하면 위 선과 여백을 겹쳐 두지 않는다 */
  .prose > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  p.tags a,
  p.tags span:not(.k) {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
  p.tags a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  section.back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
  section.back .k-in {
    flex-shrink: 0;
    white-space: nowrap;
  }
</style>

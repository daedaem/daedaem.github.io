---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getWikiTopic } from '@/consts'
import { formatDate, readingMinutes } from '@/utils/format'

export const getStaticPaths = async () => {
  const entries = await getCollection('wiki', ({ data }) => !data.draft)
  return entries.map(entry => ({
    params: { slug: entry.id },
    props: {
      entry,
      // 같은 주제의 다른 문서. 문서 안에서 옆 문서로 건너갈 수 있게 한다.
      siblings: entries
        .filter(e => e.data.topic === entry.data.topic && e.id !== entry.id)
        .sort((a, b) => a.data.title.localeCompare(b.data.title, 'ko'))
        .map(e => ({ href: `/wiki/${e.id}/`, title: e.data.title, status: e.data.status })),
    },
  }))
}

const { entry, siblings } = Astro.props
const STATUS_SHORT: Record<string, string> = { seed: '메모', growing: '보완 중', stable: '정리됨' }
const { Content, headings } = await render(entry)
const topic = getWikiTopic(entry.data.topic)
const STATUS_LABEL: Record<string, string> = {
  seed: '메모 수준입니다. 뼈대만 잡아 두었습니다.',
  growing: '보완하는 중입니다. 빠진 내용이 있을 수 있습니다.',
  stable: '한 차례 정리를 마친 문서입니다.',
}
const toc = headings.filter(h => h.depth === 2 || h.depth === 3)
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedAt={entry.data.created}
  updatedAt={entry.data.updated}
  ogSlug={`wiki/${entry.id}`}
>
  <article class="wrap post">
    <header>
      <div class="meta">
        <a class="crumb" href="/wiki/">위키</a>
        {topic && <span class="sep">›</span>}
        {topic && <a class="topic" href="/wiki/">{topic.name}</a>}
        <time datetime={(entry.data.updated ?? entry.data.created).toISOString()}>
          {
            entry.data.updated
              ? `${formatDate(entry.data.updated)} 갱신`
              : formatDate(entry.data.created)
          }
        </time>
        <span>· {readingMinutes(entry.body ?? '')}분</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <p class="status muted">{STATUS_LABEL[entry.data.status]}</p>
    </header>

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="목차">
          <p>목차</p>
          <ul>
            {toc.map(h => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="body">
      <slot name="before" />
      <Content />
    </div>

    {
      entry.data.tags.length > 0 && (
        <ul class="tags">
          {entry.data.tags.map(t => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }

    {
      siblings.length > 0 && topic && (
        <section class="siblings" aria-label="같은 주제의 문서">
          <div class="siblings-head">
            <h2>{topic.name}의 다른 문서</h2>
            <a href="/wiki/">위키 전체 →</a>
          </div>
          <ul>
            {siblings.map(s => (
              <li>
                <a href={s.href}>{s.title}</a>
                <span class="status">{STATUS_SHORT[s.status]}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: 3rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .topic,
  .crumb {
    color: var(--text-muted);
    font-weight: 600;
  }
  .topic:hover,
  .crumb:hover {
    color: var(--text);
  }
  .sep {
    color: var(--text-dim);
  }

  .siblings {
    margin-top: 3rem;
  }
  .siblings-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .siblings-head h2 {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .siblings-head a {
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .siblings ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }
  .siblings li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--border);
    font-size: 0.9375rem;
  }
  .siblings li a {
    font-weight: 600;
  }
  .siblings li a:hover {
    color: var(--accent);
  }
  .siblings .status {
    font-size: 0.75rem;
    color: var(--text-dim);
    white-space: nowrap;
  }
  h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(26px, 4vw, 32px);
    line-height: 1.45;
    letter-spacing: -0.035em;
  }
  .lead {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .status {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }
  .toc {
    margin-top: 2.25rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }
  .toc p {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    margin-block: 0.2rem;
  }
  .toc .d3 {
    padding-left: 1rem;
  }
  .toc a {
    text-decoration: none;
    color: var(--text-muted);
  }
  .toc a:hover {
    color: var(--text);
  }
  .body {
    margin-top: 2.5rem;
  }
  .body :global(h2) {
    margin-top: 3.25rem;
    font-size: 21px;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .body :global(h3) {
    margin-top: 2.25rem;
    font-size: 1.125rem;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin-block: 1.15rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 3rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>

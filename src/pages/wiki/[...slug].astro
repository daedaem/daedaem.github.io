---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import WikiTree from '@/components/WikiTree.astro'
import RelatedReading from '@/components/RelatedReading.astro'
import { getWikiTopic } from '@/consts'
import { formatDate, readingMinutes, tagSlug } from '@/utils/format'
import { linkableTagSlugs } from '@/utils/tags'

export const getStaticPaths = async () => {
  const entries = await getCollection('wiki', ({ data }) => !data.draft)
  // 트리에 쓸 전체 문서 목록. 모든 페이지가 같은 목록을 받는다.
  const docs = entries.map((e) => ({
    id: e.id,
    title: e.data.title,
    topic: e.data.topic,
    status: e.data.status,
  }))
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, docs } }))
}

const { entry, docs } = Astro.props
const { Content, headings } = await render(entry)
const linkable = await linkableTagSlugs()
const topic = getWikiTopic(entry.data.topic)
const STATUS_LABEL: Record<string, string> = {
  seed: '메모 수준입니다. 뼈대만 잡아 두었습니다.',
  growing: '보완하는 중입니다. 빠진 내용이 있을 수 있습니다.',
  stable: '한 차례 정리를 마친 문서입니다.',
}
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedAt={entry.data.created}
  updatedAt={entry.data.updated}
  ogSlug={`wiki/${entry.id}`}
>
  <div class="wrap-wide layout">
    <aside class="side">
      <WikiTree docs={docs} current={entry.id} />
    </aside>

    <details class="side-mobile">
      <summary>위키 문서 목록</summary>
      <WikiTree docs={docs} current={entry.id} />
    </details>

    <article class="post">
      <header>
        <div class="meta">
          <a class="crumb" href="/wiki/">위키</a>
          {topic && <span class="sep">›</span>}
          {
            topic && (
              <a class="topic" href={`/wiki/#${topic.id}`} style={`--wt: ${topic.hue}`}>
                <span class="swatch" aria-hidden="true" />
                {topic.name}
              </a>
            )
          }
          <time datetime={(entry.data.updated ?? entry.data.created).toISOString()}>
            {
              entry.data.updated
                ? `${formatDate(entry.data.updated)} 갱신`
                : formatDate(entry.data.created)
            }
          </time>
          <span>· {readingMinutes(entry.body ?? '')}분</span>
        </div>
        <h1>{entry.data.title}</h1>
        <p class="lead">{entry.data.description}</p>
        <p class="status muted">{STATUS_LABEL[entry.data.status]}</p>
      </header>

      {
        toc.length > 2 && (
          <nav class="toc" aria-label="목차">
            <p>목차</p>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <div class="body">
        <Content />
      </div>

      {
        entry.data.tags.length > 0 && (
          <ul class="tags">
            {entry.data.tags.map((t) =>
              linkable.has(tagSlug(t)) ? (
                <li>
                  <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
                </li>
              ) : (
                <li>#{t}</li>
              ),
            )}
          </ul>
        )
      }
      <RelatedReading current={entry.id} tags={entry.data.tags} />
    </article>
  </div>
</BaseLayout>

<style>
  /* 데스크톱: 왼쪽 트리 + 본문. 본문 폭은 --measure를 넘지 않는다. */
  .layout {
    display: grid;
    grid-template-columns: 15rem minmax(0, var(--measure));
    gap: 3rem;
    padding-top: 3rem;
    align-items: start;
  }
  .side {
    position: sticky;
    top: 5rem;
    max-height: calc(100vh - 6rem);
    overflow-y: auto;
    padding-right: 0.5rem;
  }
  .side-mobile {
    display: none;
  }
  .post {
    min-width: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .topic,
  .crumb {
    color: var(--text-muted);
    font-weight: 600;
  }
  .topic {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .topic:hover,
  .crumb:hover {
    color: var(--text);
  }
  .swatch {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: hsl(var(--wt) 65% 48%);
  }
  .sep {
    color: var(--text-dim);
  }
  h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(26px, 4vw, 32px);
    line-height: 1.45;
    letter-spacing: -0.035em;
  }
  .lead {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .status {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }
  .toc {
    margin-top: 2.25rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }
  .toc p {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    margin-block: 0.2rem;
  }
  .toc .d3 {
    padding-left: 1rem;
  }
  .toc a {
    text-decoration: none;
    color: var(--text-muted);
  }
  .toc a:hover {
    color: var(--text);
  }
  .body {
    margin-top: 2.5rem;
  }
  .body :global(h2) {
    margin-top: 3.25rem;
    font-size: var(--type-article-h2);
    line-height: 1.5;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .body :global(h3) {
    margin-top: 2.25rem;
    font-size: var(--type-article-h3);
    line-height: 1.5;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin-block: 1.15rem;
  }
  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 3rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .swatch {
      background: hsl(var(--wt) 70% 65%);
    }
  }
  :global(:root[data-theme='dark']) .swatch {
    background: hsl(var(--wt) 70% 65%);
  }

  /* 좁은 화면: 트리를 본문 위의 접힌 목록으로 */
  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding-top: 1.5rem;
    }
    .side {
      display: none;
    }
    .side-mobile {
      display: block;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0 1rem;
    }
    .side-mobile > summary {
      padding: 0.75rem 0;
      font-size: 0.875rem;
      font-weight: 600;
      cursor: pointer;
    }
  }
</style>

---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getWikiTopic } from '@/consts'
import { formatDate, readingMinutes } from '@/utils/format'

export const getStaticPaths = async () => {
  const entries = await getCollection('wiki', ({ data }) => !data.draft)
  return entries.map(entry => ({ params: { slug: entry.id }, props: { entry } }))
}

const { entry } = Astro.props
const { Content, headings } = await render(entry)
const topic = getWikiTopic(entry.data.topic)
const STATUS_LABEL: Record<string, string> = {
  seed: '메모 수준입니다. 뼈대만 잡아 두었습니다.',
  growing: '보완하는 중입니다. 빠진 내용이 있을 수 있습니다.',
  stable: '한 차례 정리를 마친 문서입니다.',
}
const toc = headings.filter(h => h.depth === 2 || h.depth === 3)
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  type="article"
  publishedAt={entry.data.created}
  updatedAt={entry.data.updated}
  ogSlug={`wiki/${entry.id}`}
>
  <article class="wrap post">
    <header>
      <div class="meta">
        {topic && <a class="topic" href="/wiki/">{topic.name}</a>}
        <time datetime={(entry.data.updated ?? entry.data.created).toISOString()}>
          {
            entry.data.updated
              ? `${formatDate(entry.data.updated)} 갱신`
              : formatDate(entry.data.created)
          }
        </time>
        <span>· {readingMinutes(entry.body ?? '')}분</span>
      </div>
      <h1>{entry.data.title}</h1>
      <p class="lead">{entry.data.description}</p>
      <p class="status muted">{STATUS_LABEL[entry.data.status]}</p>
    </header>

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="목차">
          <p>목차</p>
          <ul>
            {toc.map(h => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="body">
      <slot name="before" />
      <Content />
    </div>

    {
      entry.data.tags.length > 0 && (
        <ul class="tags">
          {entry.data.tags.map(t => (
            <li>#{t}</li>
          ))}
        </ul>
      )
    }
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: 3rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .topic {
    color: var(--accent);
    font-weight: 600;
  }
  h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(26px, 4vw, 32px);
    line-height: 1.45;
    letter-spacing: -0.035em;
  }
  .lead {
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }
  .status {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }
  .toc {
    margin-top: 2.25rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }
  .toc p {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    margin-block: 0.2rem;
  }
  .toc .d3 {
    padding-left: 1rem;
  }
  .toc a {
    text-decoration: none;
    color: var(--text-muted);
  }
  .toc a:hover {
    color: var(--text);
  }
  .body {
    margin-top: 2.5rem;
  }
  .body :global(h2) {
    margin-top: 3.25rem;
    font-size: 21px;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .body :global(h3) {
    margin-top: 2.25rem;
    font-size: 1.125rem;
  }
  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin-block: 1.15rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 3rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
</style>

---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import PostRow from '@/components/PostRow.astro'
import { WIKI_TOPICS, getWikiTopic } from '@/consts'
const entries = (await getCollection('wiki', ({ data }) => !data.draft)).sort(
  (a, b) =>
    (b.data.updated ?? b.data.created).valueOf() - (a.data.updated ?? a.data.created).valueOf(),
)
const groups = WIKI_TOPICS.map((topic) => ({
  ...topic,
  count: entries.filter((e) => e.data.topic === topic.id).length,
})).filter((g) => g.count)
// 상태는 두 가지로 보인다. 뼈대만 있는 문서(seed)도 '보완 중'이다(위키 문서 머리와 같은 기준)
const STATUS_LABELS = { stable: '정리됨', growing: '보완 중' }
const STATUS_NOTES = { stable: '한 차례 정리', growing: '설명 추가 중' }
const normalizeStatus = (status: string) => (status === 'stable' ? 'stable' : 'growing')
// 문서가 없는 상태를 칩에 두면 고르는 순간 빈 목록만 나오므로, 실제로 있는 상태만 보인다
const statuses = Object.fromEntries(
  Object.entries(STATUS_LABELS).filter(([value]) =>
    entries.some((entry) => normalizeStatus(entry.data.status) === value),
  ),
) as Partial<typeof STATUS_LABELS>
const statusCounts = Object.fromEntries(
  Object.keys(statuses).map((value) => [
    value,
    entries.filter((entry) => normalizeStatus(entry.data.status) === value).length,
  ]),
)
const documents = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  topic: entry.data.topic,
  tags: entry.data.tags,
  status: normalizeStatus(entry.data.status),
  updated: (entry.data.updated ?? entry.data.created).valueOf(),
}))
// 행의 날짜는 마지막 갱신일. 짧은 형식(2026.09.05)은 PostRow가 다른 목록과 같이 맞춘다
const revised = (entry: (typeof entries)[number]) => entry.data.updated ?? entry.data.created
---

<BaseLayout
  title="학습 위키"
  description="Java, Spring, 데이터베이스부터 웹과 인프라까지. 주제와 키워드로 다시 찾아보는 조해성의 학습 위키."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="학습 위키" label={`${entries.length}편`}>
      <p class="lede">막혔던 개념과 확인한 원리. 주제로 고르거나 키워드로 다시 찾습니다.</p>
    </PageHead>

    <form id="wiki-filter" role="search" class="filters" aria-label="위키 문서 거르기">
      <div class="f-q">
        <label for="wiki-query" class="k">찾기</label>
        <input
          id="wiki-query"
          name="q"
          type="search"
          placeholder="제목·설명·태그"
          autocomplete="off"
        />
      </div>
      <fieldset class="f-g">
        <legend class="k">주제</legend>
        <div class="chips">
          <button type="button" class="chip" data-topic="" aria-pressed="true">
            전체 <span class="n">{entries.length}</span>
          </button>
          {
            groups.map((g) => (
              <button type="button" class="chip" data-topic={g.id} aria-pressed="false">
                <i class="dot hue" style={`--wt: ${g.hue}`} aria-hidden="true" />
                {g.name} <span class="n">{g.count}</span>
              </button>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="f-g">
        <legend class="k">상태</legend>
        <div class="chips">
          <button type="button" class="chip" data-status="" aria-pressed="true">
            전체 <span class="n">{entries.length}</span>
          </button>
          {
            Object.entries(statuses).map(([value, label]) => (
              <button type="button" class="chip" data-status={value} aria-pressed="false">
                {label} <span class="n">{statusCounts[value]}</span>
              </button>
            ))
          }
        </div>
        <p class="legend">
          {
            Object.entries(statuses)
              .map(
                ([value, label]) => `${label}: ${STATUS_NOTES[value as keyof typeof STATUS_NOTES]}`,
              )
              .join(' · ')
          }
        </p>
      </fieldset>
    </form>

    <div class="count">
      <h2 id="wiki-heading" tabindex="-1">최근 갱신한 문서</h2>
      <p id="wiki-count" role="status" aria-live="polite">{entries.length}편</p>
      <button type="button" id="wiki-clear" class="btn" hidden>조건 초기화</button>
    </div>

    <ol id="wiki-documents" class="rows">
      {
        entries.map((entry) => (
          <PostRow
            href={'/wiki/' + entry.id + '/'}
            title={entry.data.title}
            description={entry.data.description}
            date={revised(entry)}
            label={getWikiTopic(entry.data.topic)?.name}
            hue={getWikiTopic(entry.data.topic)?.hue}
            extra={STATUS_LABELS[normalizeStatus(entry.data.status)]}
            dataId={entry.id}
          />
        ))
      }
    </ol>

    <div id="wiki-empty" class="empty" hidden>
      <p>조건에 맞는 문서가 없습니다. 검색어를 줄이거나 주제·상태를 바꿔 보세요.</p>
      <div class="acts">
        <button type="button" id="wiki-reset" class="btn">조건 초기화</button>
        <button type="button" id="wiki-global" class="btn">본문까지 전체 검색</button>
      </div>
    </div>

    <nav class="pagination" aria-label="위키 쪽 이동" id="wiki-pagination" hidden>
      <button id="wiki-prev" type="button" class="btn">← 이전</button>
      <span id="wiki-page" class="k"></span>
      <button id="wiki-next" type="button" class="btn">다음 →</button>
    </nav>
    <noscript>
      <p class="noscript">
        JavaScript가 꺼져 있어 전체 문서를 표시합니다. 브라우저의 찾기 기능을 이용할 수 있습니다.
      </p>
    </noscript>
  </div>
  <script
    is:inline
    id="wiki-data"
    type="application/json"
    set:html={JSON.stringify(documents).replaceAll('<', '\\u003c')}
  />
</BaseLayout>
<script>
  import { selectDocuments } from '@/utils/wiki-library.mjs'
  import { persistURL } from '@/utils/url-state.mjs'
  const docs = JSON.parse(document.getElementById('wiki-data')!.textContent!)
  const list = document.getElementById('wiki-documents')!
  const rows = new Map(
    [...list.querySelectorAll<HTMLElement>('li[data-id]')].map((row) => [row.dataset.id, row]),
  )
  const form = document.getElementById('wiki-filter') as HTMLFormElement
  const query = document.getElementById('wiki-query') as HTMLInputElement
  const topics = [...form.querySelectorAll<HTMLButtonElement>('[data-topic]')]
  const statusChips = [...form.querySelectorAll<HTMLButtonElement>('[data-status]')]
  const previous = document.getElementById('wiki-prev') as HTMLButtonElement
  const next = document.getElementById('wiki-next') as HTMLButtonElement
  const PAGE = 12
  let topic = '',
    status = '',
    page = 1
  const pressChips = (chips: HTMLButtonElement[], key: 'topic' | 'status', value: string) => {
    for (const chip of chips) chip.setAttribute('aria-pressed', String(chip.dataset[key] === value))
  }
  function show(sync = true) {
    const result = selectDocuments(docs, {
      query: query.value,
      topic,
      status,
      page,
      pageSize: PAGE,
    })
    page = result.page
    for (const row of rows.values()) row.hidden = true
    for (const doc of result.items) {
      const row = rows.get(doc.id)!
      row.hidden = false
      list.append(row)
    }
    pressChips(topics, 'topic', topic)
    pressChips(statusChips, 'status', status)
    const active = !!(query.value.trim() || topic || status)
    document.getElementById('wiki-heading')!.textContent = topic
      ? topics
          .find((chip) => chip.dataset.topic === topic)!
          .textContent!.replace(/\s*\d+\s*$/, '')
          .trim()
      : active
        ? '검색 결과'
        : '최근 갱신한 문서'
    // 결과가 없을 때의 안내는 모바일에서 첫 화면 밖에 놓이므로, 화면 안의 건수 줄이 대신 알린다.
    document.getElementById('wiki-count')!.textContent =
      result.total +
      '편' +
      (result.total
        ? result.pages > 1
          ? ' · ' + ((page - 1) * PAGE + 1) + '–' + Math.min(page * PAGE, result.total) + '번째'
          : ''
        : ' · 조건에 맞는 문서가 없습니다')
    // 거르는 조건이 하나라도 있으면 건수 줄에서 바로 지울 수 있게 한다.
    document.getElementById('wiki-clear')!.hidden = !active
    document.getElementById('wiki-empty')!.hidden = result.total > 0
    document.getElementById('wiki-pagination')!.hidden = result.pages <= 1
    document.getElementById('wiki-page')!.textContent = page + ' / ' + result.pages + '쪽'
    previous.disabled = page === 1
    next.disabled = page === result.pages
    if (sync) {
      const url = new URL(location.href)
      url.hash = ''
      url.search = ''
      for (const [key, value] of Object.entries({
        q: query.value.trim(),
        topic,
        status,
        page: page > 1 ? String(page) : '',
      }))
        if (value) url.searchParams.set(key, value)
      persistURL(url)
    }
  }
  function readURL() {
    const params = new URLSearchParams(location.search)
    query.value = params.get('q') ?? ''
    // 옛 주소의 status=seed는 '보완 중'으로 읽는다
    const requestedStatus =
      params.get('status') === 'seed' ? 'growing' : (params.get('status') ?? '')
    status = statusChips.some((chip) => chip.dataset.status === requestedStatus)
      ? requestedStatus
      : ''
    const requested = location.hash.slice(1) || params.get('topic') || ''
    topic = topics.some((chip) => chip.dataset.topic === requested) ? requested : ''
    page = Number(params.get('page')) || 1
    show(false)
  }
  function reset() {
    query.value = ''
    status = ''
    topic = ''
    page = 1
    show()
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault()
    page = 1
    show()
  })
  query.addEventListener('input', () => {
    page = 1
    show()
  })
  for (const chip of topics)
    chip.addEventListener('click', () => {
      topic = chip.dataset.topic!
      page = 1
      show()
    })
  for (const chip of statusChips)
    chip.addEventListener('click', () => {
      status = chip.dataset.status!
      page = 1
      show()
    })
  form.addEventListener('reset', (e) => {
    e.preventDefault()
    reset()
  })
  document.getElementById('wiki-reset')!.addEventListener('click', reset)
  document.getElementById('wiki-clear')!.addEventListener('click', () => {
    reset()
    query.focus()
  })
  // 목록의 제목·설명·태그에 없더라도 본문에는 있을 수 있어, 같은 낱말로 사이트 검색을 연다.
  document.getElementById('wiki-global')!.addEventListener('click', () => {
    dispatchEvent(new CustomEvent('site-search', { detail: query.value.trim() }))
  })
  // 쪽을 넘기면 화면은 목록 위로 가는데 초점은 아래 버튼에 남거나, 마지막 쪽에서 버튼이
  // 비활성화되며 사라진다. 초점을 목록 제목으로 옮겨 키보드 사용자도 새 쪽의 처음부터 읽게 한다.
  const heading = document.getElementById('wiki-heading')!
  function turnPage(delta: number) {
    page += delta
    show()
    heading.focus({ preventScroll: true })
    form.scrollIntoView({ block: 'start' })
  }
  previous.addEventListener('click', () => turnPage(-1))
  next.addEventListener('click', () => turnPage(1))
  addEventListener('popstate', readURL)
  addEventListener('hashchange', readURL)
  readURL()
</script>
<style>
  /* 건수 줄: 목록 제목(h2) + 건수(role=status) + 조건 초기화. 아래 2px 선은 전역 .count가 긋는다 */
  .count {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.75rem;
  }
  .count h2 {
    margin: 0;
    font-size: 0.8125rem;
    line-height: 1.5;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--fg);
  }
  .count p {
    margin: 0;
    color: var(--muted);
  }
  #wiki-clear {
    margin-left: auto;
    min-height: 2rem;
    padding: 0 0.6rem;
    font-size: 0.8125rem;
    letter-spacing: 0;
  }
  .empty p {
    margin: 0;
    color: var(--fg2);
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .noscript {
    margin: 1rem 0 0;
    color: var(--fg2);
  }
</style>

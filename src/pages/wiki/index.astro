---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { WIKI_TOPICS, getWikiTopic } from '@/consts'
import { formatDate } from '@/utils/format'
const entries = (await getCollection('wiki', ({ data }) => !data.draft)).sort(
  (a, b) =>
    (b.data.updated ?? b.data.created).valueOf() - (a.data.updated ?? a.data.created).valueOf(),
)
const groups = WIKI_TOPICS.map((topic) => ({
  ...topic,
  count: entries.filter((e) => e.data.topic === topic.id).length,
})).filter((g) => g.count)
const statuses = { seed: '메모', growing: '보완 중', stable: '정리됨' }
const documents = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  topic: entry.data.topic,
  tags: entry.data.tags,
  status: entry.data.status,
  updated: (entry.data.updated ?? entry.data.created).valueOf(),
}))
---

<BaseLayout
  title="학습 위키"
  description="Java, Spring, 데이터베이스부터 웹과 인프라까지. 주제와 키워드로 다시 찾아보는 조해성의 학습 위키."
  searchIndex={false}
>
  <div class="wrap-wide library">
    <header class="library-head">
      <div>
        <p class="eyebrow">계속 고쳐 쓰는 지식 저장소</p><h1>학습 위키</h1>
        <p class="lead">
          막혔던 개념과 확인한 원리를 쌓습니다. 짧은 메모에서 시작해, 예제와 근거를 보태며 고칩니다.
        </p>
      </div>
      <p class="total"><strong>{entries.length}</strong>개 문서 · {groups.length}개 주제</p>
    </header>
    <div class="library-layout">
      <aside class="subjects">
        <nav aria-label="위키 주제">
          <p class="nav-label">주제별로 찾기</p>
          <a href="/wiki/" data-topic="" aria-current="page"
            >전체 문서 <span>{entries.length}</span></a
          >
          {
            groups.map((g) => (
              <a href={'#' + g.id} data-topic={g.id}>
                <>
                  <span>{g.name}</span>
                  <span>{g.count}</span>
                </>
              </a>
            ))
          }
        </nav>
        <p class="legend">메모 → 보완 중 → 정리됨<br />완성도보다 기록을 먼저 둡니다.</p>
        <a class="write-link" href="/admin/">작성자 편집 안내</a>
      </aside>
      <section class="results" aria-label="위키 문서 목록">
        {groups.map((g) => <span id={g.id} class="topic-anchor" aria-hidden="true" />)}
        <form id="wiki-filter" role="search" class="filters">
          <label class="query"
            >문서 찾기<input
              id="wiki-query"
              name="q"
              type="search"
              placeholder="제목, 설명, 태그로 찾기"
              autocomplete="off"
            /></label
          >
          <div class="selects">
            <label
              >정리 상태<select id="wiki-status" name="status"
                ><option value="">모든 상태</option>{
                  Object.entries(statuses).map(([value, label]) => (
                    <option value={value}>{label}</option>
                  ))
                }</select
              ></label
            >
            <label
              >정렬<select id="wiki-sort" name="sort"
                ><option value="updated">최근 갱신순</option><option value="title">제목순</option
                ></select
              ></label
            >
            <button type="reset">초기화</button>
          </div>
        </form>
        <div class="result-head">
          <h2 id="wiki-heading">전체 문서</h2><p id="wiki-count" role="status" aria-live="polite">
            {entries.length}개 문서
          </p>
        </div>
        <ul id="wiki-documents" class="documents">
          {
            entries.map((entry) => (
              <li data-id={entry.id}>
                <div class="doc-meta">
                  <>
                    <span>{getWikiTopic(entry.data.topic)?.name}</span>
                    <span class={'state ' + entry.data.status}>{statuses[entry.data.status]}</span>
                  </>
                </div>
                <h3>
                  <a href={'/wiki/' + entry.id + '/'}>{entry.data.title}</a>
                </h3>
                <p>{entry.data.description}</p>
                <div class="doc-foot">
                  <>
                    <span>
                      {entry.data.tags
                        .slice(0, 3)
                        .map((tag) => '#' + tag)
                        .join(' ')}
                    </span>
                    <time datetime={(entry.data.updated ?? entry.data.created).toISOString()}>
                      {formatDate(entry.data.updated ?? entry.data.created)}
                      {entry.data.updated ? ' 갱신' : ' 작성'}
                    </time>
                  </>
                </div>
              </li>
            ))
          }
        </ul>
        <div id="wiki-empty" class="empty" hidden>
          <h3>조건에 맞는 문서가 없습니다.</h3><p>
            검색어를 줄이거나 주제·정리 상태를 바꿔 보세요.
          </p><button type="button" id="wiki-reset">전체 문서 보기</button>
        </div>
        <nav class="pagination" aria-label="위키 쪽 이동" id="wiki-pagination" hidden>
          <button id="wiki-prev" type="button">← 이전</button><span id="wiki-page"></span><button
            id="wiki-next"
            type="button">다음 →</button
          >
        </nav>
        <noscript
          ><p>
            JavaScript가 꺼져 있어 전체 문서를 표시합니다. 브라우저의 찾기 기능을 이용할 수
            있습니다.
          </p></noscript
        >
      </section>
    </div>
  </div>
  <script
    is:inline
    id="wiki-data"
    type="application/json"
    set:html={JSON.stringify(documents).replaceAll('<', '\\u003c')}
  />
</BaseLayout>
<script>
  import { selectDocuments } from '@/utils/wiki-library.mjs'
  const docs = JSON.parse(document.getElementById('wiki-data')!.textContent!)
  const list = document.getElementById('wiki-documents')!
  const rows = new Map(
    [...list.querySelectorAll<HTMLElement>('li[data-id]')].map((row) => [row.dataset.id, row]),
  )
  const form = document.getElementById('wiki-filter') as HTMLFormElement
  const query = document.getElementById('wiki-query') as HTMLInputElement
  const status = document.getElementById('wiki-status') as HTMLSelectElement
  const sort = document.getElementById('wiki-sort') as HTMLSelectElement
  const topics = [...document.querySelectorAll<HTMLAnchorElement>('[data-topic]')]
  const previous = document.getElementById('wiki-prev') as HTMLButtonElement
  const next = document.getElementById('wiki-next') as HTMLButtonElement
  let topic = '',
    page = 1
  let urlTimer: ReturnType<typeof setTimeout> | undefined
  function syncURL(url: URL) {
    clearTimeout(urlTimer)
    urlTimer = setTimeout(() => {
      // 브라우저의 history 호출 제한이 문서 탐색을 중단시키지 않게 한다.
      try {
        history.replaceState(null, '', url)
      } catch {
        // URL 저장에 실패해도 필터 결과는 계속 사용할 수 있다.
      }
    }, 250)
  }
  function show(sync = true) {
    const result = selectDocuments(docs, {
      query: query.value,
      topic,
      status: status.value,
      sort: sort.value,
      page,
    })
    page = result.page
    for (const row of rows.values()) row.hidden = true
    for (const doc of result.items) {
      const row = rows.get(doc.id)!
      row.hidden = false
      list.append(row)
    }
    for (const link of topics) {
      if (link.dataset.topic === topic) link.setAttribute('aria-current', 'page')
      else link.removeAttribute('aria-current')
    }
    document.getElementById('wiki-heading')!.textContent = topic
      ? topics.find((link) => link.dataset.topic === topic)!.querySelector('span')!.textContent
      : '전체 문서'
    document.getElementById('wiki-count')!.textContent =
      result.total +
      '개 문서' +
      (result.total
        ? ' · ' + ((page - 1) * 12 + 1) + '–' + Math.min(page * 12, result.total) + '번째'
        : '')
    document.getElementById('wiki-empty')!.hidden = result.total > 0
    document.getElementById('wiki-pagination')!.hidden = result.pages <= 1
    document.getElementById('wiki-page')!.textContent = page + ' / ' + result.pages + '쪽'
    previous.disabled = page === 1
    next.disabled = page === result.pages
    if (sync) {
      const url = new URL(location.href)
      url.hash = ''
      url.search = ''
      for (const [key, value] of Object.entries({
        q: query.value.trim(),
        topic,
        status: status.value,
        sort: sort.value === 'updated' ? '' : sort.value,
        page: page > 1 ? String(page) : '',
      }))
        if (value) url.searchParams.set(key, value)
      syncURL(url)
    }
  }
  function readURL() {
    clearTimeout(urlTimer)
    const params = new URLSearchParams(location.search)
    query.value = params.get('q') ?? ''
    status.value = params.get('status') ?? ''
    sort.value = params.get('sort') === 'title' ? 'title' : 'updated'
    const requested = location.hash.slice(1) || params.get('topic') || ''
    topic = topics.some((link) => link.dataset.topic === requested) ? requested : ''
    page = Number(params.get('page')) || 1
    show(false)
  }
  function reset() {
    query.value = ''
    status.value = ''
    sort.value = 'updated'
    topic = ''
    page = 1
    show()
  }
  form.addEventListener('submit', (e) => {
    e.preventDefault()
    page = 1
    show()
  })
  query.addEventListener('input', () => {
    page = 1
    show()
  })
  for (const field of [status, sort])
    field.addEventListener('change', () => {
      page = 1
      show()
    })
  form.addEventListener('reset', (e) => {
    e.preventDefault()
    reset()
  })
  document.getElementById('wiki-reset')!.addEventListener('click', reset)
  for (const link of topics)
    link.addEventListener('click', (e) => {
      if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
      e.preventDefault()
      topic = link.dataset.topic!
      page = 1
      show()
    })
  previous.addEventListener('click', () => {
    page--
    show()
    form.scrollIntoView({ block: 'start' })
  })
  next.addEventListener('click', () => {
    page++
    show()
    form.scrollIntoView({ block: 'start' })
  })
  addEventListener('popstate', readURL)
  addEventListener('hashchange', readURL)
  readURL()
</script>
<style>
  .library {
    padding-top: 3rem;
  }
  .library-head {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .eyebrow {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
  }
  h1 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 2.75rem);
    letter-spacing: -0.04em;
  }
  .lead {
    max-width: 35rem;
    margin: 0.75rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
  }
  .total {
    color: var(--text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
  }
  .total strong {
    color: var(--text);
    font-size: 1.5rem;
  }
  .library-layout {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 3rem;
    padding-top: 2rem;
  }
  .subjects {
    position: sticky;
    top: 6rem;
    align-self: start;
  }
  .nav-label {
    margin: 0 0 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  .subjects nav a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.65rem 0.75rem;
    min-height: 44px;
    border-radius: 7px;
    font-size: 0.9375rem;
    color: var(--text-muted);
  }
  .subjects a[aria-current] {
    background: var(--bg-subtle);
    color: var(--text);
    font-weight: 600;
    box-shadow: inset 3px 0 var(--accent);
  }
  .subjects a:hover {
    color: var(--accent);
  }
  .legend {
    font-size: 0.875rem;
    line-height: 1.8;
    color: var(--text-muted);
    border-top: 1px solid var(--border);
    padding-top: 1rem;
    margin-top: 1.5rem;
  }
  .write-link {
    display: block;
    font-size: 0.875rem;
    padding-block: 0.75rem;
    color: var(--accent);
  }
  .results {
    min-width: 0;
  }
  .topic-anchor {
    scroll-margin-top: 7rem;
  }
  .filters {
    display: grid;
    gap: 1rem;
    padding: 1.25rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    scroll-margin-top: 7rem;
  }
  label {
    display: grid;
    gap: 0.4rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
  input,
  select,
  button {
    font: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border-strong);
    border-radius: 7px;
    min-height: 44px;
    padding: 0.6rem 0.75rem;
  }
  input {
    width: 100%;
    font-size: 1rem;
  }
  input::placeholder {
    color: var(--text-muted);
  }
  .selects {
    display: flex;
    gap: 0.75rem;
    align-items: end;
    flex-wrap: wrap;
  }
  .selects label {
    flex: 1;
  }
  button {
    cursor: pointer;
    font-size: 0.875rem;
  }
  button:disabled {
    opacity: 0.45;
    cursor: default;
  }
  :is(input, select, button, a):focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .result-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  h2 {
    font-size: 1rem;
    margin: 0;
  }
  .result-head p {
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .documents {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .documents li {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .doc-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }
  .state {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 5px;
    padding: 0.1rem 0.4rem;
  }
  h3 {
    font-size: 1.125rem;
    line-height: 1.6;
    margin: 0.5rem 0;
    letter-spacing: -0.02em;
  }
  h3 a:hover {
    color: var(--accent);
  }
  .documents p {
    font-size: 1rem;
    color: var(--text-muted);
    margin: 0;
  }
  .doc-foot {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.8rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .pagination {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1rem;
    margin-top: 2rem;
    font-size: 0.875rem;
  }
  .empty {
    padding: 3rem 0;
    text-align: center;
    color: var(--text-muted);
  }
  @media (max-width: 760px) {
    .library-head {
      display: block;
    }
    .library-layout {
      display: block;
      padding-top: 1.25rem;
    }
    .subjects {
      position: static;
      margin-bottom: 1.5rem;
    }
    .subjects nav {
      display: flex;
      gap: 0.4rem;
      overflow-x: auto;
      padding: 3px;
    }
    .nav-label,
    .legend,
    .write-link {
      display: none;
    }
    .subjects nav a {
      white-space: nowrap;
      gap: 0.75rem;
      flex: none;
    }
    .total {
      margin-bottom: 0;
    }
    .library {
      padding-top: 2rem;
    }
  }
</style>

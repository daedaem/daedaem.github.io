---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { PROJECTS, TEAM_PROJECTS } from '@/data/projects'

/** 본문의 `코드` 표기를 인라인 코드로 렌더한다 */
const md = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>')
---

<BaseLayout
  title="프로젝트"
  description="개인적으로 만들고 있는 것과 교육 과정에서 한 팀 프로젝트. 기능 목록보다 어떤 문제를 어떤 근거로 풀었는지를 적고, 완성 전이라도 상태를 그대로 적습니다."
>
  <div class="page">
    <header class="phead head">
      <h1>프로젝트</h1>
      <p class="lead">
        진행 중인 개인 프로젝트와 교육 과정의 팀 프로젝트를 구분해 기록합니다. 각 프로젝트의 진행
        상태와 직접 맡은 일을 적었습니다. 실무에서 해결한 문제는
        <a class="text-link" href="/posts/">사례 글</a>에서 다룹니다.
      </p>
      <nav class="project-nav" aria-label="프로젝트 바로가기" data-pagefind-ignore>
        {PROJECTS.length > 0 && <a href="#personal-projects">개인 프로젝트</a>}
        <a href="#team-projects">교육 과정 팀 프로젝트</a>
      </nav>
    </header>

    <div class="prose">
      <section class="personal" aria-labelledby="personal-projects">
        <h2 id="personal-projects" tabindex="-1">개인 프로젝트 · 진행 중</h2>
        {
          PROJECTS.map((p) => (
            <article class:list={['project', { featured: p.featured }]}>
              <p class="k">{p.period}</p>
              <h3>{p.name}</h3>
              <p class="tagline">{p.tagline}</p>
              {p.status && <p class="status">{p.status}</p>}
              <p class="what">{p.what}</p>

              <ul class="points">
                {p.points.map((pt) => (
                  <li>
                    <strong>{pt.title}</strong>
                    <span set:html={md(pt.body)} />
                  </li>
                ))}
              </ul>

              <div class="bottom">
                <dl class="meta">
                  <div>
                    <dt>기술</dt>
                    <dd>{p.stack.join(', ')}</dd>
                  </div>
                </dl>
                {p.repo ? (
                  <a class="repo" href={p.repo}>
                    저장소 →
                  </a>
                ) : (
                  <span class="repo private">비공개 저장소</span>
                )}
              </div>
            </article>
          ))
        }
      </section>

      <section class="team">
        <h2 id="team-projects" tabindex="-1">교육 과정 팀 프로젝트</h2>
        <p class="team-lead">
          삼성 청년 SW 아카데미(SSAFY) 교육 과정에서 진행한 팀 프로젝트입니다. 백엔드로 전향하기
          전이라 주로 프론트엔드를 맡았고, 두 건은 팀장으로 참여했습니다.
        </p>

        {
          TEAM_PROJECTS.map((t) => (
            <article class="team-project">
              <p class="k">
                {t.period}
                {t.lead && ' · 팀장'}
              </p>
              <h3>{t.name}</h3>
              <p class="team-desc">{t.desc}</p>
              <dl class="meta">
                <div>
                  <dt>인원</dt>
                  <dd>{t.team}</dd>
                </div>
                <div>
                  <dt>내가 맡은 일</dt>
                  <dd>
                    <ul>
                      {t.role.map((r) => (
                        <li>{r}</li>
                      ))}
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt>기술</dt>
                  <dd>{t.stack}</dd>
                </div>
              </dl>
              {t.image && (
                <figure class="shot">
                  <img
                    src={t.image.src}
                    width={t.image.width}
                    height={t.image.height}
                    alt={t.image.alt}
                    loading="lazy"
                    decoding="async"
                  />
                  <figcaption>{t.period.slice(0, 4)}년 당시 화면</figcaption>
                </figure>
              )}
              <a class="repo" href={t.repo}>
                저장소 →
              </a>
            </article>
          ))
        }
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .lead {
    margin: 0.6rem 0 0;
    max-width: 36rem;
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--fg2);
  }
  @media (min-width: 46em) {
    .lead {
      font-size: 1.125rem;
    }
  }
  /* 바로가기: 알약 줄 */
  .project-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }
  .project-nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
    text-decoration: none;
  }
  .project-nav a:hover {
    background: var(--soft);
  }
  .project-nav a:focus-visible,
  h2:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  /* 절: 위 1px 선. h2는 .prose의 선을 겹쳐 긋지 않는다 */
  section {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .prose > section:first-child {
    margin-top: 0;
    border-top: 0;
    padding-top: 0;
  }
  section h2 {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  /* 프로젝트 하나: 카드(12px 반경). 라벨(기간) → 제목 → 문장 → 기술 → 저장소 알약 */
  .project,
  .team-project {
    margin-top: 1rem;
    padding: 18px 20px 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--card);
  }
  .project h3 {
    margin: 0.3rem 0 0;
    font-size: 1.3rem;
    font-weight: 650;
  }
  .tagline {
    margin: 0.5rem 0 0;
    font-weight: 600;
  }
  .status {
    margin: 0.5rem 0 0;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .what {
    margin: 0.75rem 0 0;
    color: var(--fg2);
  }
  .points {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.875rem;
  }
  .points li {
    margin: 0;
    padding-left: 0.875rem;
    border-left: 2px solid var(--line);
  }
  .points strong {
    display: block;
    margin-bottom: 0.25rem;
  }
  .points span {
    color: var(--fg2);
  }
  .bottom {
    margin-top: 0.25rem;
  }
  .bottom .meta {
    margin-top: 1rem;
  }
  .repo {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    padding: 0 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: 0.875rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
  }
  a.repo:hover {
    background: var(--soft);
  }
  .repo.private {
    padding: 0;
    border: 0;
    color: var(--muted);
    font-weight: 400;
  }
  .team-lead {
    margin: 0.5rem 0 0;
    color: var(--fg2);
  }
  .team-project h3 {
    margin: 0.3rem 0 0;
    font-size: 1.1875rem;
    font-weight: 650;
  }
  .team-desc {
    margin: 0.5rem 0 0;
    color: var(--fg2);
  }
  .shot {
    margin: 1rem 0 0;
    max-width: 40rem;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 22rem;
    object-fit: cover;
    object-position: top center;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--soft);
  }
  .shot figcaption {
    margin-top: 0.4rem;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .meta {
    margin: 1rem 0 0;
    display: grid;
    gap: 0.6rem;
    font-size: inherit;
    line-height: inherit;
    letter-spacing: inherit;
    color: inherit;
  }
  .meta div {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }
  .meta dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .meta dd {
    margin: 0;
    line-height: 1.7;
  }
  .meta dd ul {
    margin: 0;
    padding-left: 1.05rem;
  }
  .meta dd li {
    margin: 0;
  }
  .team-project .repo {
    margin-top: 1rem;
  }
  @media (max-width: 30rem) {
    .meta div {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>

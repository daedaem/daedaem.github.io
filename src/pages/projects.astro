---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { PROJECTS, TEAM_PROJECTS } from '@/data/projects'

/** 본문의 `코드` 표기를 인라인 코드로 렌더한다 */
const md = (s: string) => s.replace(/`([^`]+)`/g, '<code>$1</code>')
---

<BaseLayout
  title="프로젝트"
  description="개인적으로 만들고 있는 것과 교육 과정에서 한 팀 프로젝트. 기능 목록보다 어떤 문제를 어떤 근거로 풀었는지를 적고, 완성 전이라도 상태를 그대로 적습니다."
>
  <div class="wrap-wide page">
    <header class="head">
      <h1>프로젝트</h1>
      <p class="lead">
        개인적으로 만든 것들입니다. 기능 목록보다 <strong>어떤 문제를 어떤 근거로 풀었는지</strong>를
        적습니다. 완성 전이라도 상태를 적어 두고 올립니다. 회사 업무로 만든 것은 여기에 두지 않고
        <a href="/posts/">글</a>에서 구조와 원리만 다룹니다.
      </p>
    </header>

    {
      PROJECTS.map(p => (
        <article class:list={['project', { featured: p.featured }]}>
          <div class="top">
            <h2>{p.name}</h2>
            <span class="period">{p.period}</span>
          </div>
          <p class="tagline">{p.tagline}</p>
          {p.status && <p class="status">{p.status}</p>}
          <p class="what">{p.what}</p>

          <ul class="points">
            {p.points.map(pt => (
              <li>
                <strong>{pt.title}</strong>
                <span set:html={md(pt.body)} />
              </li>
            ))}
          </ul>

          <div class="bottom">
            <ul class="stack">
              {p.stack.map(s => (
                <li>{s}</li>
              ))}
            </ul>
            {p.repo ? (
              <a class="repo" href={p.repo}>
                저장소 →
              </a>
            ) : (
              <span class="repo private">비공개 저장소</span>
            )}
          </div>
        </article>
      ))
    }

    <section class="team">
      <h2>팀 프로젝트</h2>
      <p class="team-lead">
        삼성 청년 SW 아카데미(SSAFY) 교육 과정에서 진행한 팀 프로젝트입니다. 백엔드로 전향하기 전이라
        주로 프론트엔드를 맡았고, 두 건은 팀장으로 참여했습니다.
      </p>

      {
        TEAM_PROJECTS.map(t => (
          <article class="team-project">
            <div class="top">
              <h3>
                {t.name}
                {t.lead && <span class="badge">팀장</span>}
              </h3>
              <span class="period">{t.period}</span>
            </div>
            <p class="team-desc">{t.desc}</p>
            <dl class="meta">
              <div>
                <dt>인원</dt>
                <dd>{t.team}</dd>
              </div>
              <div>
                <dt>담당</dt>
                <dd>
                  <ul>
                    {t.role.map(r => (
                      <li>{r}</li>
                    ))}
                  </ul>
                </dd>
              </div>
              <div>
                <dt>기술</dt>
                <dd>{t.stack}</dd>
              </div>
            </dl>
            <a class="repo" href={t.repo}>
              저장소 →
            </a>
          </article>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 3.5rem 5rem;
  }
  .head h1 {
    margin: 0;
    font-size: 30px;
    letter-spacing: -0.035em;
  }
  .lead {
    margin: 14px 0 0;
    max-width: 38rem;
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.8;
  }
  .lead strong {
    color: var(--text);
    font-weight: 600;
  }

  .project {
    margin-top: 28px;
    padding: 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .project.featured {
    background: var(--bg-card);
  }

  .top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .top h2 {
    margin: 0;
    font-size: 21px;
    letter-spacing: -0.03em;
  }
  .period {
    font-size: 13px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }

  .tagline {
    margin: 8px 0 0;
    font-size: 15px;
    color: var(--accent);
    font-weight: 500;
  }
  .what {
    margin: 12px 0 0;
    font-size: 15px;
    line-height: 1.8;
    color: var(--text-muted);
    max-width: 44rem;
  }

  .points {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    display: grid;
    gap: 14px;
  }
  .points li {
    padding-left: 14px;
    border-left: 2px solid var(--border);
  }
  .points strong {
    display: block;
    font-size: 15px;
    margin-bottom: 4px;
  }
  .points span {
    font-size: 14.5px;
    line-height: 1.8;
    color: var(--text-muted);
  }
  .points :global(code) {
    font-size: 0.875em;
  }

  .bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: 22px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
  }
  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stack li {
    font-size: 12.5px;
    background: var(--bg-subtle);
    border-radius: 999px;
    padding: 4px 11px;
    color: var(--text-muted);
  }
  .repo {
    font-size: 14px;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }

  .team {
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }
  .team h2 {
    margin: 0;
    font-size: 18px;
    letter-spacing: -0.03em;
  }
  .team-lead {
    margin: 8px 0 0;
    font-size: 14.5px;
    color: var(--text-muted);
  }
  .status {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--text-dim);
  }
  .repo.private {
    color: var(--text-dim);
    font-weight: 400;
  }

  .team-project {
    margin-top: 22px;
    padding: 22px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  .team-project h3 {
    margin: 0;
    font-size: 17px;
    letter-spacing: -0.02em;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .badge {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 999px;
    padding: 1px 8px;
  }
  .team-desc {
    margin: 8px 0 0;
    font-size: 14.5px;
    color: var(--text-muted);
  }
  .meta {
    margin: 16px 0 0;
    display: grid;
    gap: 10px;
  }
  .meta div {
    display: grid;
    grid-template-columns: 4rem 1fr;
    gap: 12px;
    align-items: baseline;
  }
  .meta dt {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--text-dim);
  }
  .meta dd {
    margin: 0;
    font-size: 14px;
    line-height: 1.75;
    color: var(--text-muted);
  }
  .meta dd ul {
    margin: 0;
    padding-left: 1.05rem;
  }
  .meta dd li {
    margin-block: 2px;
  }
  .team-project .repo {
    display: inline-block;
    margin-top: 16px;
  }
  @media (max-width: 30rem) {
    .meta div {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>

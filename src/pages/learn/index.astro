---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import LearningNav from '@/components/LearningNav.astro'
import PostRow from '@/components/PostRow.astro'
import { orderedNoteSeries } from '@/utils/note-series.mjs'
import { noteYearRange } from '@/utils/learning-range.mjs'

const solutions = await getCollection('solutions')
const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const series = orderedNoteSeries(notes)
const groupedIds = new Set(series.flatMap((group) => group.chapters.map(({ note }) => note.id)))
const otherNotes = notes.filter((note) => !groupedIds.has(note.id))
const boj = solutions.filter((s) => s.data.site === '백준').length
const pgs = solutions.filter((s) => s.data.site === '프로그래머스').length
// 노트의 연도 범위(서울 기준). 홈 '더 보기' 행과 같은 함수를 쓴다
const noteYears = noteYearRange(notes)
const arrow =
  '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 18l6-6M13 6l6 6"/></svg>'
---

<BaseLayout
  title="학습 기록"
  description="알고리즘 풀이와 2022~2023년 학습 노트, 개발자로 전환하던 시기의 기록."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="학습 기록">
      <p class="lede">
        과거 학습 노트와 알고리즘 풀이를 모았습니다. 계속 보완하는 개념 정리는 <a href="/wiki/"
          >위키</a
        >에 남깁니다.
      </p>
    </PageHead>
    <LearningNav />

    <section class="blk" aria-labelledby="learn-notes-title">
      <div class="sec-h">
        <h2 class="k" id="learn-notes-title">
          학습 노트 아카이브 <span class="n">{notes.length}편</span>
        </h2>
      </div>
      <p class="blurb">
        {noteYears}년의 노트. JavaScript·TypeScript·웹 기초를 정리한 노트와 그 시기의 이야기입니다.
        오탈자를 고치고 짧은 보충을 덧붙였으며, 지금 보기에 틀린 내용은 지우지 않고 취소선을 그은 뒤
        바로 아래에 바로잡았습니다.
      </p>
      <nav class="series-jumps" aria-label="학습 시리즈 바로가기">
        {series.map((group) => <a href={`#series-${group.id}`}>{group.title}</a>)}
        <a href="#other-notes">그 밖의 노트</a>
        <a href="#learn-algorithms-title">알고리즘 풀이</a>
      </nav>
      <p class="series-help">작성일 대신 장 순서로 모았습니다. 실제 남긴 노트만 보여줍니다.</p>
      {
        series.map((group) => (
          <section class="note-series" aria-labelledby={`series-${group.id}`}>
            <h3 id={`series-${group.id}`}>
              {group.title} <span>{group.chapters.length}편</span>
            </h3>
            <ol class="chapter-list">
              {group.chapters.map(({ chapter, note }) => (
                <li>
                  <a href={`/notes/${note.id}/`}>
                    <span class="chapter-number" aria-hidden="true">
                      {chapter}
                    </span>
                    <span>
                      <strong>{note.data.title.trim()}</strong>
                      {note.data.summary && (
                        <span class="chapter-summary">{note.data.summary}</span>
                      )}
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
      <h3 id="other-notes">그 밖의 학습 노트 <span class="n">{otherNotes.length}편</span></h3>
      <ol class="rows">
        {
          otherNotes.map((note) => (
            <PostRow
              href={`/notes/${note.id}/`}
              title={note.data.title.trim()}
              date={note.data.date}
              prefix="아카이브"
              description={note.data.summary || undefined}
            />
          ))
        }
      </ol>
    </section>
    <section class="blk" aria-labelledby="learn-algorithms-title">
      <div class="sec-h"><h2 class="k" id="learn-algorithms-title">알고리즘 풀이</h2></div>
      <p class="blurb">
        백준 {boj}문제, 프로그래머스 {pgs}문제. 2021년 12월부터 2023년 10월까지의 풀이 {
          solutions.length
        }건을 문제 이름, 난이도, 언어로 찾습니다.
        <a class="more" href="/algorithms/">풀이 아카이브 보기<Fragment set:html={arrow} /></a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .series-jumps {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
    margin-top: 16px;
  }
  .series-jumps a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 16px;
  }
  .series-help {
    color: var(--fg2);
    font-size: 15px;
    line-height: 1.8;
    margin: 12px 0 24px;
  }
  .note-series {
    margin-top: 32px;
  }
  .note-series h3,
  #other-notes {
    margin: 32px 0 12px;
    font-size: 20px;
    line-height: 1.6;
    scroll-margin-top: 120px;
  }
  .note-series h3 span {
    margin-left: 8px;
    font-size: 14px;
    font-weight: 400;
    color: var(--fg2);
  }
  .chapter-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .chapter-list li {
    border-bottom: 1px solid var(--line);
  }
  .chapter-list a {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 12px;
    min-height: 44px;
    padding: 18px 0;
    color: var(--fg);
    text-decoration: none;
  }
  .chapter-number {
    color: var(--fg2);
    font-variant-numeric: tabular-nums;
    line-height: 1.8;
  }
  .chapter-list strong {
    display: block;
    font-size: 17px;
    line-height: 1.8;
    font-weight: 600;
    overflow-wrap: anywhere;
  }
  .chapter-summary {
    display: block;
    color: var(--fg2);
    font-size: 15px;
    line-height: 1.8;
    margin-top: 4px;
  }
  .chapter-list a:hover strong {
    color: var(--accent);
  }

  /* 문장 안의 링크. 44px 높이를 갖되 위아래 음수 여백으로 줄 높이를 흔들지 않는다 */
  .blurb .more {
    margin: -0.6rem 0 -0.6rem 0.25rem;
    vertical-align: baseline;
  }
  .blurb + .rows {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
</style>

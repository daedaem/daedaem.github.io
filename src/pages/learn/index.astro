---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import LearningNav from '@/components/LearningNav.astro'
import { orderedNoteGroups } from '@/utils/note-series.mjs'
import { getWikiTopic } from '@/consts'

const solutions = await getCollection('solutions')
const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const series = orderedNoteGroups(notes)
const boj = solutions.filter((s) => s.data.site === '백준').length
const pgs = solutions.filter((s) => s.data.site === '프로그래머스').length
// 분야별 입구. 글이 실제로 있는 분야만 보이고, 숫자는 컬렉션에서 센다(AI는 글이 생기면 연다)
const wiki = await getCollection('wiki', ({ data }) => !data.draft)
const wikiCount = (ids: string[]) => wiki.filter((w) => ids.includes(w.data.topic)).length
const wikiLink = (id: string) => ({ href: `/wiki/#${id}`, label: getWikiTopic(id)?.name ?? id })
const frontNotes = notes.filter((n) => n.data.categories?.includes('Web Frontend')).length
const backendTopics = ['java', 'spring', 'database', 'dotnet', 'infra']
const fields = [
  {
    id: 'backend',
    name: '백엔드',
    count: `위키 ${wikiCount(backendTopics)}편`,
    links: backendTopics.filter((id) => wikiCount([id])).map(wikiLink),
  },
  {
    id: 'frontend',
    name: '프론트엔드',
    count: `학습 노트 ${frontNotes}편 · 위키 ${wikiCount(['web'])}편`,
    links: [
      { href: '/notes/#core-js', label: 'JavaScript' },
      { href: '/notes/#ts', label: 'TypeScript' },
      wikiLink('web'),
    ],
  },
  {
    id: 'cs',
    name: 'CS · 알고리즘',
    count: `위키 ${wikiCount(['cs'])}편 · 풀이 ${solutions.length}건`,
    links: [wikiLink('cs'), { href: '/algorithms/', label: '알고리즘 풀이' }],
  },
].filter((field) => field.links.length)
const arrow =
  '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 18l6-6M13 6l6 6"/></svg>'
---

<BaseLayout
  title="학습 기록"
  description="알고리즘 풀이와 학습 노트, 개발자로 전환하던 시기의 기록."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="학습 기록">
      <p class="lede">
        과거 학습 노트와 알고리즘 풀이를 모았습니다. 계속 보완하는 개념 정리는 <a href="/wiki/"
          >위키</a
        >에 남깁니다.
      </p>
    </PageHead>
    <LearningNav />

    <section class="blk" aria-labelledby="learn-fields-title">
      <div class="sec-h"><h2 class="k" id="learn-fields-title">분야별로 보기</h2></div>
      <ul class="fields">
        {
          fields.map((field) => (
            <li>
              <h3>{field.name}</h3>
              <p class="fcount">{field.count}</p>
              <p class="links">
                {field.links.map((link) => (
                  <a href={link.href}>{link.label}</a>
                ))}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="blk" aria-labelledby="learn-notes-title">
      <div class="sec-h">
        <h2 class="k" id="learn-notes-title">
          학습 노트 아카이브 <span class="n">{notes.length}편</span>
        </h2>
      </div>
      <p class="blurb">
        학습 노트 {notes.length}편을 시리즈와 장 순서로 모았습니다.
      </p>
      <ul class="group-overview" aria-label="학습 노트 시리즈">
        {
          series.map((group) => (
            <li id={group.seriesId ? `series-${group.seriesId}` : group.id}>
              <a href={`/notes/#${group.id}`}>
                <>
                  <span>{group.title}</span>
                  <span class="n">{group.chapters.length}편 →</span>
                </>
              </a>
            </li>
          ))
        }
      </ul>
      <a class="more" id="other-notes" href="/notes/"
        >전체 장 목록 보기<Fragment set:html={arrow} /></a
      >
    </section>
    <section class="blk" aria-labelledby="learn-algorithms-title">
      <div class="sec-h"><h2 class="k" id="learn-algorithms-title">알고리즘 풀이</h2></div>
      <p class="blurb">
        백준 {boj}문제, 프로그래머스 {pgs}문제. 풀이 {solutions.length}건을 문제 이름, 난이도,
        언어로 찾습니다.
        <a class="more" href="/algorithms/">풀이 아카이브 보기<Fragment set:html={arrow} /></a>
      </p>
    </section>
  </div>
</BaseLayout>

<style>
  .fields {
    list-style: none;
    margin: 16px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .fields li {
    padding: 16px 18px 12px;
    border: 1px solid var(--line);
    border-radius: 10px;
  }
  .fields h3 {
    margin: 0;
    font-size: 17px;
    line-height: 26px;
  }
  .fields .fcount {
    margin: 2px 0 8px;
    color: var(--fg2);
    font-size: 14px;
    line-height: 22px;
    font-variant-numeric: tabular-nums;
  }
  .fields .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 14px;
    margin: 0;
  }
  .fields .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: 15px;
  }
  @media (max-width: 760px) {
    .fields {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .group-overview {
    list-style: none;
    padding: 0;
    margin: 16px 0 8px;
    border-top: 1px solid var(--line);
  }
  .group-overview li {
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 120px;
  }
  .group-overview a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    padding: 12px 0;
    color: var(--fg);
    text-decoration: none;
  }
  .group-overview a:hover {
    color: var(--accent);
  }
  .group-overview .n {
    white-space: nowrap;
    color: var(--fg2);
    font-size: 14px;
  }
  .blurb .more {
    margin: -0.6rem 0 -0.6rem 0.25rem;
    vertical-align: baseline;
  }
</style>

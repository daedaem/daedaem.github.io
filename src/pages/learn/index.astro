---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import LearningNav from '@/components/LearningNav.astro'
import PostRow from '@/components/PostRow.astro'

const solutions = await getCollection('solutions')
const notes = (await getCollection('notes')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const boj = solutions.filter((s) => s.data.site === '백준').length
const pgs = solutions.filter((s) => s.data.site === '프로그래머스').length
// 노트의 연도 범위. 날짜는 서울 기준으로 읽는다
const year = (date: Date) =>
  new Intl.DateTimeFormat('ko-KR', { year: 'numeric', timeZone: 'Asia/Seoul' })
    .formatToParts(date)
    .find((p) => p.type === 'year')!.value
const years = [...new Set(notes.map((n) => year(n.data.date)))].sort()
const noteYears = years.length > 1 ? `${years[0]}–${years.at(-1)}` : (years[0] ?? '')
const arrow =
  '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 18l6-6M13 6l6 6"/></svg>'
---

<BaseLayout
  title="학습 기록"
  description="알고리즘 풀이와 2022~2023년 학습 노트, 개발자로 전환하던 시기의 기록."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="학습 기록">
      <p class="lede">문제를 풀고, 개념을 익히고, 개발자로 방향을 바꾸던 기록입니다.</p>
    </PageHead>
    <LearningNav />

    <section class="blk" aria-labelledby="learn-algorithms-title">
      <div class="sec-h"><h2 class="k" id="learn-algorithms-title">알고리즘 풀이</h2></div>
      <p class="blurb">
        백준 {boj}문제, 프로그래머스 {pgs}문제. 2021년 12월부터 2023년 10월까지의 풀이 {
          solutions.length
        }건을 문제 이름, 난이도, 언어로 찾습니다.
        <a class="more" href="/algorithms/">풀이 아카이브 보기<Fragment set:html={arrow} /></a>
      </p>
    </section>

    <section class="blk" aria-labelledby="learn-notes-title">
      <div class="sec-h">
        <h2 class="k" id="learn-notes-title">
          학습 노트 아카이브<span class="n">{notes.length}편</span>
        </h2>
      </div>
      <p class="blurb">
        {noteYears}년의 노트. JavaScript·TypeScript·웹 기초를 정리한 노트와 그 시기의 이야기입니다.
        오탈자를 고치고 짧은 보충을 덧붙였으며, 지금 보기에 틀린 내용은 지우지 않고 취소선을 그은 뒤
        바로 아래에 바로잡았습니다.
      </p>
      <ol class="rows">
        {
          notes.map((note) => (
            <PostRow
              href={`/notes/${note.id}/`}
              title={note.data.title.trim()}
              date={note.data.date}
              prefix="아카이브"
              description={note.data.summary || undefined}
            />
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  .blurb .more {
    margin-left: 0.25rem;
    min-height: 0;
    vertical-align: baseline;
  }
  .blurb + .rows {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
</style>

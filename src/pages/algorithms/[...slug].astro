---
import { getCollection, render } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'

export const getStaticPaths = async () => {
  const all = await getCollection('solutions')
  return all.map((s) => {
    /** 같은 유형의 다른 문제를 붙여 이어 볼 수 있게 한다 */
    const related = all
      .filter((o) => o.id !== s.id && o.data.categories.some((c) => s.data.categories.includes(c)))
      .sort((a, b) => Math.abs(a.data.rank - s.data.rank) - Math.abs(b.data.rank - s.data.rank))
      .slice(0, 6)
    return { params: { slug: s.id }, props: { entry: s, related } }
  })
}

const { entry, related } = Astro.props
const { Content } = await render(entry)
const d = entry.data
const LANG: Record<string, string> = {
  cpp: 'C++',
  python: 'Python',
  javascript: 'JavaScript',
  java: 'Java',
  c: 'C',
  sql: 'SQL',
}
const langLabel = d.langs.map((l) => LANG[l] ?? l).join(', ')
/** 프로그래머스 레벨은 데이터에 'lv2'로 저장돼 있다. 화면에는 목록과 같은 'Level 2'로 보인다 */
const tierLabel = (tier: string) => tier.replace(/^lv(\d)$/, 'Level $1')
const tier = tierLabel(d.tier)
// 유형이 없는 풀이(프로그래머스)는 설명에 빈 조각 '. .'이 남지 않게 뺀다
const description =
  [
    `${d.site} ${tier} ${d.title}${d.num ? ` ${d.num}번` : ''} 풀이 코드`,
    d.categories.join(', '),
    langLabel,
  ]
    .filter(Boolean)
    .join('. ') + '.'
---

<BaseLayout title={`${d.title} — ${d.site} ${tier}`} description={description}>
  <div class="page">
    <article class="art solution">
      <header class="art-head">
        <p class="meta" data-pagefind-ignore>
          <a href="/learn/" set:text="학습 기록" />
          <span class="sep" aria-hidden="true" set:text="›" />
          <a href="/algorithms/" set:text="알고리즘" />
          <span class="sep" aria-hidden="true" set:text="·" />
          <span set:text={`${d.site} ${tier}`} />
          {d.num && <span class="sep" aria-hidden="true" set:text="·" />}
          {d.num && <span class="num" set:text={`#${d.num}`} />}
        </p>
        <h1 tabindex="-1">{d.title}</h1>
      </header>

      {
        d.reviewNote && (
          <aside class="cause">
            <p class="k">확인 필요</p>
            <p>{d.reviewNote}</p>
          </aside>
        )
      }

      <dl class="facts">
        {
          d.categories.length > 0 && (
            <div>
              <dt class="k">유형</dt>
              <dd>{d.categories.join(' · ')}</dd>
            </div>
          )
        }
        <div><dt class="k">언어</dt><dd>{langLabel}</dd></div>
        {
          d.runtime && (
            <div>
              <dt class="k">실행 시간</dt>
              <dd>{d.runtime}</dd>
            </div>
          )
        }
        {
          d.memory && (
            <div>
              <dt class="k">메모리</dt>
              <dd>{d.memory}</dd>
            </div>
          )
        }
        {
          d.problemUrl && (
            <div>
              <dt class="k">문제</dt>
              <dd>
                <a class="source-link" href={d.problemUrl}>
                  원문 →
                </a>
              </dd>
            </div>
          )
        }
      </dl>

      <div class="prose">
        <h2 class="code-title">풀이</h2>
        <div class="body code-fold" id="code-fold">
          <Content />
        </div>
      </div>
      <button
        type="button"
        class="btn fold-toggle"
        id="fold-toggle"
        aria-controls="code-fold"
        aria-expanded="true"
        hidden>코드 전체 펼치기</button
      >

      {/* 글 끝: 글·위키와 같은 2px 선 아래 고지와 이어 볼 문제 */}
      <footer class="art-end">
        <aside class="notice" data-pagefind-ignore>
          <p>
            문제 지문과 예제 입출력은 {d.site}의 저작물이라 싣지 않았습니다.
            {d.problemUrl && <a href={d.problemUrl}>원문</a>}에서 확인하세요. 과거 학습 코드를
            보관한 기록이며, 확인된 오류와 출처 확인이 필요한 부분은 별도로 표시합니다.
          </p>
        </aside>

        {
          related.length > 0 && (
            <section class="back related" aria-label="같은 유형의 다른 문제" data-pagefind-ignore>
              <h2 class="k">같은 유형의 다른 문제</h2>
              <ul>
                {related.map((r) => (
                  <li>
                    <span class="k-in rtier">{tierLabel(r.data.tier)}</span>
                    <a class="stretched-link" href={`/algorithms/${r.id}/`}>
                      {r.data.title}
                    </a>
                    <span class="rcat">{r.data.categories.slice(0, 2).join(' · ')}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </footer>
    </article>
  </div>
</BaseLayout>

<script>
  // 긴 풀이 코드는 접어 두고 단추로 펼친다. 짧으면 단추를 보이지 않는다.
  const fold = document.getElementById('code-fold')!
  const btn = document.getElementById('fold-toggle') as HTMLButtonElement
  const LIMIT = 720
  if (fold.scrollHeight > LIMIT + 120) {
    fold.classList.add('folded')
    btn.hidden = false
    btn.setAttribute('aria-expanded', 'false')
    btn.addEventListener('click', () => {
      const folded = fold.classList.toggle('folded')
      btn.textContent = folded ? '코드 전체 펼치기' : '코드 접기'
      btn.setAttribute('aria-expanded', String(!folded))
      if (!folded) return
      fold.scrollIntoView({ block: 'start' })
    })
  }
</script>

<style>
  .num {
    font-variant-numeric: tabular-nums;
  }
  /* 문제 정보: 라벨 + 값 한 줄씩 */
  .facts {
    display: grid;
    gap: 0.35rem 1.5rem;
    margin: 1.5rem 0 0;
    padding: 14px 18px;
    border: 1px solid var(--line);
    border-radius: var(--r-box);
    background: var(--card);
  }
  .facts div {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.75rem;
    align-items: baseline;
  }
  .facts dd {
    margin: 0;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
  }
  /* 한 줄짜리 보조 링크도 손가락으로 누를 수 있는 높이를 준다 */
  .source-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
  .code-title {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .code-fold.folded {
    max-height: 720px;
    overflow: hidden;
    position: relative;
  }
  .code-fold.folded::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 120px;
    background: linear-gradient(to bottom, transparent, var(--bg));
    pointer-events: none;
  }
  .fold-toggle {
    width: 100%;
    justify-content: center;
    margin-top: 0.5rem;
  }
  .related li {
    position: relative;
    flex-wrap: wrap;
    min-height: var(--control-size);
  }
  .related a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    text-decoration: none;
  }
  .related a:hover {
    text-decoration: underline;
  }
  .rtier {
    flex: 0 0 5rem;
  }
  .rcat {
    font-size: 0.8125rem;
    color: var(--muted);
  }
  @media (max-width: 40em) {
    .rcat {
      flex-basis: 100%;
      padding-left: 5.6rem;
    }
  }
</style>

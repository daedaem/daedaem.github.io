---
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import LearningNav from '@/components/LearningNav.astro'
import PageNumbers from '@/components/PageNumbers.astro'
import { getCollection } from 'astro:content'

const LANG: Record<string, string> = {
  cpp: 'C++',
  python: 'Python',
  javascript: 'JavaScript',
  java: 'Java',
  c: 'C',
  sql: 'SQL',
}

const solutions = await getCollection('solutions')
type Item = {
  site: string
  tier: string
  rank: number
  title: string
  cls: string[]
  lang: string[]
  href: string
  needsReview: boolean
}
const all: Item[] = solutions
  .map((s) => ({
    site: s.data.site,
    tier: s.data.tier,
    rank: s.data.rank,
    title: s.data.title,
    cls: s.data.categories,
    lang: s.data.langs.map((l) => LANG[l] ?? l),
    href: `/algorithms/${s.id}/`,
    needsReview: Boolean(s.data.reviewNote),
  }))
  .sort((a, b) => b.rank - a.rank || a.title.localeCompare(b.title, 'ko'))

const boj = all.filter((i) => i.site === '백준')
const pgs = all.filter((i) => i.site === '프로그래머스')

/** 백준은 대분류(Bronze/Silver/Gold/Platinum)로 묶고, 프로그래머스는 레벨로 묶는다 */
const majorOf = (tier: string) => tier.split(' ')[0]

const BOJ_ORDER = ['Platinum', 'Gold', 'Silver', 'Bronze', 'Unrated']
const bojGroups = BOJ_ORDER.map((g) => ({
  name: g,
  items: boj.filter((i) => majorOf(i.tier) === g).sort((a, b) => b.rank - a.rank),
})).filter((g) => g.items.length > 0)

const PGS_ORDER = ['lv4', 'lv3', 'lv2', 'lv1', 'lv0']
const pgsGroups = PGS_ORDER.map((g) => ({
  name: g.replace('lv', 'Level '),
  items: pgs.filter((i) => i.tier === g),
})).filter((g) => g.items.length > 0)

const countBy = (key: (i: Item) => string[]) => {
  const m = new Map<string, number>()
  for (const i of all) for (const k of key(i)) m.set(k, (m.get(k) ?? 0) + 1)
  return [...m.entries()].sort((a, b) => b[1] - a[1])
}
const byCls = countBy((i) => i.cls).slice(0, 18)
const byLang = countBy((i) => i.lang)

/** 백준 Gold 이상. 프로그래머스(rank 100+)와 Unrated는 제외한다 */
const goldPlus = boj.filter((i) => i.rank >= 10 && i.rank < 100).length

/** 그룹당 한 쪽에 보여 주는 개수. 넘는 건 쪽 번호로 넘긴다. 필터 결과도 같은 단위로 나눈다. */
const PAGE = 10
const pagesOf = (n: number) => Math.max(1, Math.ceil(n / PAGE))

const siteGroups = [
  { title: '백준', groups: bojGroups, prefix: 'boj-', tierOf: (g: string, i: Item) => i.tier },
  {
    title: '프로그래머스',
    groups: pgsGroups,
    prefix: 'pgs-',
    tierOf: (g: string) => g.replace('Level ', 'Lv'),
  },
]
const groupKey = (prefix: string, name: string) =>
  prefix === 'boj-' ? `boj-${name.toLowerCase()}` : `pgs-${name.replace('Level ', 'lv')}`
const defaultOpen = (name: string) => ['Platinum', 'Gold', 'Level 4', 'Level 3'].includes(name)
---

<BaseLayout
  title="알고리즘"
  description={`백준 ${boj.length}문제, 프로그래머스 ${pgs.length}문제. 티어·유형·언어별로 정리한 풀이 기록입니다.`}
  searchIndex={false}
>
  <div class="page">
    <PageHead title="알고리즘" label={`${all.length}문제`}>
      <p class="lede">
        2021년 12월부터 2023년 10월까지의 풀이 기록. 문제 이름으로 찾거나 난이도별로 넘겨 봅니다.
      </p>
    </PageHead>
    <LearningNav />

    <p class="k stats">
      백준 {boj.length}<span class="sep" aria-hidden="true">·</span>프로그래머스 {pgs.length}<span
        class="sep"
        aria-hidden="true">·</span
      >Gold 이상 {goldPlus}
    </p>

    <div class="filters" role="search" aria-label="풀이 거르기">
      <div class="f-q">
        <label for="q" class="k">찾기</label>
        <input id="q" type="search" placeholder="문제 이름" autocomplete="off" maxlength="200" />
      </div>
      <details class="facets-box">
        <summary>유형·언어로 좁히기 <span id="facet-state"></span></summary>
        <div class="facets" aria-label="알고리즘 상세 필터">
          <fieldset class="f-g">
            <legend class="k">많이 푼 유형</legend>
            <div class="chips">
              {
                byCls.map(([k, v]) => (
                  <button type="button" class="chip" data-cls={k} aria-pressed="false">
                    {k} <span class="n">{v}</span>
                  </button>
                ))
              }
            </div>
          </fieldset>
          <fieldset class="f-g">
            <legend class="k">언어</legend>
            <div class="chips">
              {
                byLang.map(([k, v]) => (
                  <button type="button" class="chip" data-lang={k} aria-pressed="false">
                    {k} <span class="n">{v}</span>
                  </button>
                ))
              }
            </div>
          </fieldset>
          <p class="legend">
            유형 분류는 백준 풀이 기준입니다. 프로그래머스 풀이는 아직 유형 미분류입니다.
          </p>
        </div>
      </details>
    </div>

    <div class="count">
      <p id="count" role="status" aria-live="polite"></p>
      <button type="button" id="clear" class="btn" hidden>필터 지우기</button>
    </div>

    {
      /*
      필터·쪽 상태가 담긴 주소로 들어오면 모듈 스크립트가 첫 그리기 뒤에 목록을 다시 거른다.
      그 사이 기본 목록이 보였다가 통째로 바뀌지 않도록, 파싱 중에 목록을 숨겨 두고
      복원이 끝나면 드러낸다. 모듈이 실패해도 3초 뒤에는 반드시 드러낸다.
    */
    }
    <script is:inline>
      if (/[?&](q|type|lang|open|page\.[^=&]+)=/.test(location.search)) {
        document.documentElement.classList.add('algo-restoring')
        setTimeout(() => document.documentElement.classList.remove('algo-restoring'), 3000)
      }
    </script>
    {
      siteGroups.map((site) => (
        <>
          <h2 class="site-title k">{site.title}</h2>
          {site.groups.map((g) => (
            <details
              class="group"
              open={defaultOpen(g.name)}
              data-total={g.items.length}
              data-group={groupKey(site.prefix, g.name)}
            >
              <summary>
                {g.name} <span class="n">{g.items.length}</span>
              </summary>
              <ul class="list">
                {g.items.map((i, idx) => (
                  <li
                    data-title={i.title.toLowerCase()}
                    data-cls={i.cls.join('|')}
                    data-lang={i.lang.join('|')}
                    hidden={idx >= PAGE}
                  >
                    <span class="tier">{site.tierOf(g.name, i)}</span>
                    <a class="name stretched-link" href={i.href}>
                      {i.title}
                      {i.needsReview && <span class="review-label"> · 확인 필요</span>}
                    </a>
                    <span class="facts">
                      <span class="cls">{i.cls.slice(0, 3).join(' · ')}</span>
                      <span class="lang">{i.lang.join(', ')}</span>
                    </span>
                  </li>
                ))}
              </ul>
              <nav class="pager" aria-label={`${g.name} 쪽 이동`} hidden={g.items.length <= PAGE}>
                <button type="button" class="pg btn prev" disabled>
                  ‹ 이전
                </button>
                <PageNumbers total={pagesOf(g.items.length)} />
                <button type="button" class="pg btn next" disabled={pagesOf(g.items.length) <= 1}>
                  다음 ›
                </button>
                <span class="range">
                  1–{Math.min(PAGE, g.items.length)} / {g.items.length}
                </span>
              </nav>
            </details>
          ))}
        </>
      ))
    }

    <p class="empty" id="empty" hidden>조건에 맞는 문제가 없습니다.</p>
    <p class="repo">
      문제 지문은 원문 링크에서, 풀이 기록은 <a
        href="https://github.com/daedaem/algorithm-study-archive">algorithm-study-archive</a
      >에서도 볼 수 있습니다.
    </p>
  </div>
  <script>
    import { paginationWindow } from '@/utils/pagination.mjs'
    import { readAlgorithmState, writeAlgorithmState } from '@/utils/algorithm-state.mjs'
    // 정적 목록을 클라이언트에서 거른 뒤 그룹마다 10개씩 쪽으로 나눈다.
    // 검색어·유형·언어 세 조건은 AND이고, 조건이 바뀌면 모든 그룹을 1쪽으로 되돌린다.
    const PAGE = 10
    const q = document.getElementById('q') as HTMLInputElement
    const clearBtn = document.getElementById('clear') as HTMLButtonElement
    const count = document.getElementById('count')!
    const empty = document.getElementById('empty')!
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.facets .chip')]
    const groups = [...document.querySelectorAll<HTMLDetailsElement>('.group')]
    const page = new Map<HTMLDetailsElement, number>()

    let cls = ''
    let lang = ''
    const defaultOpen = new Map(groups.map((g) => [g, g.open]))
    const choices = {
      categories: chips.flatMap((c) => (c.dataset.cls ? [c.dataset.cls] : [])),
      languages: chips.flatMap((c) => (c.dataset.lang ? [c.dataset.lang] : [])),
      groups: Object.fromEntries(
        groups.map((g) => [
          g.dataset.group!,
          Math.max(1, Math.ceil(Number(g.dataset.total) / PAGE)),
        ]),
      ),
    }
    let urlTimer: ReturnType<typeof setTimeout> | undefined
    function persistURL() {
      clearTimeout(urlTimer)
      const expanded = groups.filter((g) => g.open).map((g) => g.dataset.group!)
      const usesDefault = groups.every((g) => g.open === defaultOpen.get(g))
      const url = writeAlgorithmState(location.href, {
        query: q.value,
        category: cls,
        language: lang,
        pages: Object.fromEntries(groups.map((g) => [g.dataset.group!, page.get(g) ?? 1])),
        expanded: usesDefault ? undefined : expanded,
      })
      if (url.href === location.href) return
      try {
        history.replaceState(history.state, '', url)
      } catch {
        // A browser history quota must not prevent filtering the visible list.
      }
    }
    function scheduleURL() {
      clearTimeout(urlTimer)
      urlTimer = setTimeout(persistURL, 200)
    }

    function matches(li: HTMLLIElement, term: string) {
      return (
        (!term || (li.dataset.title ?? '').includes(term)) &&
        (!cls || (li.dataset.cls ?? '').split('|').includes(cls)) &&
        (!lang || (li.dataset.lang ?? '').split('|').includes(lang))
      )
    }

    function renderGroup(g: HTMLDetailsElement, active: boolean, expandMatches = false) {
      const term = q.value.trim().toLowerCase()
      const rows = [...g.querySelectorAll<HTMLLIElement>('.list li')]
      const hit = rows.filter((li) => matches(li, term))
      const pages = Math.max(1, Math.ceil(hit.length / PAGE))
      const cur = Math.min(page.get(g) ?? 1, pages)
      page.set(g, cur)
      const from = (cur - 1) * PAGE
      const to = Math.min(from + PAGE, hit.length)

      for (const li of rows) li.hidden = true
      for (const li of hit.slice(from, to)) li.hidden = false

      const total = Number(g.dataset.total)
      const n = g.querySelector('summary .n')!
      n.textContent = active ? `${hit.length} / ${total}` : String(total)
      g.hidden = active && hit.length === 0
      if (expandMatches && active && hit.length > 0) g.open = true

      const nav = g.querySelector<HTMLElement>('.pager')!
      nav.hidden = hit.length <= PAGE
      ;(nav.querySelector('.prev') as HTMLButtonElement).disabled = cur <= 1
      ;(nav.querySelector('.next') as HTMLButtonElement).disabled = cur >= pages
      nav.querySelector('.range')!.textContent = `${from + 1}–${to} / ${hit.length}`
      // 쪽 번호 버튼은 서버에서 그려 둔 것을 그대로 쓴다. JS로 새로 만들면 Astro 스코프 스타일이 안 붙는다.
      const { numbers, gapBefore } = paginationWindow(pages, cur)
      for (const b of nav.querySelectorAll<HTMLButtonElement>('.num')) {
        const n = Number(b.dataset.page)
        b.hidden = !numbers.includes(n)
        if (n === cur) b.setAttribute('aria-current', 'page')
        else b.removeAttribute('aria-current')
      }
      for (const gap of nav.querySelectorAll<HTMLElement>('.pg-gap')) {
        gap.hidden = !gapBefore.includes(Number(gap.dataset.before))
      }
      return hit.length
    }

    function apply(sync = true, expandMatches = false) {
      const active = !!(q.value.trim() || cls || lang)
      let shown = 0
      for (const g of groups) shown += renderGroup(g, active, expandMatches)

      // 사이트 소제목(백준/프로그래머스)은 아래 그룹이 전부 숨었을 때 같이 숨긴다
      for (const h of document.querySelectorAll<HTMLElement>('.site-title')) {
        let el = h.nextElementSibling
        let any = false
        while (el && !el.classList.contains('site-title')) {
          if (el.classList.contains('group') && !(el as HTMLElement).hidden) any = true
          el = el.nextElementSibling
        }
        h.hidden = !any
      }

      count.textContent = active ? `${shown}문제` : ''
      document.getElementById('facet-state')!.textContent = [cls, lang].filter(Boolean).join(' · ')
      clearBtn.hidden = !active
      empty.hidden = !(active && shown === 0)
      for (const c of chips) {
        const on =
          (c.dataset.cls && c.dataset.cls === cls) || (c.dataset.lang && c.dataset.lang === lang)
        c.setAttribute('aria-pressed', String(!!on))
      }
      if (sync) scheduleURL()
    }

    function resetPages() {
      page.clear()
      for (const g of groups) g.open = defaultOpen.get(g) ?? false
      apply(true, true)
    }

    q.addEventListener('input', resetPages)
    for (const c of chips) {
      c.addEventListener('click', () => {
        if (c.dataset.cls !== undefined) cls = cls === c.dataset.cls ? '' : c.dataset.cls
        if (c.dataset.lang !== undefined) lang = lang === c.dataset.lang ? '' : c.dataset.lang
        resetPages()
      })
    }
    clearBtn.addEventListener('click', () => {
      q.value = ''
      cls = ''
      lang = ''
      resetPages()
      q.focus()
    })
    for (const g of groups) {
      g.querySelector('.pager')?.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.pg')
        if (!b || b.disabled) return
        const cur = page.get(g) ?? 1
        if (b.classList.contains('prev')) page.set(g, cur - 1)
        else if (b.classList.contains('next')) page.set(g, cur + 1)
        else page.set(g, Number(b.dataset.page))
        renderGroup(g, !!(q.value.trim() || cls || lang))
        // 쪽 선택은 연속 타이핑이 아니다. 바로 새로고침해도 선택한 쪽이 남아야 한다.
        persistURL()
        // 그룹 머리가 화면 위로 벗어났을 때만 올린다. 보이는 상태에서 쪽만 넘길 때는 시점을 유지한다.
        const head = g.querySelector('summary')!
        if (head.getBoundingClientRect().top < 0) head.scrollIntoView({ block: 'start' })
      })
      g.addEventListener('toggle', scheduleURL)
    }
    function readURL() {
      clearTimeout(urlTimer)
      const state = readAlgorithmState(location.search, choices)
      q.value = state.query
      cls = state.category
      lang = state.language
      for (const g of groups) {
        const id = g.dataset.group!
        page.set(g, state.pages[id])
        g.open =
          state.expanded?.includes(id) ?? (state.pages[id] > 1 || defaultOpen.get(g) || false)
      }
      apply(false, state.expanded === undefined)
    }
    // Flush even when a result is opened before the typing debounce expires.
    document.addEventListener(
      'click',
      (e) => {
        if ((e.target as Element).closest('.list a')) persistURL()
      },
      { capture: true },
    )
    addEventListener('pagehide', persistURL)
    addEventListener('popstate', readURL)
    readURL()
    document.documentElement.classList.remove('algo-restoring')
  </script>
</BaseLayout>

<style>
  :global(html.algo-restoring) .site-title,
  :global(html.algo-restoring) .group,
  :global(html.algo-restoring) #empty {
    visibility: hidden;
  }

  /* 건수 한 줄. 라벨 크기이며 숫자는 폭이 같은 숫자다. 티어 이름(Gold)은 대문자로 바꾸지 않는다 */
  .stats {
    margin: -12px 0 16px;
    text-transform: none;
  }

  /* 유형·언어 칩은 접어 둔다. 열면 위키와 같은 칩 묶음이다 */
  .facets-box {
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--card);
  }
  .facets-box > summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--control-size);
    padding: 0 0.9rem;
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
    list-style: none;
  }
  .facets-box > summary::-webkit-details-marker {
    display: none;
  }
  .facets-box > summary::after {
    content: '';
    width: 0.5em;
    height: 0.5em;
    margin-left: auto;
    border-right: 1.5px solid var(--muted);
    border-bottom: 1.5px solid var(--muted);
    transform: rotate(45deg) translateY(-0.15em);
    transition: transform 0.2s;
  }
  .facets-box[open] > summary::after {
    transform: rotate(225deg) translateY(0.1em);
  }
  #facet-state {
    font-weight: 400;
    color: var(--muted);
  }
  .facets {
    display: grid;
    gap: 1rem;
    padding: 0.75rem 0.9rem 1rem;
    border-top: 1px solid var(--line);
  }
  .facets .legend {
    margin: 0;
  }

  /* 건수 줄: 필터가 있을 때만 결과 수와 지우기 단추가 보인다. 없을 때는 자리도 차지하지 않는다 */
  .count {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    padding-bottom: 0;
    border-bottom: 0;
  }
  .count p {
    margin: 0;
    color: var(--muted);
  }
  .count p:empty {
    display: none;
  }
  /* 44px 높이를 갖되 위아래 음수 여백으로 건수 줄 높이는 그대로 둔다 */
  #clear {
    margin: -0.6rem 0;
    min-height: var(--control-size);
    padding: 0 0.6rem;
    font-size: 0.8125rem;
    letter-spacing: 0;
  }

  .site-title {
    margin: 2rem 0 0.25rem;
    font-size: 1.25rem;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--fg);
  }

  .group {
    border-bottom: 1px solid var(--line);
  }
  .group summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    min-height: var(--control-size);
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
    list-style: none;
  }
  .group summary::-webkit-details-marker {
    display: none;
  }
  .group summary::before {
    content: '▸';
    display: inline-block;
    width: 1.2em;
    color: var(--muted);
    transition: transform 0.15s ease;
  }
  .group[open] summary::before {
    transform: rotate(90deg);
  }
  .group summary .n {
    font-weight: 400;
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  .list {
    list-style: none;
    margin: 0 0 0.75rem;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto auto;
    gap: 0.75rem;
    align-items: baseline;
    padding: 0.45rem 0 0.45rem 1.2em;
    font-size: 0.9375rem;
    border-top: 1px solid var(--line);
    position: relative;
  }
  /* 넓은 화면의 목록 밀도는 유지하고, 손가락으로 누르는 화면에서만 행 높이를 44px로 맞춘다 */
  @media (max-width: 47.5em), (pointer: coarse) {
    .list li {
      min-height: var(--control-size);
    }
  }
  .tier {
    font-size: 0.8125rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .name {
    text-decoration: none;
    font-weight: 500;
  }
  .name:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .review-label {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  /* 넓은 화면에서는 유형·언어가 각자 열을 차지하도록 묶음을 풀어 둔다 */
  .facts {
    display: contents;
  }
  .cls,
  .lang {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .pager {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.5rem;

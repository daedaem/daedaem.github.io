---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { getCollection } from 'astro:content'

const LANG: Record<string, string> = {
  cpp: 'C++',
  python: 'Python',
  javascript: 'JavaScript',
  java: 'Java',
  c: 'C',
  sql: 'SQL',
}

const solutions = await getCollection('solutions')
type Item = {
  site: string
  tier: string
  rank: number
  title: string
  cls: string[]
  lang: string[]
  href: string
}
const all: Item[] = solutions
  .map((s) => ({
    site: s.data.site,
    tier: s.data.tier,
    rank: s.data.rank,
    title: s.data.title,
    cls: s.data.categories,
    lang: s.data.langs.map((l) => LANG[l] ?? l),
    href: `/algorithms/${s.id}/`,
  }))
  .sort((a, b) => b.rank - a.rank || a.title.localeCompare(b.title, 'ko'))

const boj = all.filter((i) => i.site === '백준')
const pgs = all.filter((i) => i.site === '프로그래머스')

/** 백준은 대분류(Bronze/Silver/Gold/Platinum)로 묶고, 프로그래머스는 레벨로 묶는다 */
const majorOf = (tier: string) => tier.split(' ')[0]

const BOJ_ORDER = ['Platinum', 'Gold', 'Silver', 'Bronze', 'Unrated']
const bojGroups = BOJ_ORDER.map((g) => ({
  name: g,
  items: boj.filter((i) => majorOf(i.tier) === g).sort((a, b) => b.rank - a.rank),
})).filter((g) => g.items.length > 0)

const PGS_ORDER = ['lv4', 'lv3', 'lv2', 'lv1', 'lv0']
const pgsGroups = PGS_ORDER.map((g) => ({
  name: g.replace('lv', 'Level '),
  items: pgs.filter((i) => i.tier === g),
})).filter((g) => g.items.length > 0)

const countBy = (key: (i: Item) => string[]) => {
  const m = new Map<string, number>()
  for (const i of all) for (const k of key(i)) m.set(k, (m.get(k) ?? 0) + 1)
  return [...m.entries()].sort((a, b) => b[1] - a[1])
}
const byCls = countBy((i) => i.cls).slice(0, 18)
const byLang = countBy((i) => i.lang)

/** 백준 Gold 이상. 프로그래머스(rank 100+)와 Unrated는 제외한다 */
const goldPlus = boj.filter((i) => i.rank >= 10 && i.rank < 100).length

/** 그룹당 한 쪽에 보여 주는 개수. 넘는 건 쪽 번호로 넘긴다. 필터 결과도 같은 단위로 나눈다. */
const PAGE = 10
const pagesOf = (n: number) => Math.max(1, Math.ceil(n / PAGE))
---

<BaseLayout
  title="알고리즘"
  description={`백준 ${boj.length}문제, 프로그래머스 ${pgs.length}문제. 티어·유형·언어별로 정리한 풀이 기록입니다.`}
>
  <div class="wrap-wide page">
    <header class="head">
      <h1>알고리즘</h1>
      <p class="lead">
        2021년 12월부터 2023년 10월까지 푼 문제를 모았습니다. Python으로 시작해 C++, JavaScript,
        Java, C, SQL로 언어를 바꿔가며 풀었습니다. 풀이 코드는 저장소에 있고, 각 문제에서 바로
        열립니다. 지금은 실무에서 만난 문제를 <a href="/posts/">글</a>과 <a href="/wiki/">위키</a>에
        남기는 쪽에 시간을 쓰고 있어, 이후 풀이는 올리지 않고 아카이브로 둡니다.
      </p>
    </header>

    <section class="stats">
      <div class="stat"><b>{all.length}</b><span>전체</span></div>
      <div class="stat"><b>{boj.length}</b><span>백준</span></div>
      <div class="stat"><b>{pgs.length}</b><span>프로그래머스</span></div>
      <div class="stat"><b>{goldPlus}</b><span>Gold 이상</span></div>
    </section>

    <div class="filter" role="search">
      <input
        id="q"
        type="search"
        placeholder="문제 이름으로 찾기"
        aria-label="문제 이름으로 찾기"
        autocomplete="off"
      />
      <span id="count" class="count" aria-live="polite"></span>
      <button type="button" id="clear" class="clear" hidden>필터 지우기</button>
    </div>

    <section class="facets">
      <div>
        <h2>많이 푼 유형 <span class="hint">— 누르면 거릅니다</span></h2>
        <div class="chips">
          {
            byCls.map(([k, v]) => (
              <button type="button" class="chip" data-cls={k} aria-pressed="false">
                {k} <em>{v}</em>
              </button>
            ))
          }
        </div>
      </div>
      <div>
        <h2>언어</h2>
        <div class="chips">
          {
            byLang.map(([k, v]) => (
              <button type="button" class="chip" data-lang={k} aria-pressed="false">
                {k} <em>{v}</em>
              </button>
            ))
          }
        </div>
      </div>
    </section>

    <p class="repo">
      문제 지문은 각 사이트의 저작물이라 싣지 않았습니다. 풀이 코드만 올렸고, 원문은 각 페이지의
      링크에서 볼 수 있습니다. 저장소는
      <a href="https://github.com/daedaem/algorithm-study-archive">algorithm-study-archive</a
      >입니다.
    </p>

    <h2 class="site-title">백준</h2>
    {
      bojGroups.map((g) => (
        <details
          class="group"
          open={g.name === 'Platinum' || g.name === 'Gold'}
          data-total={g.items.length}
        >
          <summary>
            {g.name} <em>{g.items.length}</em>
          </summary>
          <ul class="list">
            {g.items.map((i, idx) => (
              <li
                data-title={i.title.toLowerCase()}
                data-cls={i.cls.join('|')}
                data-lang={i.lang.join('|')}
                hidden={idx >= PAGE}
              >
                <span class="tier">{i.tier}</span>
                <a class="name" href={i.href}>
                  {i.title}
                </a>
                <span class="cls">{i.cls.slice(0, 3).join(' · ')}</span>
                <span class="lang">{i.lang.join(', ')}</span>
              </li>
            ))}
          </ul>
          <nav class="pager" aria-label="쪽 이동" hidden={g.items.length <= PAGE}>
            <button type="button" class="pg prev" disabled>
              ‹ 이전
            </button>
            <span class="pages">
              {Array.from({ length: pagesOf(g.items.length) }, (_, n) => (
                <button
                  type="button"
                  class="pg num"
                  data-page={n + 1}
                  aria-current={n === 0 ? 'page' : undefined}
                >
                  {n + 1}
                </button>
              ))}
            </span>
            <button type="button" class="pg next" disabled={pagesOf(g.items.length) <= 1}>
              다음 ›
            </button>
            <span class="range">
              1–{Math.min(PAGE, g.items.length)} / {g.items.length}
            </span>
          </nav>
        </details>
      ))
    }

    <h2 class="site-title">프로그래머스</h2>
    {
      pgsGroups.map((g) => (
        <details
          class="group"
          open={g.name === 'Level 4' || g.name === 'Level 3'}
          data-total={g.items.length}
        >
          <summary>
            {g.name} <em>{g.items.length}</em>
          </summary>
          <ul class="list">
            {g.items.map((i, idx) => (
              <li
                data-title={i.title.toLowerCase()}
                data-cls={i.cls.join('|')}
                data-lang={i.lang.join('|')}
                hidden={idx >= PAGE}
              >
                <span class="tier">{g.name.replace('Level ', 'Lv')}</span>
                <a class="name" href={i.href}>
                  {i.title}
                </a>
                <span class="cls">{i.cls.slice(0, 3).join(' · ')}</span>
                <span class="lang">{i.lang.join(', ')}</span>
              </li>
            ))}
          </ul>
          <nav class="pager" aria-label="쪽 이동" hidden={g.items.length <= PAGE}>
            <button type="button" class="pg prev" disabled>
              ‹ 이전
            </button>
            <span class="pages">
              {Array.from({ length: pagesOf(g.items.length) }, (_, n) => (
                <button
                  type="button"
                  class="pg num"
                  data-page={n + 1}
                  aria-current={n === 0 ? 'page' : undefined}
                >
                  {n + 1}
                </button>
              ))}
            </span>
            <button type="button" class="pg next" disabled={pagesOf(g.items.length) <= 1}>
              다음 ›
            </button>
            <span class="range">
              1–{Math.min(PAGE, g.items.length)} / {g.items.length}
            </span>
          </nav>
        </details>
      ))
    }

    <p class="empty" id="empty" hidden>조건에 맞는 문제가 없습니다.</p>
  </div>
  <script>
    // 정적 목록을 클라이언트에서 거른 뒤 그룹마다 30개씩 쪽으로 나눈다.
    // 검색어·유형·언어 세 조건은 AND이고, 조건이 바뀌면 모든 그룹을 1쪽으로 되돌린다.
    const PAGE = 10
    const q = document.getElementById('q') as HTMLInputElement
    const clearBtn = document.getElementById('clear') as HTMLButtonElement
    const count = document.getElementById('count')!
    const empty = document.getElementById('empty')!
    const chips = [...document.querySelectorAll<HTMLButtonElement>('.chip')]
    const groups = [...document.querySelectorAll<HTMLDetailsElement>('.group')]
    const page = new Map<HTMLDetailsElement, number>()

    let cls = ''
    let lang = ''

    function matches(li: HTMLLIElement, term: string) {
      return (
        (!term || (li.dataset.title ?? '').includes(term)) &&
        (!cls || (li.dataset.cls ?? '').split('|').includes(cls)) &&
        (!lang || (li.dataset.lang ?? '').split('|').includes(lang))
      )
    }

    function renderGroup(g: HTMLDetailsElement, active: boolean) {
      const term = q.value.trim().toLowerCase()
      const rows = [...g.querySelectorAll<HTMLLIElement>('.list li')]
      const hit = rows.filter((li) => matches(li, term))
      const pages = Math.max(1, Math.ceil(hit.length / PAGE))
      const cur = Math.min(page.get(g) ?? 1, pages)
      page.set(g, cur)
      const from = (cur - 1) * PAGE
      const to = Math.min(from + PAGE, hit.length)

      for (const li of rows) li.hidden = true
      for (const li of hit.slice(from, to)) li.hidden = false

      const total = Number(g.dataset.total)
      const em = g.querySelector('summary em')!
      em.textContent = active ? `${hit.length} / ${total}` : String(total)
      g.hidden = active && hit.length === 0
      if (active && hit.length > 0) g.open = true

      const nav = g.querySelector<HTMLElement>('.pager')!
      nav.hidden = hit.length <= PAGE
      ;(nav.querySelector('.prev') as HTMLButtonElement).disabled = cur <= 1
      ;(nav.querySelector('.next') as HTMLButtonElement).disabled = cur >= pages
      nav.querySelector('.range')!.textContent = `${from + 1}–${to} / ${hit.length}`
      // 쪽 번호 버튼은 서버에서 그려 둔 것을 그대로 쓴다. JS로 새로 만들면 Astro 스코프 스타일이 안 붙는다.
      for (const b of nav.querySelectorAll<HTMLButtonElement>('.num')) {
        const n = Number(b.dataset.page)
        b.hidden = n > pages
        if (n === cur) b.setAttribute('aria-current', 'page')
        else b.removeAttribute('aria-current')
      }
      return hit.length
    }

    function apply() {
      const active = !!(q.value.trim() || cls || lang)
      let shown = 0
      for (const g of groups) shown += renderGroup(g, active)

      // 사이트 소제목(백준/프로그래머스)은 아래 그룹이 전부 숨었을 때 같이 숨긴다
      for (const h of document.querySelectorAll<HTMLElement>('.site-title')) {
        let el = h.nextElementSibling
        let any = false
        while (el && !el.classList.contains('site-title')) {
          if (el.classList.contains('group') && !(el as HTMLElement).hidden) any = true
          el = el.nextElementSibling
        }
        h.hidden = !any
      }

      count.textContent = active ? `${shown}문제` : ''
      clearBtn.hidden = !active
      empty.hidden = !(active && shown === 0)
      for (const c of chips) {
        const on =
          (c.dataset.cls && c.dataset.cls === cls) || (c.dataset.lang && c.dataset.lang === lang)
        c.classList.toggle('on', !!on)
        c.setAttribute('aria-pressed', String(!!on))
      }
    }

    function resetPages() {
      page.clear()
      apply()
    }

    q.addEventListener('input', resetPages)
    for (const c of chips) {
      c.addEventListener('click', () => {
        if (c.dataset.cls !== undefined) cls = cls === c.dataset.cls ? '' : c.dataset.cls
        if (c.dataset.lang !== undefined) lang = lang === c.dataset.lang ? '' : c.dataset.lang
        resetPages()
      })
    }
    clearBtn.addEventListener('click', () => {
      q.value = ''
      cls = ''
      lang = ''
      resetPages()
      q.focus()
    })
    for (const g of groups) {
      g.querySelector('.pager')?.addEventListener('click', (e) => {
        const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.pg')
        if (!b || b.disabled) return
        const cur = page.get(g) ?? 1
        if (b.classList.contains('prev')) page.set(g, cur - 1)
        else if (b.classList.contains('next')) page.set(g, cur + 1)
        else page.set(g, Number(b.dataset.page))
        renderGroup(g, !!(q.value.trim() || cls || lang))
        // 그룹 머리가 화면 위로 벗어났을 때만 올린다. 보이는 상태에서 쪽만 넘길 때는 시점을 유지한다.
        const head = g.querySelector('summary')!
        if (head.getBoundingClientRect().top < 0) head.scrollIntoView({ block: 'start' })
      })
    }
  </script>
</BaseLayout>

<style>
  .page {
    padding-block: 3.5rem 5rem;
  }
  .head h1 {
    margin: 0;
    font-size: 30px;
    letter-spacing: -0.035em;
  }
  .lead {
    margin: 14px 0 0;
    max-width: 40rem;
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.8;
  }
  .lead a {
    color: var(--text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--border-strong);
  }
  .lead a:hover {
    text-decoration-color: var(--accent);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 32px 0 0;
  }
  .stat {
    background: var(--bg-subtle);
    border-radius: var(--radius);
    padding: 18px;
    text-align: center;
  }
  .stat b {
    display: block;
    font-size: 26px;
    letter-spacing: -0.03em;
  }
  .stat span {
    font-size: 13px;
    color: var(--text-muted);
  }

  .facets {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 28px;
    margin-top: 36px;
  }
  .facets h2 {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 0 0 10px;
  }
  .facets .hint {
    font-weight: 400;
    letter-spacing: 0;
    text-transform: none;
    color: var(--text-dim);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
  }
  .chip {
    font: inherit;
    font-size: 13px;
    background: var(--bg-subtle);
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 5px 12px;
    color: var(--text-muted);
    cursor: pointer;
  }
  .chip:hover {
    border-color: var(--border-strong);
    color: var(--text);
  }
  .chip:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .chip.on {
    background: var(--text);
    color: var(--bg);
  }
  .chip.on em {
    color: var(--bg);
  }
  .chips em {
    font-style: normal;
    color: var(--text);
    font-weight: 600;
  }

  .filter {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 28px;
  }
  .filter input {
    flex: 1 1 16rem;
    font: inherit;
    font-size: 15px;
    padding: 10px 14px;
    border: 1px solid var(--text-dim);
    border-radius: 8px;
    background: var(--bg);
    color: var(--text);
  }
  .filter input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .count {
    font-size: 13.5px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .clear {
    font: inherit;
    font-size: 13px;
    padding: 6px 12px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-subtle);
    color: var(--text-muted);
    cursor: pointer;
  }
  .clear:hover {
    color: var(--text);
    border-color: var(--accent);
  }

  .pager {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin: 0 0 12px;
    padding: 10px 0 0 1.2em;
    border-top: 1px solid var(--border);
    font-size: 13.5px;
  }
  .pages {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }
  .pg {
    font: inherit;
    font-size: 13.5px;
    min-width: 2em;
    padding: 4px 8px;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: var(--accent);
    cursor: pointer;
    font-variant-numeric: tabular-nums;
  }
  .pg:hover:not(:disabled) {
    background: var(--bg-subtle);
  }
  .pg:disabled {
    color: var(--text-dim);
    cursor: default;
  }
  .pg[aria-current='page'] {
    background: var(--text);
    color: var(--bg);
    font-weight: 600;
  }
  .pg:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
  .range {
    margin-left: auto;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .empty {
    margin-top: 32px;
    color: var(--text-muted);
  }

  .repo {
    margin-top: 28px;
    font-size: 14.5px;
    color: var(--text-muted);
  }
  .repo a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-title {
    margin: 44px 0 12px;
    font-size: 20px;
    letter-spacing: -0.03em;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .group {
    border-bottom: 1px solid var(--border);
  }
  .group summary {
    cursor: pointer;
    padding: 12px 0;
    font-size: 15px;
    font-weight: 600;
    list-style: none;
  }
  .group summary::-webkit-details-marker {
    display: none;
  }
  .group summary::before {
    content: '▸';
    display: inline-block;
    width: 1.2em;
    color: var(--text-dim);
    transition: transform 0.15s ease;
  }
  .group[open] summary::before {
    transform: rotate(90deg);
  }
  .group summary em {
    font-style: normal;
    font-weight: 400;
    font-size: 13px;
    color: var(--text-dim);
    margin-left: 4px;
  }

  .list {
    list-style: none;
    margin: 0 0 12px;
    padding: 0;
  }
  .list li {
    display: grid;
    grid-template-columns: 5.5rem 1fr auto auto;
    gap: 12px;
    align-items: baseline;
    padding: 7px 0 7px 1.2em;
    font-size: 14px;
    border-top: 1px solid var(--border);
  }
  .tier {
    font-size: 12px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
  .name {
    text-decoration: none;
  }
  .name:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }
  .cls,
  .lang {
    font-size: 12.5px;
    color: var(--text-dim);
    white-space: nowrap;
  }

  @media (max-width: 760px) {
    .page {
      padding-top: 1.5rem;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 20px;
    }
    .stat {
      padding: 12px;
    }
    .stat b {
      font-size: 22px;
    }
    .facets {
      grid-template-columns: 1fr;
    }
    .list li {
      grid-template-columns: 4.5rem 1fr;
    }
    .cls,
    .lang {
      grid-column: 2;
      white-space: normal;
    }
  }
</style>

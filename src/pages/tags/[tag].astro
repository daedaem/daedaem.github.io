---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import PageHead from '@/components/PageHead.astro'
import { getWikiTopic } from '@/consts'
import { tagSlug } from '@/utils/format'

type Item = {
  kind: 'post' | 'wiki'
  title: string
  description: string
  href: string
  date: Date
  sortDate: Date
  category?: string
  topic?: string
  /** 글의 사례 시점(frontmatter happened). 위키 행에는 없다 */
  happened?: string
}

export const getStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  const wiki = await getCollection('wiki', ({ data }) => !data.draft)
  const items: (Item & { tags: string[] })[] = [
    ...posts.map((p) => ({
      kind: 'post' as const,
      title: p.data.title,
      description: p.data.description,
      href: `/posts/${p.id}/`,
      date: p.data.date,
      sortDate: p.data.date,
      category: p.data.category,
      happened: p.data.happened,
      tags: p.data.tags ?? [],
    })),
    ...wiki.map((w) => ({
      kind: 'wiki' as const,
      title: w.data.title,
      description: w.data.description,
      href: `/wiki/${w.id}/`,
      date: w.data.created,
      // 화면에는 작성일만 보이므로 순서도 작성일을 따른다(수정일로 정렬하면 날짜가 뒤섞여 보인다)
      sortDate: w.data.created,
      topic: w.data.topic,
      tags: w.data.tags ?? [],
    })),
  ]
  const byTag = new Map<string, { tag: string; list: Item[] }>()
  for (const it of items)
    for (const t of it.tags) {
      const key = tagSlug(t)
      if (!key) continue
      if (!byTag.has(key)) byTag.set(key, { tag: t, list: [] })
      byTag.get(key)!.list.push(it)
    }
  // 1건짜리 태그는 페이지를 만들지 않는다. 본문 쪽도 같은 기준으로 링크를 걸지 않는다.
  return [...byTag.entries()]
    .filter(([, { list }]) => list.length >= 2)
    .map(([key, { tag, list }]) => ({
      params: { tag: key },
      props: {
        tag,
        // 글을 먼저, 위키를 나중에. 각 묶음 안에서는 최신순.
        list: [...list].sort(
          (a, b) =>
            (a.kind === 'wiki' ? 1 : 0) - (b.kind === 'wiki' ? 1 : 0) ||
            b.sortDate.valueOf() - a.sortDate.valueOf(),
        ),
      },
    }))
}

const { tag, list } = Astro.props
---

<BaseLayout
  title={`#${tag}`}
  description={`#${tag} 태그가 달린 글과 위키 문서 ${list.length}건.`}
  searchIndex={false}
>
  <div class="page">
    <PageHead title={`#${tag}`} label={`${list.length}건`}>
      <p class="lede">이 태그가 달린 글과 위키 문서입니다.</p>
    </PageHead>
    <ol class="rows">
      {
        list.map((it) => {
          const topic = it.topic ? getWikiTopic(it.topic) : undefined
          return it.kind === 'wiki' ? (
            <PostRow
              href={it.href}
              title={it.title}
              description={it.description}
              date={it.date}
              prefix="위키"
              label={topic?.name}
              hue={topic?.hue}
            />
          ) : (
            <PostRow
              href={it.href}
              title={it.title}
              description={it.description}
              date={it.date}
              happened={it.happened}
              prefix="글"
              category={it.category}
            />
          )
        })
      }
    </ol>
  </div>
</BaseLayout>

---
import { getCollection, render } from 'astro:content'
import PostLayout from '@/layouts/PostLayout.astro'
import { readingMinutes } from '@/utils/format'

export const getStaticPaths = async () => {
  const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  )
  // 최신순 배열이므로 i+1이 더 오래된 글(이전), i-1이 더 새 글(다음)이다
  return posts.map((post, i) => {
    const link = (p?: (typeof posts)[number]) =>
      p ? { href: `/posts/${p.id}/`, title: p.data.title } : undefined
    // 글 안에서 다른 글로 갈 수 있도록 나머지 전부를 넘긴다. 편수가 적어 전부 보여도 짧다.
    const others = posts
      .filter((p) => p.id !== post.id)
      .map((p) => ({
        href: `/posts/${p.id}/`,
        title: p.data.title,
        category: p.data.category,
        date: p.data.date,
        happened: p.data.happened,
      }))
    return {
      params: { slug: post.id },
      props: { post, prev: link(posts[i + 1]), next: link(posts[i - 1]), others },
    }
  })
}

const { post, prev, next, others } = Astro.props
const { Content, headings } = await render(post)
---

<PostLayout
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  updated={post.data.updated}
  happened={post.data.happened}
  category={post.data.category}
  tags={post.data.tags}
  readingMinutes={readingMinutes(post.body ?? '')}
  ogSlug={`posts/${post.id}`}
  headings={headings}
  prev={prev}
  next={next}
  others={others}
  cause={post.data.cause}
>
  <Content />
</PostLayout>

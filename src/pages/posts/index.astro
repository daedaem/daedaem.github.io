---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import CategoryNav from '@/components/CategoryNav.astro'
import PageHead from '@/components/PageHead.astro'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const counts = new Map<string, number>()
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)
---

<BaseLayout
  title="글"
  description="레거시 시스템 개발·운영 과정에서 데이터 정합성, 조회 성능, 시스템 연동을 개선한 기록. 원인과 선택의 근거를 씁니다."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="글" label={`${posts.length}편`}>
      <p class="lede">실제로 맡아 고친 문제를 남깁니다.</p>
      <details class="criteria">
        <summary>기록·날짜 안내</summary>
        <p>
          무엇이 원인이었는지, 왜 그 방법을 골랐는지, 고르지 않은 선택지는 무엇이었는지까지 씁니다.
          각 글 상단의 '사례 시점'이 실제로 겪은 때이고, 목록의 작성일은 그 일을 블로그에 글로
          정리한 날입니다.
        </p>
      </details>
      <CategoryNav counts={counts} total={posts.length} />
    </PageHead>

    {
      posts.length === 0 ? (
        <p class="empty">아직 발행한 글이 없습니다.</p>
      ) : (
        <ol class="rows">
          {posts.map((p) => (
            <PostRow
              href={`/posts/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              category={p.data.category}
            />
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<style>
  .empty {
    margin: 1rem 0 0;
    color: var(--fg2);
  }
  /* 기록·날짜 안내는 접어 둔다. 요약 한 줄은 머리에 남고 자세한 설명은 열어서 읽는다 */
  .criteria {
    margin-top: 0.25rem;
    max-width: 36rem;
    color: var(--fg2);
  }
  .criteria summary {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
    cursor: pointer;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--fg2);
  }
  .criteria p {
    margin: 0 0 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.7;
  }
</style>

---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import CategoryNav from '@/components/CategoryNav.astro'
import PageHead from '@/components/PageHead.astro'
import Icon from '@/components/Icon.astro'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const counts = new Map<string, number>()
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)
---

<BaseLayout
  title="글"
  description="레거시 시스템 개발·운영 과정에서 데이터 정합성, 조회 성능, 시스템 연동을 개선한 기록. 원인과 선택의 근거를 씁니다."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="글" label={`${posts.length}편`}>
      <p class="lede">실제로 맡아 고친 문제를 남깁니다.</p>
      <details class="criteria">
        <summary>
          <span>기록·날짜 안내</span>
          <Icon name="chevron-down" />
        </summary>
        <p>
          무엇이 원인이었는지, 왜 그 방법을 골랐는지, 고르지 않은 선택지는 무엇이었는지까지 씁니다.
          각 글 상단의 '사례 시점'이 실제로 겪은 때이고, 목록의 작성일은 그 일을 블로그에 글로
          정리한 날입니다.
        </p>
      </details>
      <CategoryNav counts={counts} total={posts.length} />
    </PageHead>

    {
      posts.length === 0 ? (
        <p class="empty">아직 발행한 글이 없습니다.</p>
      ) : (
        <ol class="nlist long">
          {posts.map((p, i) => (
            <PostRow
              n={i + 1}
              dateLabel="작성"
              href={`/posts/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              happened={p.data.happened}
              category={p.data.category}
            />
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<style>
  .empty {
    margin: 1rem 0 0;
    color: var(--fg2);
  }
  /* 기록·날짜 안내는 접어 둔다. 글의 차례(details.toc)와 같은 둥근 상자 */
  .criteria {
    margin-top: 14px;
    max-width: 36rem;
    border: 1px solid var(--line);
    border-radius: var(--r-card);
    background: var(--card);
    color: var(--fg2);
  }
  .criteria summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--control-size);
    padding: 0 14px 0 16px;
    border-radius: var(--r-card);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--fg);
    list-style: none;
    cursor: pointer;
  }
  .criteria summary::-webkit-details-marker {
    display: none;
  }
  .criteria summary :global(svg) {
    flex-shrink: 0;
    color: var(--muted);
    transition: transform 0.15s;
  }
  .criteria[open] summary :global(svg) {
    transform: rotate(180deg);
  }
  .criteria p {
    margin: 0;
    padding: 10px 16px 14px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.7;
  }
</style>

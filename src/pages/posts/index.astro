---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import CategoryNav from '@/components/CategoryNav.astro'
import { readingMinutes } from '@/utils/format'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const counts = new Map<string, number>()
for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)
---

<BaseLayout
  title="글"
  description="레거시 환경에서 성능·정합성·인증 구조를 실제로 바꿔 온 기록. 증상이 아니라 원인을 씁니다."
>
  <div class="wrap-list">
    <header class="head">
      <h1>글</h1>
      <p>
        실제로 맡아 고친 문제를 남깁니다. 무엇이 원인이었는지, 왜 그 방법을 골랐는지, 고르지 않은
        선택지는 무엇이었는지까지 씁니다.
      </p>
    </header>

    <CategoryNav counts={counts} total={posts.length} />

    {
      posts.length === 0 ? (
        <p class="empty muted">아직 발행한 글이 없습니다.</p>
      ) : (
        <ul class="rows">
          {posts.map((p) => (
            <PostRow
              href={`/posts/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              category={p.data.category}
              readingMinutes={readingMinutes(p.body ?? '')}
            />
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .head {
    padding: 48px 0 28px;
  }
  .head h1 {
    margin: 0;
    font-size: 28px;
    letter-spacing: -0.035em;
  }
  .head p {
    margin: 12px 0 0;
    max-width: 37rem;
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.8;
  }
  .rows {
    list-style: none;
    margin: 28px 0 72px;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }
  .empty {
    padding: 40px 0 72px;
  }
  @media (max-width: 640px) {
    .head {
      padding: 24px 0 20px;
    }
  }
</style>

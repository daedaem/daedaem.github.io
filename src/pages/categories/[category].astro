---
import type { GetStaticPaths } from 'astro'
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostCard from '@/components/PostCard.astro'
import CategoryNav from '@/components/CategoryNav.astro'
import { CATEGORIES } from '@/consts'
import { readingMinutes } from '@/utils/format'

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  const counts = new Map<string, number>()
  for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)

  return CATEGORIES.map(category => ({
    params: { category: category.id },
    props: {
      category,
      counts,
      total: posts.length,
      posts: posts
        .filter(p => p.data.category === category.id)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }))
}

const { category, posts, counts, total } = Astro.props
---

<BaseLayout title={category.name} description={category.description}>
  <div class="wrap-wide">
    <header class="head">
      <h1>{category.name}</h1>
      <p>{category.description}</p>
    </header>

    <CategoryNav counts={counts} total={total} active={category.id} />

    {
      posts.length === 0 ? (
        <p class="empty muted">아직 이 주제로 발행한 글이 없습니다.</p>
      ) : (
        <div class="grid">
          {posts.map(p => (
            <PostCard
              href={`/posts/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              readingMinutes={readingMinutes(p.body ?? '')}
            />
          ))}
        </div>
      )
    }
  </div>
</BaseLayout>

<style>
  .head {
    padding: 56px 0 32px;
  }
  .head h1 {
    margin: 0;
    font-size: 30px;
    letter-spacing: -0.035em;
  }
  .head p {
    margin: 14px 0 0;
    max-width: 37rem;
    color: var(--text-muted);
    font-size: 15.5px;
    line-height: 1.8;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
    margin: 32px 0 72px;
  }
  .empty {
    padding: 40px 0 72px;
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>

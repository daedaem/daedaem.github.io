---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import CategoryNav from '@/components/CategoryNav.astro'
import PageHead from '@/components/PageHead.astro'
import { CATEGORIES } from '@/consts'

export const getStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  const counts = new Map<string, number>()
  for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)

  // 글이 없는 분류는 페이지를 만들지 않는다. 빈 페이지가 사이트맵에 올라가 아직 없는 주제를
  // 약속하지 않게 하고, 글이 생기면 다음 빌드에서 자동으로 다시 생긴다.
  return CATEGORIES.filter((category) => (counts.get(category.id) ?? 0) > 0).map((category) => ({
    params: { category: category.id },
    props: {
      category,
      counts,
      total: posts.length,
      posts: posts
        .filter((p) => p.data.category === category.id)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }))
}

const { category, posts, counts, total } = Astro.props
---

<BaseLayout title={category.name} description={category.description} searchIndex={false}>
  <div class="page">
    <PageHead title={category.name} label={`${posts.length}편`}>
      <p class="lede">{category.description}</p>
      <CategoryNav counts={counts} total={total} active={category.id} />
    </PageHead>

    {
      posts.length === 0 ? (
        <p class="empty">아직 이 주제로 발행한 글이 없습니다.</p>
      ) : (
        <ol class="nlist long">
          {posts.map((p, i) => (
            <PostRow
              n={i + 1}
              dateLabel="작성"
              href={`/posts/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              happened={p.data.happened}
              category={p.data.category}
            />
          ))}
        </ol>
      )
    }
  </div>
</BaseLayout>

<style>
  .empty {
    margin: 1rem 0 0;
    color: var(--fg2);
  }
</style>

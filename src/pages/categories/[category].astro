---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import CategoryNav from '@/components/CategoryNav.astro'
import PageHead from '@/components/PageHead.astro'
import { CATEGORIES } from '@/consts'
import { readingMinutes } from '@/utils/format'

export const getStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft)
  const counts = new Map<string, number>()
  for (const p of posts) counts.set(p.data.category, (counts.get(p.data.category) ?? 0) + 1)

  return CATEGORIES.map((category) => ({
    params: { category: category.id },
    props: {
      category,
      counts,
      total: posts.length,
      posts: posts
        .filter((p) => p.data.category === category.id)
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
    },
  }))
}

const { category, posts, counts, total } = Astro.props
---

<BaseLayout title={category.name} description={category.description} searchIndex={false}>
  <div class="wrap-list">
    <PageHead title={category.name} category={category.id}>
      <p>{category.description}</p>
    </PageHead>

    <CategoryNav counts={counts} total={total} active={category.id} />

    {
      posts.length === 0 ? (
        <p class="empty muted">아직 이 주제로 발행한 글이 없습니다.</p>
      ) : (
        <ul class="rows">
          {posts.map((p) => (
            <PostRow
              href={`/posts/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              date={p.data.date}
              readingMinutes={readingMinutes(p.body ?? '')}
            />
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .rows {
    list-style: none;
    margin: 28px 0 72px;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }
  .empty {
    padding: 40px 0 72px;
  }
</style>

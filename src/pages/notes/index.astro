---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import LearningNav from '@/components/LearningNav.astro'
import PostRow from '@/components/PostRow.astro'
import { orderedNoteGroups, noteListTitle } from '@/utils/note-series.mjs'
const notes = await getCollection('notes')
const sections = orderedNoteGroups(notes)
---

<BaseLayout
  title="학습 노트 아카이브"
  description="개발자로 전환하던 2022~2023년에 자바스크립트·타입스크립트·웹 기초를 정리한 학습 노트와 그 시기의 기록입니다."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="학습 노트 아카이브" label={`${notes.length}편`}>
      <p class="lede">
        2022–2023년에 작성한 학습 노트 {notes.length}편입니다. 시리즈별로 남긴 장을 순서대로 읽을 수
        있습니다.
      </p>
    </PageHead>
    <LearningNav />

    {
      sections.map((s) => (
        <section class="series blk" id={s.id} data-series={s.id}>
          <div class="sec-h">
            <h2 class="k">
              {s.title}
              <span class="n">{s.chapters.length}편</span>
            </h2>
          </div>
          <ol class="rows">
            {s.chapters.map(({ chapter, note: n }) => (
              <PostRow
                href={`/notes/${n.id}/`}
                title={noteListTitle(n.data.title, chapter)}
                date={n.data.date}
                prefix="아카이브"
                description={n.data.summary || undefined}
              />
            ))}
          </ol>
        </section>
      ))
    }
  </div>
</BaseLayout>

<style>
  .series {
    scroll-margin-top: 120px;
  }
  .series .rows {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
</style>

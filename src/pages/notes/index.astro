---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import { formatDate } from '@/utils/format'

const notes = (await getCollection('notes')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
)

/**
 * 시리즈. 슬러그 접두사(prefix) 또는 슬러그 목록(ids)으로 묶는다.
 * 순서가 곧 학습한 순서이고, 시리즈 밖의 글은 성격별로 따로 둔다.
 */
type Series = { title: string; note: string; prefix?: string; ids?: string[] }
const SERIES: Series[] = [
  {
    prefix: 'javascript-',
    title: '자바스크립트 기초',
    note: '문법과 데이터 타입을 처음 정리하던 시기의 노트.',
  },
  {
    prefix: 'core-javascript-',
    title: '코어 자바스크립트',
    note: '실행 컨텍스트·this·클로저·프로토타입을 장별로 정리한 완독 기록.',
  },
  {
    prefix: 'modern-js-deep-dive-',
    title: '모던 자바스크립트 Deep Dive',
    note: '언어의 동작 원리를 다시 근본부터 짚은 노트.',
  },
  {
    prefix: 'typescript-',
    title: '타입스크립트',
    note: '타입 시스템과 컴파일러 구성, 고급 타입까지의 학습 기록.',
  },
  {
    ids: ['semantic-html', 'atomic-design', 'blockchain'],
    title: '웹과 도메인 지식',
    note: '웹 표준, 컴포넌트 설계 방법론, 블록체인처럼 언어 밖의 것을 정리한 노트.',
  },
  {
    ids: ['first-post', 'scsa'],
    title: '전환기의 기록',
    note: '개발자로 방향을 바꾸던 시기의 개인적인 글. 기술 노트는 아니지만 그때의 기록이다.',
  },
]

const grouped = SERIES.map(s => ({
  ...s,
  items: notes.filter(n => (s.prefix ? n.id.startsWith(s.prefix) : s.ids!.includes(n.id))),
}))

const used = new Set(grouped.flatMap(g => g.items.map(i => i.id)))
const others = notes.filter(n => !used.has(n.id))
---

<BaseLayout
  title="학습 노트 아카이브"
  description="개발자로 전환하던 2022~2023년에 자바스크립트·타입스크립트·웹 기초를 정리한 학습 노트와 그 시기의 기록입니다."
>
  <div class="wrap-list page">
    <header class="head">
      <h1>학습 노트 아카이브</h1>
      <p class="lead">
        비전공자로 개발을 시작해 자바스크립트와 타입스크립트의 기초를 다지던 2022~2023년의 노트
        {notes.length}편입니다. 지금 쓰는 글과는 성격이 다르지만, 무엇을 어떤 순서로 익혔는지도
        기록이라고 생각해 남겨 둡니다. 오탈자만 고쳤고, 지금 보기에 틀린 내용은 지우지 않고
        취소선을 그은 뒤 바로 아래에 바로잡았습니다.
      </p>
    </header>

    {
      grouped.map(
        g =>
          g.items.length > 0 && (
            <section class="series">
              <div class="series-head">
                <h2>
                  {g.title} <em>{g.items.length}편</em>
                </h2>
                <p class="muted">{g.note}</p>
              </div>
              <ol>
                {g.items.map(n => (
                  <li>
                    <a href={`/notes/${n.id}/`}>{n.data.title.trim()}</a>
                    <span class="dates">
                      <time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
                      {n.data.updated && n.data.updated.getTime() !== n.data.date.getTime() && (
                        <em>· {formatDate(n.data.updated)} 수정</em>
                      )}
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          ),
      )
    }

    {
      others.length > 0 && (
        <section class="series">
          <div class="series-head">
            <h2>
              그 밖의 글 <em>{others.length}편</em>
            </h2>
            <p class="muted">어느 시리즈에도 속하지 않는 글.</p>
          </div>
          <ol>
            {others.map(n => (
              <li>
                <a href={`/notes/${n.id}/`}>{n.data.title.trim()}</a>
                <span class="dates">
                  <time datetime={n.data.date.toISOString()}>{formatDate(n.data.date)}</time>
                  {n.data.updated && n.data.updated.getTime() !== n.data.date.getTime() && (
                    <em>· {formatDate(n.data.updated)} 수정</em>
                  )}
                </span>
              </li>
            ))}
          </ol>
        </section>
      )
    }
  </div>
</BaseLayout>

<style>
  .page {
    padding-block: 3.5rem 0;
  }

  .head {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin: 0;
    font-size: 1.875rem;
    letter-spacing: -0.025em;
  }

  .lead {
    margin: 1rem 0 0;
    max-width: 44rem;
    color: var(--text-muted);
    font-size: 0.9375rem;
  }

  .series {
    margin-top: 2.75rem;
  }

  .series-head h2 {
    margin: 0;
    font-size: 1.0625rem;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  .series-head h2 em {
    font-style: normal;
    font-weight: 500;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .series-head p {
    margin: 0.3rem 0 0;
    font-size: 0.875rem;
  }

  ol {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    border-top: 1px solid var(--border);
  }

  li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.25rem 1rem;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--border);
  }

  li a {
    text-decoration: none;
    font-size: 0.9375rem;
  }

  li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
  }

  .dates {
    display: flex;
    gap: 0.3rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
    white-space: nowrap;
  }

  .dates em {
    font-style: normal;
  }
  @media (max-width: 640px) {
    .page {
      padding-top: 1.5rem;
    }
    .head {
      padding-bottom: 1.25rem;
    }
  }
</style>

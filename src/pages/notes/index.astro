---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PageHead from '@/components/PageHead.astro'
import LearningNav from '@/components/LearningNav.astro'
import PostRow from '@/components/PostRow.astro'
import { orderNoteSeries } from '@/utils/note-series.mjs'

const notes = (await getCollection('notes')).sort(
  (a, b) => a.data.date.valueOf() - b.data.date.valueOf(),
)

/**
 * 시리즈. 슬러그 접두사(prefix) 또는 슬러그 목록(ids)으로 묶는다.
 * 장 번호가 있는 시리즈는 읽는 순서로, 나머지 기록은 작성 시간순으로 둔다.
 */
type Series = {
  id: string
  title: string
  note: string
  prefix?: string
  ids?: string[]
  chapterOrder?: boolean
}
const SERIES: Series[] = [
  {
    id: 'js',
    prefix: 'javascript-',
    title: '자바스크립트 기초',
    note: '문법과 데이터 타입을 처음 정리하던 시기의 노트.',
  },
  {
    id: 'core-js',
    prefix: 'core-javascript-',
    chapterOrder: true,
    title: '코어 자바스크립트',
    note: '실행 컨텍스트·this·클로저·프로토타입을 장별로 정리한 완독 기록.',
  },
  {
    id: 'deep-dive',
    prefix: 'modern-js-deep-dive-',
    chapterOrder: true,
    title: '모던 자바스크립트 Deep Dive',
    note: '언어의 동작 원리를 다시 근본부터 짚은 노트.',
  },
  {
    id: 'ts',
    prefix: 'typescript-',
    chapterOrder: true,
    title: '타입스크립트',
    note: '타입 시스템과 컴파일러 구성, 고급 타입까지의 학습 기록.',
  },
  {
    id: 'web',
    ids: ['semantic-html', 'atomic-design', 'blockchain'],
    title: '웹과 도메인 지식',
    note: '웹 표준, 컴포넌트 설계 방법론, 블록체인처럼 언어 밖의 것을 정리한 노트.',
  },
  {
    id: 'transition',
    ids: ['first-post', 'scsa'],
    title: '전환기의 기록',
    note: '개발자로 방향을 바꾸던 시기의 개인적인 글. 기술 노트는 아니지만 그때의 기록이다.',
  },
]

const grouped = SERIES.map((s) => ({
  ...s,
  items: orderNoteSeries(
    notes.filter((n) => (s.prefix ? n.id.startsWith(s.prefix) : s.ids!.includes(n.id))),
    s,
  ),
}))

const used = new Set(grouped.flatMap((g) => g.items.map((i) => i.id)))
const others = notes.filter((n) => !used.has(n.id))

/** 시리즈 칩. 비어 있는 시리즈는 빼고, 시리즈 밖의 글이 있으면 마지막에 붙인다 */
const sections = [
  ...grouped.filter((g) => g.items.length > 0),
  ...(others.length > 0
    ? [
        {
          id: 'others',
          title: '그 밖의 글',
          note: '어느 시리즈에도 속하지 않는 글.',
          items: others,
        },
      ]
    : []),
]
---

<BaseLayout
  title="학습 노트 아카이브"
  description="개발자로 전환하던 2022~2023년에 자바스크립트·타입스크립트·웹 기초를 정리한 학습 노트와 그 시기의 기록입니다."
  searchIndex={false}
>
  <div class="page">
    <PageHead title="학습 노트 아카이브" label={`${notes.length}편`}>
      <p class="lede">
        비전공자로 개발을 시작해 자바스크립트와 타입스크립트의 기초를 다지던 2022~2023년의 노트
        {notes.length}편입니다. 지금 쓰는 글과는 성격이 다르지만, 무엇을 어떤 순서로 익혔는지도
        기록이라고 생각해 남겨 둡니다. 오탈자를 고치고 짧은 보충을 덧붙였으며, 지금 보기에 틀린
        내용은 지우지 않고 취소선을 그은 뒤 바로 아래에 바로잡았습니다.
      </p>
    </PageHead>
    <LearningNav />

    <nav class="chips series-nav" aria-label="시리즈 선택">
      <a href="#" class="tab chip" data-series="" aria-current="true"
        >전체 <span class="n">{notes.length}</span></a
      >
      {
        sections.map((s) => (
          <a href={`#${s.id}`} class="tab chip" data-series={s.id}>
            {s.title} <span class="n">{s.items.length}</span>
          </a>
        ))
      }
    </nav>

    {
      sections.map((s) => (
        <section class="series blk" id={s.id} data-series={s.id}>
          <div class="sec-h">
            <h2 class="k">
              {s.title}
              <span class="n">{s.items.length}편</span>
            </h2>
          </div>
          <p class="blurb note">{s.note}</p>
          <ol class="rows">
            {s.items.map((n) => (
              <PostRow
                href={`/notes/${n.id}/`}
                title={n.data.title.trim()}
                date={n.data.date}
                prefix="아카이브"
                description={n.data.summary || undefined}
              />
            ))}
          </ol>
        </section>
      ))
    }
  </div>

  <script>
    // 칩은 앵커 링크라 JS 없이도 해당 시리즈로 건너뛴다. JS가 있으면 고른 시리즈만 남기고 주소 해시에 기억한다.
    const tabs = [...document.querySelectorAll<HTMLAnchorElement>('.tab')]
    const sections = [...document.querySelectorAll<HTMLElement>('.series')]
    const ids = new Set(sections.map((s) => s.dataset.series))

    function select(id: string) {
      for (const s of sections) s.hidden = !!id && s.dataset.series !== id
      for (const t of tabs) {
        const on = (t.dataset.series ?? '') === id
        if (on) t.setAttribute('aria-current', 'true')
        else t.removeAttribute('aria-current')
      }
    }
    function fromHash() {
      const id = location.hash.slice(1)
      select(ids.has(id) ? id : '')
    }
    for (const t of tabs) {
      t.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return
        e.preventDefault()
        const id = t.dataset.series ?? ''
        history.replaceState(null, '', id ? `#${id}` : location.pathname)
        select(id)
        window.scrollTo({ top: 0 })
      })
    }
    window.addEventListener('hashchange', fromHash)
    fromHash()
  </script>
</BaseLayout>

<style>
  .series-nav {
    margin-top: 1rem;
  }
  .note {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--fg2);
  }
  .note + .rows {
    margin-top: 0.5rem;
    border-top: 1px solid var(--line);
  }
</style>

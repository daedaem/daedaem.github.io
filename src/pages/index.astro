---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import Mark from '@/components/Mark.astro'
import CaseDiagram from '@/components/CaseDiagram.astro'
import { SITE, getCategory } from '@/consts'
import { PROJECTS } from '@/data/projects'
import { readingMinutes, formatDate } from '@/utils/format'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const notes = await getCollection('notes')
const wiki = await getCollection('wiki', ({ data }) => !data.draft)

// 히어로는 featured로 고정한 글이 있으면 그것, 없으면 최신 글. 나머지는 발행일순 그대로.
const featured = posts.find((p) => p.data.featured) ?? posts[0]
const rest = posts.filter((p) => p !== featured)
const featuredCat = featured ? getCategory(featured.data.category) : undefined
const featuredProjects = PROJECTS.filter((p) => p.featured)
const algoCount = (await getCollection('solutions')).length
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="wrap-wide home">
    <section class="intro">
      <p class="who">조해성 · 백엔드 개발자</p>
      <h1>{SITE.tagline}</h1>
      <p>
        화면부터 DB 내부까지 전 계층을 직접 들여다봅니다. 느린 조회, 어긋난 데이터, 레거시 코드 등
        일하면서 만난 문제를 어디까지 파고 무엇을 바꿨는지 기록합니다.
      </p>
      {/* 결과를 한 줄씩. 대표 사례 카드가 주소 건을 다루므로 여기서는 뺀다 */}
      <ul class="proofs">
        <li>
          <a href="/posts/null-and-empty-string-sync-failure/"
            >5년 넘게 남아 있던 시스템 간 동기화 오류의 원인 두 가지를 규명</a
          >
        </li>
        <li>
          <a href="/posts/retire-flash-module-by-integration/"
            >지원이 끝난 Flash 계약 모듈을 다시 만들지 않고 기존 시스템 연동으로 대체</a
          >
        </li>
        <li>
          <a href="/posts/staged-auth-and-password-migration/"
            >로그인 인증을 단계로 재설계하고 비밀번호 저장 방식을 이행</a
          >
        </li>
      </ul>
      <div class="entry-paths" aria-label="방문 목적에 맞게 읽기">
        <a class="primary-path" href="/posts/"
          >문제 해결 사례 읽기 <span aria-hidden="true">↗</span></a
        >
        <a href="/about/">소개·경력 보기 <span aria-hidden="true">→</span></a>
      </div>
      <p class="stack-line">
        Java · Spring · Oracle · MyBatis · C#/.NET · React
        <span class="links"
          ><a href="/wiki/">학습 위키</a>
          <a href={SITE.githubUrl}>GitHub</a>
          <a href={SITE.linkedinUrl}>LinkedIn</a></span
        >
      </p>
    </section>

    {
      featuredProjects.length > 0 && (
        <section class="projects">
          <div class="sec-head">
            <h2>프로젝트</h2>
            <a href="/projects/">전체 보기 →</a>
          </div>
          <ul>
            {featuredProjects.map((p) => (
              <li>
                <a href="/projects/">
                  <span class="pname">{p.name}</span>
                  <span class="ptag">{p.tagline}</span>
                  <span class="pstack">{p.stack.slice(0, 4).join(' · ')}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      posts.length === 0 ? (
        <p class="empty muted">아직 발행한 글이 없습니다.</p>
      ) : (
        <section class="latest">
          <a
            class:list={['hero', { 'has-diagram': featured.id === 'address-search-9s-to-100ms' }]}
            href={`/posts/${featured.id}/`}
          >
            <div class="hero-copy">
              {featuredCat && (
                <span class="hero-cat" data-cat={featuredCat.id}>
                  {featuredCat.name}
                </span>
              )}
              <h2>{featured.data.title}</h2>
              {featured.data.cause ? (
                <p class="hero-cause">
                  <span class="cause-label">
                    <Mark size={14} />
                    원인 한 줄
                  </span>
                  {featured.data.cause}
                </p>
              ) : (
                featured.data.description && <p>{featured.data.description}</p>
              )}
              <span class="hero-meta">
                <time datetime={featured.data.date.toISOString()}>
                  {formatDate(featured.data.date)}
                </time>
                <span>· {readingMinutes(featured.body ?? '')}분</span>
              </span>
              <span class="read-case">
                판단 과정 읽기 <span aria-hidden="true">→</span>
              </span>
            </div>
            {featured.id === 'address-search-9s-to-100ms' && <CaseDiagram />}
          </a>

          {rest.length > 0 && (
            <>
              <div class="sec-head">
                <h2>최근 사례</h2>
                <a href="/posts/">전체 보기 →</a>
              </div>
              <ul class="rows">
                {rest.slice(0, 8).map((p) => (
                  <PostRow
                    href={`/posts/${p.id}/`}
                    title={p.data.title}
                    date={p.data.date}
                    category={p.data.category}
                    readingMinutes={readingMinutes(p.body ?? '')}
                  />
                ))}
              </ul>
            </>
          )}
        </section>
      )
    }

    <div class="strips">
      <a class="strip" href="/wiki/">
        <div class="strip-num"><b>{wiki.length}</b>개 문서</div>
        <div class="strip-title">위키</div>
        <p>일하다 막힌 것을 그때그때 정리해 쌓는 곳. 완성되지 않은 항목도 그대로 둡니다.</p>
      </a>
      <a class="strip" href="/algorithms/">
        <div class="strip-num"><b>{algoCount}</b>문제</div>
        <div class="strip-title">알고리즘</div>
        <p>백준·프로그래머스 풀이 기록. 티어와 유형, 사용한 언어별로 정리했습니다.</p>
      </a>
      <a class="strip" href="/notes/">
        <div class="strip-num"><b>{notes.length}</b>편</div>
        <div class="strip-title">학습 노트 아카이브</div>
        <p>
          개발자로 전환하던 2022~2023년의 기록. 자바스크립트·타입스크립트 학습 노트와 그 시기의
          이야기.
        </p>
      </a>
    </div>
  </div>
</BaseLayout>

<style>
  .hero-copy {
    min-width: 0;
  }
  .read-case {
    display: inline-block;
    margin-top: 1rem;
    color: var(--accent);
    font-size: 0.875rem;
    font-weight: 600;
  }
  .proofs {
    list-style: none;
    margin: 20px 0 0;
    padding: 0;
    max-width: 40rem;
  }
  .proofs li {
    padding: 8px 0;
    border-top: 1px solid var(--border);
    font-size: 14.5px;
    line-height: 1.6;
  }
  .proofs li:first-child {
    border-top: 0;
    padding-top: 0;
  }
  .proofs a {
    color: var(--text);
  }
  .proofs a:hover {
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }
  .entry-paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .entry-paths a {
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 0.7rem 1rem;
    min-height: 44px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 600;
    background: var(--bg);
  }
  .entry-paths .primary-path {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .who {
    margin: 0 0 10px;
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--accent);
  }
  .stance {
    margin: 18px 0 0;
    max-width: 40rem;
    font-size: 14.5px;
    color: var(--text-muted);
  }
  .stack-line {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
    margin: 20px 0 0;
    font-size: 13px;
    color: var(--text-dim);
  }
  .stack-line .links {
    display: inline-flex;
    gap: 14px;
    margin-left: auto;
  }
  .stack-line .links a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: var(--text-muted);
  }
  .stack-line .links a:hover {
    color: var(--text);
    text-decoration-color: var(--accent);
  }
  /* 정체성 블록. 오른쪽 위에서 번지는 옅은 색조와 점 격자로 첫 화면에 질감을 준다. */
  .intro {
    position: relative;
    padding: 32px 0 28px;
    border-bottom: 1px solid var(--border);
  }
  .intro::before {
    content: '';
    position: absolute;
    inset: 0 -24px;
    z-index: -1;
    background:
      radial-gradient(
        60rem 22rem at 100% 0%,
        color-mix(in srgb, var(--accent) 9%, transparent),
        transparent 70%
      ),
      radial-gradient(circle, var(--border-strong) 1px, transparent 1.2px) 0 0 / 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent);
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
    pointer-events: none;
  }

  .intro h1 {
    margin: 0;
    font-size: clamp(22px, 3.2vw, 26px);
    line-height: 1.45;
    letter-spacing: -0.035em;
    max-width: 38rem;
  }

  .intro p {
    margin: 12px 0 0;
    font-size: 15.5px;
    line-height: 1.8;
    color: var(--text-muted);
    max-width: 37rem;
  }
  .intro .stack-line {
    max-width: none;
    font-size: 0.875rem;
  }

  .empty {
    padding: 40px 0;
  }

  /* 최신 글 히어로 */
  .hero {
    display: block;
    padding: 28px;
    margin-block: 28px 36px;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-card);
  }
  .hero.has-diagram {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
    gap: 28px;
  }

  .hero-cat {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-muted);
  }

  .hero h2 {
    margin: 10px 0 0;
    font-size: clamp(24px, 3vw, 30px);
    line-height: 1.4;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero:hover h2 {
    color: var(--accent);
  }

  .hero p {
    margin: 14px 0 0;
    font-size: 16px;
    line-height: 1.8;
    color: var(--text-muted);
    max-width: 42rem;
  }

  .hero-cause {
    margin: 14px 0 0;
    padding: 0.8rem 1rem 0.85rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-subtle));
    font-size: 15.5px;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text);
    max-width: 44rem;
  }
  .cause-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  .hero-meta {
    display: flex;
    gap: 5px;
    margin-top: 16px;
    font-size: 13.5px;
    color: var(--text-dim);
  }

  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }

  .projects {
    margin-top: 36px;
  }

  .sec-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 10px;
  }

  .sec-head h2 {
    margin: 0;
    font-size: 0.9375rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .sec-head a {
    font-size: 0.875rem;
    color: var(--accent);
  }

  .projects ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .projects ul a {
    display: block;
    height: 100%;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }

  .projects ul a:hover {
    border-color: var(--accent);
  }

  .pname {
    display: block;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ptag {
    display: block;
    margin-top: 5px;
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .pstack {
    display: block;
    margin-top: 9px;
    font-size: 12px;
    color: var(--text-dim);
  }

  .strips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 48px 0 56px;
  }

  .strip {
    display: block;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    padding: 22px;
  }

  .strip {
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .strip:hover {
    transform: translateY(-1px);
    background: var(--bg-card);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .strip-num {
    font-size: 13px;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .strip-num b {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-right: 2px;
    line-height: 1.1;
  }
  .strip-title {
    margin-top: 10px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.025em;
  }

  .strip p {
    margin: 6px 0 0;
    font-size: 14px;
    line-height: 1.7;
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .projects ul,
    .strips {
      grid-template-columns: 1fr;
    }
    .intro {
      padding: 28px 0 24px;
    }
    .hero {
      padding: 20px;
    }
    .hero.has-diagram {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>

---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import Mark from '@/components/Mark.astro'
import { SITE, getCategory, getWikiTopic } from '@/consts'
import { readingMinutes, formatDate } from '@/utils/format'
import { selectHomeContent, selectRecentWiki } from '@/utils/home-content.mjs'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const notes = await getCollection('notes')
const wiki = await getCollection('wiki', ({ data }) => !data.draft)
const algoCount = (await getCollection('solutions')).length
const { recommended, rest } = selectHomeContent(posts)
const recentWiki = selectRecentWiki(wiki)
// 첫 추천 글은 큰 카드에 "원인 한 줄"까지, 나머지는 작은 카드로 둔다
const [lead, ...more] = recommended
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="wrap-wide home">
    <header class="intro">
      <p class="who">조해성 · 백엔드 개발자</p>
      <h1>{SITE.tagline}</h1>
      <p class="lead">
        느린 조회와 어긋난 데이터처럼 운영 중 만난 문제를, 화면에서 DB까지 로그와 데이터 흐름을 따라
        추적합니다. 무엇을 확인했고 왜 그 방법을 골랐는지 기록합니다.
      </p>
      <div class="entry-paths" aria-label="방문 목적에 맞게 읽기">
        <a class="primary-path" href="/posts/">문제 해결 사례 <span aria-hidden="true">→</span></a>
        <a href="/about/">소개·경력 <span aria-hidden="true">→</span></a>
      </div>
      <p class="stack-line">
        <span>Java · Spring · Oracle · MyBatis · C#/.NET · React</span>
        <span class="links"
          ><a href="/wiki/">학습 위키</a>
          <a href={SITE.githubUrl}>GitHub</a>
          <a href={SITE.linkedinUrl}>LinkedIn</a></span
        >
      </p>
    </header>

    {
      lead && (
        <section class="reading-section" aria-labelledby="recommended-title">
          <div class="section-head">
            <h2 id="recommended-title">먼저 읽을 글</h2>
            <a href="/posts/">
              글 전체 보기 <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="cards">
            {[lead, ...more].map((post, i) => {
              const cat = getCategory(post.data.category)
              const big = i === 0
              return (
                <li class:list={['card', { big }]}>
                  <span class="card-meta">
                    {cat && (
                      <span class="cat" data-cat={cat.id}>
                        {cat.name}
                      </span>
                    )}
                    <span>{readingMinutes(post.body ?? '')}분</span>
                  </span>
                  <h3>
                    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p class="note">{post.readingNote}</p>
                  {big && post.data.cause && (
                    <p class="cause">
                      <span class="cause-label">
                        <Mark size={14} />
                        원인 한 줄
                      </span>
                      {post.causeSummary ?? post.data.cause}
                    </p>
                  )}
                  <span class="read">
                    판단 과정 읽기 <span aria-hidden="true">→</span>
                  </span>
                </li>
              )
            })}
          </ul>
        </section>
      )
    }

    <div class="two-col">
      {
        rest.length > 0 && (
          <section class="reading-section other-posts" aria-labelledby="other-posts-title">
            <div class="section-head">
              <h2 id="other-posts-title">다른 글</h2>
              <span class="section-note">최근 작성순</span>
            </div>
            <ul class="rows">
              {rest.slice(0, 8).map((post) => (
                <PostRow
                  compact
                  href={`/posts/${post.id}/`}
                  title={post.data.title}
                  description={post.data.description}
                  date={post.data.date}
                  updated={post.data.updated}
                  category={post.data.category}
                  readingMinutes={readingMinutes(post.body ?? '')}
                />
              ))}
            </ul>
            <a class="all-posts" href="/posts/">
              글 전체 보기 <span aria-hidden="true">→</span>
            </a>
          </section>
        )
      }
      {posts.length === 0 && <p class="empty muted">아직 발행한 글이 없습니다.</p>}

      <section class="reading-section" aria-labelledby="recent-wiki-title">
        <div class="section-head">
          <h2 id="recent-wiki-title">최근 정리한 위키</h2>
          <a href="/wiki/">전체 {wiki.length}편 <span aria-hidden="true">→</span></a>
        </div>
        {
          recentWiki.length > 0 ? (
            <ul class="wiki-entries">
              {recentWiki.map((entry) => (
                <li>
                  <a href={`/wiki/${entry.id}/`}>
                    <span class="wiki-topic">{getWikiTopic(entry.data.topic)?.name}</span>
                    <span class="wiki-title">{entry.data.title}</span>
                  </a>
                  <time datetime={(entry.data.updated ?? entry.data.created).toISOString()}>
                    {formatDate(entry.data.updated ?? entry.data.created)}
                    {entry.data.updated ? ' 갱신' : ' 작성'}
                  </time>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">아직 공개한 위키 문서가 없습니다.</p>
          )
        }
      </section>
    </div>

    <section class="reading-section" aria-labelledby="archive-title">
      <div class="section-head">
        <h2 id="archive-title">쌓아 둔 것</h2>
        <a href="/learn/">학습 기록 둘러보기 <span aria-hidden="true">→</span></a>
      </div>
      <ul class="strips">
        <li class="strip">
          <span class="strip-num"><b>{wiki.length}</b>개 문서</span>
          <h3 class="strip-title"><a href="/wiki/">위키</a></h3>
          <span class="strip-desc">일하다 막힌 것을 그때그때 정리해 쌓는 곳.</span>
        </li>
        <li class="strip">
          <span class="strip-num"><b>{algoCount}</b>문제</span>
          <h3 class="strip-title"><a href="/algorithms/">알고리즘</a></h3>
          <span class="strip-desc">백준·프로그래머스 풀이. 티어·유형·언어별 정리.</span>
        </li>
        <li class="strip">
          <span class="strip-num"><b>{notes.length}</b>편</span>
          <h3 class="strip-title"><a href="/notes/">학습 노트 아카이브</a></h3>
          <span class="strip-desc">개발자로 전환하던 2022~2023년의 기록.</span>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    padding-bottom: 3.5rem;
  }

  /* ── 첫 화면 ─────────────────────────────────────────── */
  .intro {
    position: relative;
    isolation: isolate;
    padding-block: 2.25rem 1.875rem;
    border-bottom: 1px solid var(--border);
  }
  /* 점무늬 + 오른쪽 위 옅은 강조색. 아래로 갈수록 사라져 본문과 섞이지 않는다 */
  .intro::before {
    content: '';
    position: absolute;
    inset: 0 -24px;
    z-index: -1;
    background:
      radial-gradient(
        60rem 22rem at 100% 0%,
        color-mix(in srgb, var(--accent) 9%, transparent),
        transparent 70%
      ),
      radial-gradient(circle, var(--border-strong) 1px, transparent 1.2px) 0 0 / 22px 22px;
    -webkit-mask-image: linear-gradient(to bottom, #000 40%, transparent);
    mask-image: linear-gradient(to bottom, #000 40%, transparent);
    pointer-events: none;
  }
  .who {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-size: var(--type-label);
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.875rem, 3.5vw, 2.5rem);
    line-height: 1.25;
    letter-spacing: -0.03em;
  }
  .lead {
    margin: 0.75rem 0 0;
    max-width: 37rem;
    font-size: var(--type-body);
    line-height: 1.8;
    color: var(--text-secondary);
  }
  .entry-paths {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.375rem;
  }
  .entry-paths a {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1rem;
    min-height: var(--control-size);
    border: 1px solid var(--border-strong);
    border-radius: var(--control-radius);
    font-size: 0.9375rem;
    font-weight: 600;
    background: var(--bg);
  }
  .entry-paths .primary-path {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .entry-paths a:hover {
    border-color: var(--text);
  }
  .stack-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin: 1.375rem 0 0;
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .stack-line .links {
    display: flex;
    gap: 0.875rem;
  }
  .stack-line .links a {
    color: var(--text-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .stack-line .links a:hover {
    color: var(--accent);
  }

  /* ── 섹션 공통 ───────────────────────────────────────── */
  .reading-section {
    margin-top: 2.25rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .section-head h2 {
    margin: 0;
    font-size: var(--type-section);
    letter-spacing: -0.025em;
  }
  .section-head a,
  .all-posts {
    color: var(--accent);
    font-size: var(--type-label);
    min-height: var(--control-size);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .section-note {
    font-size: var(--type-caption);
    color: var(--text-muted);
  }

  /* ── 먼저 읽을 글: 큰 카드 1 + 작은 카드 2 ──────────── */
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .card {
    min-width: 0;
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    height: 100%;
    padding: 1.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-card);
    transition:
      border-color 0.15s ease,
      transform 0.15s ease;
  }
  .card.big {
    grid-column: 1 / -1;
  }
  .card:hover {
    border-color: var(--text);
    transform: translateY(-1px);
  }
  /* 실제 링크는 제목만 포함하고 클릭 영역과 키보드 초점 테두리는 카드 전체로 넓힌다. */
  .card a::after,
  .strip a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }
  .card a:focus-visible,
  .strip a:focus-visible {
    outline: none;
  }
  .card a:focus-visible::after,
  .strip a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .cat {
    display: inline-flex;
    align-items: center;
  }
  .card h3 {
    margin: 0;
    font-size: var(--type-article-h3);
    line-height: 1.4;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
  }
  .card.big h3 {
    font-size: 1.625rem;
    line-height: 1.3;
  }
  .card:hover h3 {
    color: var(--accent);
  }
  .note {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--text-secondary);
  }
  .cause {
    margin: 0.25rem 0 0;
    padding: 0.125rem 0 0.125rem 0.875rem;
    border-left: 3px solid var(--accent);
    font-size: 0.96875rem;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text);
  }
  .cause-label {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    margin-right: 0.5rem;
    font-size: var(--type-caption);
    font-weight: 700;
    color: var(--accent);
  }
  .read {
    margin-top: auto;
    padding-top: 0.25rem;
    font-size: var(--type-label);
    font-weight: 600;
    color: var(--accent);
  }

  /* ── 다른 글 + 최근 위키 ────────────────────────────── */
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 2.5rem;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }
  .all-posts {
    margin-top: 0.5rem;
  }
  /* 좁은 열이라 작성·수정·분을 세로로 쌓지 않고 한 줄에서 감는다. 좁은 화면은 PostRow 규칙을 따른다 */
  @media (min-width: 761px) {
    .other-posts :global(.row-content) {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
    .other-posts :global(.row .meta) {
      grid-column: 2;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.15rem 0.75rem;
      margin-top: 0.2rem;
    }
  }
  .wiki-entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wiki-entries li {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--border);
  }
  .wiki-entries li:first-child {
    padding-top: 0;
  }
  .wiki-entries a {
    display: block;
  }
  .wiki-topic,
  .wiki-entries time {
    display: block;
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .wiki-title {
    display: block;
    margin-block: 0.25rem;
    font-size: var(--type-body);
    font-weight: 600;
    line-height: 1.6;
  }
  .wiki-entries a:hover .wiki-title {
    color: var(--accent);
  }

  /* ── 쌓아 둔 것: 숫자 카드 3개 ─────────────────────── */
  .strips {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .strip {
    position: relative;
    display: block;
    height: 100%;
    padding: 1.375rem;
    border-radius: var(--radius);
    background: var(--bg-subtle);
    transition:
      transform 0.15s ease,
      background 0.15s ease;
  }
  .strip:hover {
    transform: translateY(-1px);
    background: var(--bg-card);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .strip-num {
    display: block;
    font-size: var(--type-caption);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .strip-num b {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text);
    margin-right: 2px;
    line-height: 1.1;
  }
  .strip-title {
    display: block;
    margin: 0.625rem 0 0;
    font-size: var(--type-body);
    font-weight: 700;
    letter-spacing: -0.025em;
  }
  .strip-desc {
    display: block;
    margin-top: 0.25rem;
    font-size: var(--type-caption);
    line-height: 1.6;
    color: var(--text-secondary);
  }
  .empty {
    padding-block: 2rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover,
    .strip:hover {
      transform: none;
    }
  }

  @media (max-width: 760px) {
    .intro {
      padding-block: 1.75rem 1.5rem;
    }
    .cards,
    .two-col,
    .strips {
      grid-template-columns: minmax(0, 1fr);
    }
    .two-col {
      gap: 0;
    }
    .card {
      padding: 1.125rem;
    }
    .card.big h3 {
      font-size: 1.25rem;
    }
    .card h3 {
      font-size: 1.0625rem;
    }
    .strips {
      gap: 0.625rem;
    }
    .strip {
      display: flex;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0 0.75rem;
      padding: 1rem 1.125rem;
    }
    .strip-title {
      margin-top: 0;
    }
    .strip-desc {
      flex-basis: 100%;
    }
  }
</style>

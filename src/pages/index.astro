---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import { SITE } from '@/consts'
import { selectHomeContent } from '@/utils/home-content.mjs'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const wiki = await getCollection('wiki', ({ data }) => !data.draft)
const notes = await getCollection('notes')
const solutions = await getCollection('solutions')
const { recommended, rest } = selectHomeContent(posts)
const arrow =
  '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 18l6-6M13 6l6 6"/></svg>'
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="page">
    <!-- 첫 화면: 이름 · 직무 → 한 문장 → 소개 링크. 히어로가 아니다. 직무는 본문 크기로 이름 옆에 둔다 -->
    <section class="ident" aria-labelledby="ident-title">
      <h1 id="ident-title">
        {SITE.author}{' '}<span class="role"
          ><span class="sep" aria-hidden="true">·</span>백엔드 개발자</span
        >
      </h1>
      <p class="lede">{SITE.intro}</p>
      <a class="more" href="/about/">소개 보기<Fragment set:html={arrow} /></a>
    </section>

    {
      recommended.length > 0 && (
        <section class="blk" aria-labelledby="recommended-title">
          <div class="sec-h">
            <h2 class="k" id="recommended-title">
              먼저 읽을 글
            </h2>
            <a class="more" href="/posts/">
              전체 글 {posts.length}편
              <Fragment set:html={arrow} />
            </a>
          </div>
          <ol class="rows">
            {recommended.map((post) => (
              <PostRow
                href={`/posts/${post.id}/`}
                title={post.data.title}
                date={post.data.date}
                category={post.data.category}
                cause={post.data.cause ?? post.causeSummary}
                description={post.data.description}
              />
            ))}
          </ol>
        </section>
      )
    }

    <section class="blk" aria-labelledby="recent-title">
      <div class="sec-h">
        <h2 class="k" id="recent-title">최근 글</h2>
        {
          recommended.length === 0 && (
            <a class="more" href="/posts/">
              전체 글 {posts.length}편
              <Fragment set:html={arrow} />
            </a>
          )
        }
      </div>
      {
        rest.length > 0 ? (
          <ol class="rows">
            {rest.map((post) => (
              <PostRow
                href={`/posts/${post.id}/`}
                title={post.data.title}
                date={post.data.date}
                category={post.data.category}
                description={post.data.description}
              />
            ))}
          </ol>
        ) : (
          <p class="empty">새로운 문제 해결 기록을 준비하고 있습니다.</p>
        )
      }
    </section>

    <section class="blk" aria-labelledby="more-title">
      <div class="sec-h"><h2 class="k" id="more-title">더 보기</h2></div>
      <ul class="linkrows">
        <li>
          <a href="/wiki/">
            <span class="row-t">학습 위키</span>
            <span class="row-d">{wiki.length}편 · 주제와 상태로 거르기</span>
            <Fragment set:html={arrow} />
          </a>
        </li>
        <li>
          <a href="/learn/">
            <span class="row-t">학습 기록</span>
            <span class="row-d"
              >학습 노트 {notes.length}편 · 알고리즘 풀이 {solutions.length}건</span
            >
            <Fragment set:html={arrow} />
          </a>
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>

<style>
  .empty {
    margin: 1rem 0 0;
    color: var(--fg2);
  }
</style>

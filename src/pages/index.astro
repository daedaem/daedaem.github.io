---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import CaseRow from '@/components/CaseRow.astro'
import { SITE } from '@/consts'
import { HOME_SUMMARIES } from '@/data/home-summaries'
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id),
)
// 공부한 기록으로 가는 길. 건수는 컬렉션에서 센다
const wiki = await getCollection('wiki', ({ data }) => !data.draft)
const notes = await getCollection('notes')
const solutions = await getCollection('solutions')
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="page case-page home">
    <section class="intro" aria-labelledby="home-title">
      <div class="kicker">
        <span>{SITE.author} · {SITE.role}</span><a href="/about/"
          >소개 보기 <span aria-hidden="true">→</span></a
        >
      </div>
      <h1 id="home-title">증상보다 <b>원인</b>을 고칩니다</h1>
      <p>{SITE.intro}</p>
    </section>
    <section aria-labelledby="posts-title">
      <div class="listhead">
        <h2 id="posts-title">글 <span>{posts.length}</span></h2>
      </div>
      <ol class="case-list">
        {
          posts.map((post) => (
            <CaseRow
              headingLevel={3}
              href={`/posts/${post.id}/`}
              title={post.data.title}
              description={HOME_SUMMARIES[post.id] ?? post.data.description}
              date={post.data.date}
              category={post.data.category}
            />
          ))
        }
      </ol>
    </section>
    <section aria-labelledby="study-title" class="study">
      <div class="listhead"><h2 id="study-title">공부한 기록</h2></div>
      <ul>
        <li>
          <a href="/wiki/"
            ><b>위키</b><span>개념 정리 {wiki.length}편</span><i aria-hidden="true">→</i></a
          >
        </li>
        <li>
          <a href="/learn/"
            ><b>학습 기록</b><span
              >학습 노트 {notes.length}편 · 알고리즘 풀이 {solutions.length}건</span
            ><i aria-hidden="true">→</i></a
          >
        </li>
      </ul>
    </section>
  </div>
</BaseLayout>
<style>
  .home {
    padding-top: 0;
  }
  .intro {
    padding: 40px 0 28px;
  }
  .kicker {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--fg2);
    font-size: 15px;
    line-height: 24px;
  }
  .kicker a {
    margin-left: auto;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    text-decoration: none;
  }
  .intro h1 {
    margin: 8px 0 0;
    max-width: 800px;
    font-size: 34px;
    line-height: 44px;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }
  .intro b {
    color: var(--accent);
    font-weight: 700;
    white-space: nowrap;
  }
  .intro p {
    margin: 12px 0 0;
    max-width: 42em;
    font-size: 17px;
    line-height: 28px;
    color: var(--fg2);
    text-wrap: pretty;
  }
  .listhead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 22px 0 14px;
    border-top: 1px solid var(--line);
  }
  .listhead h2 {
    margin: 0;
    font-size: 17px;
    line-height: 24px;
  }
  .listhead h2 span {
    margin-left: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .listhead > a {
    color: var(--muted);
    font-size: 15px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    margin-block: -10px;
  }
  .study {
    margin-top: 32px;
  }
  .study ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .study li + li {
    border-top: 1px solid var(--line);
  }
  .study a {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 2px 12px;
    min-height: 44px;
    padding: 12px 0;
    color: var(--fg);
    text-decoration: none;
  }
  .study b {
    font-size: 16px;
    line-height: 24px;
    font-weight: 650;
  }
  .study span {
    color: var(--muted);
    font-size: 14px;
    line-height: 22px;
    font-variant-numeric: tabular-nums;
  }
  .study i {
    margin-left: auto;
    color: var(--muted);
    font-style: normal;
  }
  .study a:hover b {
    color: var(--accent);
  }
  @media (max-width: 760px) {
    .intro {
      padding: 24px 0;
    }
    .intro h1 {
      font-size: 27px;
      line-height: 36px;
    }
    .intro p {
      font-size: 16px;
      line-height: 27px;
    }
    .kicker {
      font-size: 14px;
    }
    .listhead {
      padding: 20px 0 0;
    }
  }
</style>

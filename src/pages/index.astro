---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import PostCover from '@/components/PostCover.astro'
import { SITE, CATEGORIES, getCategory, getWikiTopic } from '@/consts'
import { readingMinutes, formatCompactDate } from '@/utils/format'
import { selectHomeContent, selectRecentWiki } from '@/utils/home-content.mjs'
import { resolvePostCover, splitEditorialTitle } from '@/utils/editorial.mjs'
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const wiki = await getCollection('wiki', ({ data }) => !data.draft)
const { recommended, rest } = selectHomeContent(posts)
const recentWiki = selectRecentWiki(wiki, 2)
const counts = new Map<string, number>()
for (const post of posts) counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1)
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="wrap-wide home">
    <header class="byline">
      <div class="identity">
        <h1>{SITE.identityTitle}</h1><p class="identity-context">{SITE.motto}</p>
      </div>
      <a href="/about/">소개·경력 <span aria-hidden="true">→</span></a>
    </header>
    <div class="reading-desk">
      <div class="reading-main">
        {
          recommended.length > 0 && (
            <section class="reading-section" aria-labelledby="recommended-title">
              <div class="section-head">
                <>
                  <h2 id="recommended-title">먼저 읽을 글</h2>
                  <a href="/posts/">
                    전체 보기 <span aria-hidden="true">→</span>
                  </a>
                </>
              </div>
              <ul class="reading-list">
                {recommended.map((post, index) => {
                  const cat = getCategory(post.data.category)
                  const cover = resolvePostCover(post.data)
                  const heading = splitEditorialTitle(post.data.title)
                  return (
                    <li
                      class:list={[
                        'editorial-card',
                        { 'lead-card': index === 0, 'without-cover': !cover },
                      ]}
                    >
                      <div class="card-copy">
                        <p class="card-meta">
                          {cat && <span class="category">{cat.name}</span>}
                          <span>{readingMinutes(post.body ?? '')}분 읽기</span>
                        </p>
                        <h3 class="card-title">
                          <a href={`/posts/${post.id}/`}>
                            {index === 0 ? (
                              <>
                                {heading.main + heading.separator}
                                {heading.subtitle && (
                                  <span class="subtitle">{heading.subtitle}</span>
                                )}
                              </>
                            ) : (
                              post.data.title
                            )}
                          </a>
                        </h3>
                      </div>
                      {cover && (
                        <div class="card-cover">
                          <PostCover
                            kind={cover.kind}
                            src={cover.src}
                            thumbnail
                            lead={index === 0}
                            sizes={
                              index === 0
                                ? '(max-width: 640px) calc((100vw - 40px) * 0.4), (max-width: 900px) 40vw, 290px'
                                : undefined
                            }
                          />
                        </div>
                      )}
                      <p class="reading-note">{post.readingNote}</p>
                    </li>
                  )
                })}
              </ul>
            </section>
          )
        }
        <section class="other-posts" aria-labelledby="other-posts-title">
          <div class="section-head"><h2 id="other-posts-title">다른 글</h2></div>
          {
            rest.length > 0 ? (
              <ul class="rows">
                {rest.slice(0, 8).map((post) => (
                  <PostRow
                    href={`/posts/${post.id}/`}
                    title={post.data.title}
                    date={post.data.date}
                    updated={post.data.updated}
                    category={post.data.category}
                    cover={resolvePostCover(post.data)}
                    readingMinutes={readingMinutes(post.body ?? '')}
                    compact
                    editorial
                    reading
                  />
                ))}
              </ul>
            ) : (
              <p class="empty">새로운 문제 해결 기록을 준비하고 있습니다.</p>
            )
          }
        </section>
      </div>
      <aside class="reading-rail">
        <nav class="topics" aria-labelledby="topic-title">
          <h2 id="topic-title">주제별 글</h2>
          <ul>
            {
              CATEGORIES.filter((category) => (counts.get(category.id) ?? 0) > 0).map(
                (category) => (
                  <li>
                    <a href={`/categories/${category.id}/`}>
                      <>
                        <span>{category.name}</span>
                        <span class="count">{counts.get(category.id)}</span>
                      </>
                    </a>
                  </li>
                ),
              )
            }
          </ul>
        </nav>
        <section class="notebook" aria-labelledby="notebook-title">
          <p class="notebook-kicker">항상 갱신 중</p><h2 id="notebook-title">
            배운 것을 쌓아 두는 곳.
          </h2>
          <p class="notebook-description">
            일하다 막힌 것, 공부하다 남긴 질문. 완성되지 않은 기록도 남깁니다.
          </p>
          <ul class="wiki-list">
            {
              recentWiki.map((doc) => (
                <li>
                  <>
                    <span class="wiki-topic">{getWikiTopic(doc.data.topic)?.name}</span>
                    <h3>
                      <a href={`/wiki/${doc.id}/`}>{doc.data.title}</a>
                    </h3>
                    <p class="wiki-date">
                      <time datetime={(doc.data.updated ?? doc.data.created).toISOString()}>
                        {formatCompactDate(doc.data.updated ?? doc.data.created)}
                      </time>{' '}
                      {doc.data.updated ? '갱신' : '작성'}
                    </p>
                  </>
                </li>
              ))
            }
          </ul>
          <a class="notebook-link" href="/wiki/"
            >학습 위키 둘러보기 <span aria-hidden="true">→</span></a
          >
        </section>
        <nav class="archive-links" aria-label="학습 기록">
          <a href="/algorithms/"
            ><span>알고리즘</span><small>백준 · 프로그래머스 풀이</small><span aria-hidden="true"
              >→</span
            ></a
          >
          <a href="/notes/"
            ><span>학습 노트</span><small>2022–2023년 기록</small><span aria-hidden="true">→</span
            ></a
          >
        </nav>
      </aside>
    </div>
  </div>
</BaseLayout>
<style>
  .home {
    padding-bottom: 3rem;
  }
  .byline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 2rem 0;
    border-bottom: 1px solid var(--border-strong);
  }
  .identity {
    min-width: 0;
  }
  .byline h1 {
    margin: 0;
    color: var(--text);
    font-size: 1.5rem;
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .identity-context {
    margin: 0.25rem 0 0;
    color: var(--text-secondary);
    font-size: var(--type-body);
    line-height: 1.6;
  }
  .byline > a,
  .section-head a,
  .notebook-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--control-size);
    color: var(--accent);
    font-size: var(--type-label);
    white-space: nowrap;
  }
  .reading-desk {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 16rem;
    gap: 4rem;
    padding-top: 2rem;
  }
  .reading-main,
  .reading-rail {
    min-width: 0;
  }
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--control-size);
    margin-bottom: 0.25rem;
  }
  .section-head h2,
  .topics h2 {
    margin: 0;
    font-size: var(--type-section);
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .reading-list,
  .rows,
  .topics ul,
  .wiki-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .editorial-card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 9rem;
    grid-template-areas: 'copy cover' 'note note';
    gap: 0.65rem 1.5rem;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border);
  }
  .card-copy {
    grid-area: copy;
    min-width: 0;
  }
  .lead-card:not(.without-cover) {
    grid-template-columns: minmax(0, 1fr) 40%;
    align-items: start;
  }
  .lead-card .subtitle {
    display: block;
    margin-top: 0.5rem;
    color: var(--accent);
    font-size: 0.8em;
    line-height: 1.6;
    font-weight: 550;
  }
  .editorial-card.without-cover {
    grid-template-columns: 1fr;
    grid-template-areas: 'copy' 'note';
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: 0 0 0.45rem;
    color: var(--text-muted);
    font-size: var(--type-caption);
  }
  .category {
    color: var(--accent);
    font-weight: 600;
  }
  .card-title {
    margin: 0;
    color: var(--text);
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.025em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .editorial-card a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .editorial-card a:focus-visible {
    outline: none;
  }
  .editorial-card a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .editorial-card:hover .card-title {
    color: var(--accent);
  }
  .card-cover {
    grid-area: cover;
    min-width: 0;
    pointer-events: none;
  }
  .reading-note {
    grid-area: note;
    margin: 0;
    font-size: var(--type-body);
    line-height: 1.75;
    color: var(--text-secondary);
  }
  .other-posts {
    margin-top: 2.5rem;
  }
  .rows {
    border-bottom: 1px solid var(--border);
  }
  .reading-rail {
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
  }
  .topics h2 {
    font-size: 1rem;
    min-height: var(--control-size);
    align-content: center;
  }
  .topics li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: var(--control-size);
    gap: 1rem;
    color: var(--text-secondary);
    font-size: var(--type-label);
  }
  .topics li a:hover {
    color: var(--accent);
    text-decoration: underline;
  }
  .count {
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
  }
  .notebook {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .notebook-kicker {
    margin: 0 0 0.5rem;
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .notebook h2 {
    margin: 0;
    font-size: var(--type-section);
    line-height: 1.5;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  .notebook-description {
    margin: 0.75rem 0 1rem;
    font-size: var(--type-body);
    line-height: 1.75;
    color: var(--text-secondary);
  }
  .wiki-list li {
    position: relative;
    padding: 1rem 0;
    border-top: 1px solid var(--border);
  }
  .wiki-topic,
  .wiki-date {
    color: var(--text-muted);
    font-size: var(--type-caption);
  }
  .wiki-list h3 {
    margin: 0.375rem 0;
    font-size: var(--type-body);
    line-height: 1.65;
    font-weight: 600;
    word-break: keep-all;
  }
  .wiki-list h3 a:hover {
    color: var(--accent);
  }
  .wiki-list a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .wiki-list a:focus-visible {
    outline: none;
  }
  .wiki-list a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .wiki-date {
    margin: 0.4rem 0 0;
  }
  .archive-links {
    display: grid;
    gap: 0.75rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .archive-links a {
    display: grid;
    grid-template-columns: 1fr auto;
    column-gap: 0.5rem;
    min-height: var(--control-size);
    font-size: var(--type-body);
  }
  .archive-links small {
    grid-column: 1;
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .archive-links [aria-hidden] {
    grid-column: 2;
    grid-row: 1 / 3;
    align-self: center;
    color: var(--accent);
  }
  @media (max-width: 900px) {
    .reading-desk {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .reading-rail {
      border-left: 0;
      padding-left: 0;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 2rem;
    }
    .notebook {
      border-top: 0;
      margin-top: 0;
      padding-top: 0;
    }
    .archive-links {
      grid-column: 1 / -1;
      grid-template-columns: 1fr 1fr;
      margin-top: 0;
    }
  }
  @media (max-width: 640px) {
    .byline {
      display: block;
      padding-block: 1.25rem;
    }
    .byline h1 {
      font-size: 1.375rem;
    }
    .byline > a {
      margin-top: 0.5rem;
    }
    .reading-desk {
      padding-top: 1.25rem;
    }
    .editorial-card {
      grid-template-columns: minmax(0, 1fr) 5.5rem;
      gap: 0.65rem 1rem;
      padding-block: 1.25rem;
    }
    .card-title {
      font-size: 1.25rem;
    }
    .card-meta {
      gap: 0.25rem 0.75rem;
    }
    .reading-rail {
      grid-template-columns: 1fr;
    }
    .notebook {
      border-top: 1px solid var(--border);
      padding-top: 1.5rem;
    }
    .archive-links {
      grid-column: auto;
      grid-template-columns: 1fr;
    }
  }
</style>

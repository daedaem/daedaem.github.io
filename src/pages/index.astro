---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import CaseRow from '@/components/CaseRow.astro'
import { SITE } from '@/consts'
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf() || b.id.localeCompare(a.id),
)
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="page case-page home">
    <section class="intro" aria-labelledby="home-title">
      <div class="kicker">
        <span>{SITE.author} · {SITE.role}</span><a href="/about/"
          >소개 보기 <span aria-hidden="true">→</span></a>
      </div>
      <h1 id="home-title">운영에서 만난 문제를 <b>원인</b>까지 따라간 기록.</h1>
      <p>
        여러 업무 도메인의 레거시 시스템을 개발·운영합니다. 무엇을 봤고 왜 그렇게 판단했는지, 그래서
        무엇이 바뀌었는지를 글로 남깁니다.
      </p>
    </section>
    <section aria-labelledby="posts-title">
      <div class="listhead">
        <h2 id="posts-title">글 <span>{posts.length}</span></h2><a href="/rss.xml">RSS</a>
      </div>
      <ol class="case-list">
        {
          posts.map((post) => (
            <CaseRow
              headingLevel={3}
              href={`/posts/${post.id}/`}
              title={post.data.title}
              description={post.data.description}
              date={post.data.date}
              category={post.data.category}
            />
          ))
        }
      </ol>
    </section>
  </div>
</BaseLayout>
<style>
  .home {
    padding-top: 0;
  }
  .intro {
    padding: 40px 0 28px;
  }
  .kicker {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
    color: var(--fg2);
    font-size: 15px;
    line-height: 24px;
  }
  .kicker a {
    margin-left: auto;
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
    text-decoration: none;
  }
  .intro h1 {
    margin: 8px 0 0;
    max-width: 800px;
    font-size: 34px;
    line-height: 44px;
    letter-spacing: -0.025em;
    font-weight: 700;
    text-wrap: balance;
  }
  .intro b {
    color: var(--accent);
    font-weight: 700;
  }
  .intro p {
    margin: 12px 0 0;
    max-width: 42em;
    font-size: 17px;
    line-height: 28px;
    color: var(--fg2);
    text-wrap: pretty;
  }
  .listhead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 22px 0 14px;
    border-top: 1px solid var(--line);
  }
  .listhead h2 {
    margin: 0;
    font-size: 17px;
    line-height: 24px;
  }
  .listhead h2 span {
    margin-left: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .listhead > a {
    color: var(--muted);
    font-size: 15px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    margin-block: -10px;
  }
  @media (max-width: 760px) {
    .intro {
      padding: 24px 0;
    }
    .intro h1 {
      font-size: 27px;
      line-height: 36px;
    }
    .intro p {
      font-size: 16px;
      line-height: 27px;
    }
    .kicker {
      font-size: 14px;
    }
    .listhead {
      padding: 20px 0 0;
    }
  }
</style>

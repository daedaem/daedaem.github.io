---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import { SITE, getCategory, getWikiTopic } from '@/consts'
import { readingMinutes, formatDate } from '@/utils/format'
import { selectHomeContent, selectRecentWiki } from '@/utils/home-content.mjs'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const notes = await getCollection('notes')
const wiki = await getCollection('wiki', ({ data }) => !data.draft)
const algoCount = (await getCollection('solutions')).length
const { recommended, rest } = selectHomeContent(posts)
const recentWiki = selectRecentWiki(wiki)
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="wrap-wide home">
    <header class="intro">
      <p class="who">조해성 · 백엔드 개발자</p>
      <h1>{SITE.tagline}</h1>
      <p class="lead">
        느린 조회와 어긋난 데이터처럼 운영 중 만난 문제를, 화면에서 DB까지 로그와 데이터 흐름을 따라
        추적합니다. 무엇을 확인했고 왜 그 방법을 골랐는지 기록합니다.
      </p>
    </header>

    {
      recommended.length > 0 && (
        <section class="reading-section" aria-labelledby="recommended-title">
          <div class="section-head">
            <h2 id="recommended-title">먼저 읽을 글</h2>
            <a href="/posts/">
              글 전체 보기 <span aria-hidden="true">→</span>
            </a>
          </div>
          <ul class="recommendations">
            {recommended.map((post) => {
              const cat = getCategory(post.data.category)
              const titleId = `recommended-${post.id}`
              return (
                <li class="recommendation">
                  <div class="reading-meta">
                    {cat && <span data-cat={cat.id}>{cat.name}</span>}
                    <span>{readingMinutes(post.body ?? '')}분</span>
                  </div>
                  <h3 id={titleId}>
                    <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                  </h3>
                  <p>{post.readingNote}</p>
                  <span class="read-link" aria-hidden="true">
                    글 읽기 →
                  </span>
                </li>
              )
            })}
          </ul>
        </section>
      )
    }

    {
      rest.length > 0 && (
        <section class="reading-section other-posts" aria-labelledby="other-posts-title">
          <div class="section-head">
            <h2 id="other-posts-title">다른 글</h2>
            <span class="section-note">최근 작성순</span>
          </div>
          <ul class="rows">
            {rest.slice(0, 8).map((post) => (
              <PostRow
                href={`/posts/${post.id}/`}
                title={post.data.title}
                description={post.data.description}
                date={post.data.date}
                updated={post.data.updated}
                category={post.data.category}
                readingMinutes={readingMinutes(post.body ?? '')}
              />
            ))}
          </ul>
          <a class="all-posts" href="/posts/">
            글 전체 보기 <span aria-hidden="true">→</span>
          </a>
        </section>
      )
    }
    {posts.length === 0 && <p class="empty muted">아직 발행한 글이 없습니다.</p>}

    <div class="notebook">
      <section aria-labelledby="recent-wiki-title">
        <div class="section-head">
          <h2 id="recent-wiki-title">최근 정리한 위키</h2>
          <a href="/wiki/">전체 {wiki.length}편 <span aria-hidden="true">→</span></a>
        </div>
        {
          recentWiki.length > 0 ? (
            <ul class="wiki-entries">
              {recentWiki.map((entry) => (
                <li>
                  <a href={`/wiki/${entry.id}/`}>
                    <span class="wiki-topic">{getWikiTopic(entry.data.topic)?.name}</span>
                    <span class="wiki-title">{entry.data.title}</span>
                  </a>
                  <time datetime={(entry.data.updated ?? entry.data.created).toISOString()}>
                    {formatDate(entry.data.updated ?? entry.data.created)}
                    {entry.data.updated ? ' 갱신' : ' 작성'}
                  </time>
                </li>
              ))}
            </ul>
          ) : (
            <p class="muted">아직 공개한 위키 문서가 없습니다.</p>
          )
        }
      </section>

      <section class="archive" aria-labelledby="archive-title">
        <div class="section-head">
          <h2 id="archive-title">학습 기록</h2>
          <a href="/learn/">둘러보기 <span aria-hidden="true">→</span></a>
        </div>
        <p>문제를 풀고 개념을 익히던 기록. 당시의 노트와 이후의 바로잡음을 함께 남깁니다.</p>
        <ul class="archive-links">
          <li>
            <a href="/algorithms/"><span>알고리즘</span><span>{algoCount}문제 →</span></a>
          </li>
          <li>
            <a href="/notes/"><span>학습 노트 아카이브</span><span>{notes.length}편 →</span></a>
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .home {
    padding-bottom: 3.5rem;
  }
  .intro {
    padding-block: 2rem 1.75rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .who {
    margin: 0 0 0.5rem;
    color: var(--accent);
    font-size: var(--type-label);
    font-weight: 600;
  }
  h1 {
    margin: 0;
    font-size: clamp(1.375rem, 3.2vw, 1.625rem);
    line-height: 1.45;
    letter-spacing: -0.035em;
  }
  .lead {
    margin: 0.75rem 0 0;
    max-width: 40rem;
    font-size: var(--type-body);
    line-height: 1.8;
    color: var(--text-muted);
  }
  .reading-section {
    margin-top: 2rem;
  }
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin-bottom: 1rem;
  }
  .section-head h2 {
    margin: 0;
    font-size: var(--type-section);
    letter-spacing: -0.025em;
  }
  .section-head a,
  .all-posts {
    color: var(--accent);
    font-size: var(--type-label);
    min-height: var(--control-size);
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
  }
  .section-note {
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .recommendations {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .recommendation {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 1.25rem 0 0.5rem;
    border-top: 2px solid var(--text);
  }
  .reading-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: var(--type-caption);
  }
  .recommendation h3 {
    margin: 0.85rem 0 0;
    font-size: 1.25rem;
    line-height: 1.55;
    letter-spacing: -0.025em;
    overflow-wrap: anywhere;
  }
  .recommendation h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .recommendation p {
    margin: 0.75rem 0 1rem;
    font-size: var(--type-body);
    line-height: 1.75;
    color: var(--text-muted);
  }
  .read-link {
    margin-top: auto;
    color: var(--accent);
    font-size: var(--type-label);
    font-weight: 600;
  }
  .recommendation:hover h3 a {
    color: var(--accent);
  }
  .recommendation:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
    border-radius: 2px;
  }
  .recommendation h3 a:focus-visible {
    outline: none;
  }
  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--border);
  }
  .other-posts {
    margin-top: 3rem;
  }
  .all-posts {
    margin-top: 0.5rem;
  }
  .notebook {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr);
    gap: 3rem;
    margin-top: 2.5rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border-strong);
  }
  .wiki-entries,
  .archive-links {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .wiki-entries li {
    padding-block: 0.85rem;
    border-bottom: 1px solid var(--border);
  }
  .wiki-entries li:first-child {
    padding-top: 0;
  }
  .wiki-entries a {
    display: block;
  }
  .wiki-topic,
  time {
    display: block;
    font-size: var(--type-caption);
    color: var(--text-muted);
  }
  .wiki-title {
    display: block;
    margin-block: 0.25rem;
    font-size: var(--type-body);
    font-weight: 600;
    line-height: 1.6;
  }
  .wiki-entries a:hover .wiki-title,
  .archive-links a:hover {
    color: var(--accent);
  }
  .archive p {
    margin: 0 0 1rem;
    font-size: var(--type-body);
    color: var(--text-muted);
    line-height: 1.75;
  }
  .archive-links a {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 0.75rem;
    min-height: var(--control-size);
    border-top: 1px solid var(--border);
    font-size: var(--type-label);
  }
  .archive-links a span:last-child {
    color: var(--text-muted);
  }
  .empty {
    padding-block: 2rem;
  }
  @media (max-width: 760px) {
    .intro {
      padding-block: 1.5rem;
    }
    .recommendations,
    .notebook {
      grid-template-columns: minmax(0, 1fr);
    }
    .recommendations {
      gap: 1.5rem;
    }
    .notebook {
      gap: 2rem;
    }
    .recommendation h3 {
      font-size: 1.1875rem;
    }
  }
</style>

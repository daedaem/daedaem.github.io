---
import { getCollection } from 'astro:content'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PostRow from '@/components/PostRow.astro'
import PostCover from '@/components/PostCover.astro'
import { SITE, getCategory, getWikiTopic } from '@/consts'
import { readingMinutes, formatCompactDate } from '@/utils/format'
import { selectHomeContent, selectRecentWiki } from '@/utils/home-content.mjs'
import { editorialCover, splitEditorialTitle } from '@/utils/editorial.mjs'

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
)
const wiki = await getCollection('wiki', ({ data }) => !data.draft)
const { recommended, rest } = selectHomeContent(posts)
const recentWiki = selectRecentWiki(wiki, 2)
---

<BaseLayout title={SITE.title} description={SITE.description} searchIndex={false}>
  <div class="wrap-wide home">
    <header class="byline">
      <p>
        <strong>{SITE.author}</strong>의 기술 블로그<span>백엔드 · 레거시 시스템 · 문제 해결</span>
      </p>
      <a href="/about/">소개·경력 <span aria-hidden="true">→</span></a>
    </header>

    {
      recommended.length > 0 && (
        <section class="reading-section" aria-labelledby="recommended-title">
          <div class="section-label">
            <h1 id="recommended-title">먼저 읽을 글</h1>
            <span aria-hidden="true">SELECTED WRITING</span>
          </div>
          <ul class="editorial-grid">
            {recommended.map((post, index) => {
              const lead = index === 0
              const cat = getCategory(post.data.category)
              const cover = editorialCover(post.id)
              const heading = splitEditorialTitle(post.data.title)
              return (
                <li class:list={['editorial-card', { 'lead-card': lead, 'without-cover': !cover }]}>
                  <div class="card-copy">
                    <p class="card-meta">
                      {cat && <span class="category">{cat.name}</span>}
                      <span>{readingMinutes(post.body ?? '')}분 읽기</span>
                    </p>
                    <h2>
                      <a href={`/posts/${post.id}/`}>
                        {lead ? (
                          <>
                            {heading.main + heading.separator}
                            {heading.subtitle && <span class="subtitle">{heading.subtitle}</span>}
                          </>
                        ) : (
                          post.data.title
                        )}
                      </a>
                    </h2>
                    <p class="reading-note">{post.readingNote}</p>
                    {lead && (
                      <span class="read" aria-hidden="true">
                        판단 과정 읽기 <span>→</span>
                      </span>
                    )}
                  </div>
                  {cover && (
                    <div class="card-cover">
                      <PostCover kind={cover} lead={lead} />
                    </div>
                  )}
                </li>
              )
            })}
          </ul>
        </section>
      )
    }

    <div class="two-col">
      <section class="other-posts" aria-labelledby="other-posts-title">
        <div class="section-head">
          <h2 id="other-posts-title">다른 글</h2>
          <a href="/posts/">전체 보기 <span aria-hidden="true">→</span></a>
        </div>
        {
          rest.length > 0 ? (
            <ul class="rows">
              {rest.slice(0, 8).map((post) => (
                <PostRow
                  href={`/posts/${post.id}/`}
                  title={post.data.title}
                  date={post.data.date}
                  updated={post.data.updated}
                  category={post.data.category}
                  readingMinutes={readingMinutes(post.body ?? '')}
                  compact
                  editorial
                />
              ))}
            </ul>
          ) : (
            <p class="empty">새로운 문제 해결 기록을 준비하고 있습니다.</p>
          )
        }
      </section>

      <aside class="notebook" aria-labelledby="notebook-title">
        <p class="notebook-kicker">항상 갱신 중</p>
        <h2 id="notebook-title">배운 것을<br /> 쌓아 두는 곳.</h2>
        <p class="notebook-description">
          일하다 막힌 것, 공부하다 남긴 질문.<br />완성되지 않은 기록도 남깁니다.
        </p>
        <ul class="wiki-list">
          {
            recentWiki.map((doc) => (
              <li>
                <span class="wiki-topic">{getWikiTopic(doc.data.topic)?.name}</span>
                <h3>
                  <a href={`/wiki/${doc.id}/`}>{doc.data.title}</a>
                </h3>
                <p class="wiki-date">
                  <time datetime={(doc.data.updated ?? doc.data.created).toISOString()}>
                    {formatCompactDate(doc.data.updated ?? doc.data.created)}
                  </time>{' '}
                  {doc.data.updated ? '갱신' : '작성'}
                </p>
              </li>
            ))
          }
        </ul>
        <a class="notebook-link" href="/wiki/"
          >학습 위키 둘러보기 <span aria-hidden="true">→</span></a
        >
      </aside>
    </div>

    <nav class="archive-links" aria-label="학습 기록">
      <a href="/algorithms/"
        ><span>알고리즘</span><small>백준 · 프로그래머스 풀이</small><span
          class="arrow"
          aria-hidden="true">→</span
        ></a
      >
      <a href="/notes/"
        ><span>학습 노트</span><small>2022–2023년 기록</small><span class="arrow" aria-hidden="true"
          >→</span
        ></a
      >
    </nav>
  </div>
</BaseLayout>

<style>
  .home {
    padding-bottom: 1rem;
  }
  .byline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 1.4rem 0 1.75rem;
    font-size: 13px;
    color: var(--text-muted);
  }
  .byline p {
    margin: 0;
  }
  .byline strong {
    color: var(--text);
    font-weight: 650;
  }
  .byline p > span {
    margin-left: 20px;
  }
  .byline a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--control-size);
    color: var(--text);
    white-space: nowrap;
  }
  .section-label {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-bottom: 1.375rem;
  }
  .section-label h1 {
    margin: 0;
    font-size: 14px;
    font-weight: 650;
  }
  .section-label > span {
    font-size: 11px;
    color: var(--text-muted);
    letter-spacing: 0.1em;
  }
  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.375rem 1.875rem;
    list-style: none;
    padding: 0 0 2.875rem;
    margin: 0;
    border-bottom: 1px solid var(--border);
  }
  .editorial-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-width: 0;
  }
  .card-cover {
    order: -1;
    min-width: 0;
  }
  .card-copy {
    min-width: 0;
  }
  .lead-card {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    gap: 2.125rem;
    align-items: center;
  }
  .lead-card .card-cover {
    order: 0;
  }
  .lead-card.without-cover {
    grid-template-columns: minmax(0, 1fr);
  }
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin: 0 0 0.75rem;
    font-size: 13px;
    color: var(--text-muted);
  }
  .category {
    color: var(--accent);
    font-weight: 650;
  }
  .editorial-card h2 {
    margin: 0;
    font-size: 22px;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: -0.025em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .lead-card h2 {
    font-size: clamp(30px, 3.3vw, 40px);
    line-height: 1.32;
    font-weight: 760;
    letter-spacing: -0.035em;
  }
  .subtitle {
    display: block;
    margin-top: 0.65rem;
    font-size: 0.65em;
    line-height: 1.5;
    font-weight: 550;
    letter-spacing: -0.025em;
  }
  .editorial-card a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 4px;
  }
  .editorial-card a:focus-visible {
    outline: none;
  }
  .editorial-card a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 6px;
  }
  .editorial-card:hover h2 {
    color: var(--accent);
  }
  .reading-note {
    margin: 0.75rem 0 0;
    font-size: 14px;
    line-height: 1.8;
    color: var(--text-muted);
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .lead-card .reading-note {
    max-width: 24rem;
    margin-top: 1rem;
    font-size: 15px;
  }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 24px;
    min-height: var(--control-size);
    margin-top: 1.375rem;
    font-size: 13px;
    font-weight: 650;
    color: var(--accent);
  }
  .read > span {
    font-size: 20px;
  }
  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: start;
    gap: 2.75rem;
    padding: 2.75rem 0;
  }
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 0.5rem;
  }
  .section-head h2 {
    font-size: 20px;
    font-weight: 650;
    margin: 0;
    letter-spacing: -0.03em;
  }
  .section-head > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: var(--control-size);
    color: var(--text-muted);
    font-size: 13px;
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .empty {
    font-size: 14px;
    color: var(--text-muted);
  }
  .notebook {
    background: var(--bg-subtle);
    border-top: 3px solid var(--accent);
    border-radius: 4px;
    padding: 1.625rem;
  }
  .notebook-kicker {
    font-size: 12px;
    color: var(--text-muted);
    margin: 0 0 1.25rem;
  }
  .notebook h2 {
    font-size: 28px;
    font-weight: 650;
    line-height: 1.4;
    letter-spacing: -0.04em;
    margin: 0 0 1rem;
  }
  .notebook-description {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.8;
    margin: 0 0 1.375rem;
  }
  .wiki-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wiki-list li {
    position: relative;
    padding: 1rem 0;
    border-top: 1px solid var(--border-strong);
  }
  .wiki-topic,
  .wiki-date {
    font-size: 13px;
    color: var(--text-muted);
  }
  .wiki-list h3 {
    font-size: 14px;
    font-weight: 550;
    line-height: 1.6;
    margin: 0.375rem 0;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .wiki-list a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
  }
  .wiki-list a:focus-visible {
    outline: none;
  }
  .wiki-list a:focus-visible::after {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .wiki-list a:hover {
    color: var(--accent);
  }
  .wiki-date {
    margin: 0;
    font-variant-numeric: tabular-nums;
  }
  .notebook-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: var(--control-size);
    font-size: 13px;
    font-weight: 600;
    margin-top: 1rem;
  }
  .archive-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-block: 1px solid var(--border);
  }
  .archive-links a {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: var(--control-size);
    padding: 1.625rem 1.5rem 1.625rem 0;
    font-size: 15px;
  }
  .archive-links a + a {
    border-left: 1px solid var(--border);
    padding-left: 1.5rem;
  }
  .archive-links small {
    font-size: 12px;
    color: var(--text-muted);
  }
  .archive-links .arrow {
    margin-left: auto;
    color: var(--text-muted);
  }
  @media (max-width: 800px) {
    .byline p > span {
      display: block;
      margin: 0.375rem 0 0;
    }
    .lead-card {
      gap: 1.5rem;
    }
    .lead-card h2 {
      font-size: 30px;
    }
    .two-col {
      gap: 1.625rem;
    }
    .archive-links small {
      display: none;
    }
  }
  @media (max-width: 640px) {
    .byline {
      align-items: flex-start;
      gap: 8px;
      padding: 1.2rem 0 1.625rem;
    }
    .byline p > span {
      font-size: 12px;
      line-height: 1.6;
    }
    .byline a {
      font-size: 12px;
    }
    .section-label {
      gap: 10px;
      padding-bottom: 1.0625rem;
    }
    .editorial-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-bottom: 2rem;
    }
    .lead-card {
      display: flex;
      gap: 1.25rem;
      align-items: stretch;
    }
    .lead-card .card-cover {
      order: 0;
    }
    .lead-card h2 {
      font-size: 30px;
      line-height: 1.28;
    }
    .subtitle {
      font-size: 20px;
      margin-top: 0.5rem;
    }
    .lead-card .reading-note {
      max-width: none;
      font-size: 14px;
      line-height: 1.7;
    }
    .lead-card .read {
      margin-top: 0.625rem;
      gap: 14px;
    }
    .editorial-card h2 {
      font-size: 21px;
    }
    .lead-card h2 {
      font-size: 30px;
    }
    .two-col {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-block: 2rem;
    }
    .notebook {
      padding: 1.5625rem;
    }
    .notebook h2 br {
      display: none;
    }
    .archive-links a {
      font-size: 14px;
      padding: 1.4375rem 0.9375rem 1.4375rem 0;
    }
    .archive-links a + a {
      padding-left: 1.125rem;
    }
  }
</style>

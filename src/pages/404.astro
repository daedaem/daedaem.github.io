---
import BaseLayout from '@/layouts/BaseLayout.astro'
---

<BaseLayout title="페이지를 찾을 수 없습니다" noindex searchIndex={false}>
  <div class="wrap page">
    <p class="code">404</p>
    <h1>페이지를 찾을 수 없습니다</h1>
    <p>주소가 바뀌었거나 없는 페이지입니다.</p>
    <p class="muted">
      2023년까지의 글은 주소 체계가 바뀌어 <a class="text-link" href="/notes/">학습 노트 아카이브</a
      >로 옮겼습니다.
    </p>
    <p class="actions">
      <button type="button" class="control-button" id="notfound-search">사이트에서 검색</button>
      <a class="text-link home-link" href="/">첫 화면으로</a>
    </p>
  </div>
</BaseLayout>

<script>
  // 주소의 마지막 조각(예: /posts/redis-cache/ → redis cache)을 검색어로 넘긴다.
  document.getElementById('notfound-search')?.addEventListener('click', () => {
    const last = decodeURIComponent(location.pathname).split('/').filter(Boolean).pop() ?? ''
    dispatchEvent(new CustomEvent('site-search', { detail: last.replace(/[-_]+/g, ' ') }))
  })
</script>

<style>
  .page {
    padding-block: 6rem 4rem;
  }
  .code {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-muted);
  }
  h1 {
    margin: 0;
    font-size: var(--type-page-title);
    letter-spacing: -0.03em;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
  }
  p {
    margin-block: 1rem;
  }
  .home-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
</style>

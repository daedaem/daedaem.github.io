---
import BaseLayout from '@/layouts/BaseLayout.astro'
import Icon from '@/components/Icon.astro'
const rows = [
  { href: '/posts/', label: '글 목록', icon: 'file-text' },
  { href: '/wiki/', label: '학습 위키', icon: 'book' },
  { href: '/notes/', label: '학습 노트 아카이브', icon: 'list' },
  { href: '/about/', label: '소개', icon: 'user' },
] as const
---

<BaseLayout title="페이지를 찾을 수 없습니다" noindex searchIndex={false}>
  <div class="page">
    <header class="phead">
      <h1>페이지를 찾을 수 없습니다 <span class="count-b">404</span></h1>
      <p class="lede">
        주소가 바뀌었거나 없는 페이지입니다. 2023년까지의 글은 주소 체계가 바뀌어 아래의 학습 노트
        아카이브로 옮겼습니다.
      </p>
    </header>
    <ul class="pills">
      {
        rows.map((row) => (
          <li>
            <a class="pill" href={row.href}>
              <Icon name={row.icon} size={15} />
              {row.label}
            </a>
          </li>
        ))
      }
      <li>
        <button type="button" class="pill" id="notfound-search">
          <Icon name="search" size={15} />
          검색
        </button>
      </li>
    </ul>
  </div>
</BaseLayout>

<script>
  // 주소의 마지막 조각(예: /posts/redis-cache/ → redis cache)을 검색어로 넘겨 검색 대화상자를 연다.
  document.getElementById('notfound-search')?.addEventListener('click', () => {
    const last = decodeURIComponent(location.pathname).split('/').filter(Boolean).pop() ?? ''
    dispatchEvent(new CustomEvent('site-search', { detail: last.replace(/[-_]+/g, ' ') }))
  })
</script>

<style>
  .pills li {
    display: flex;
  }
</style>

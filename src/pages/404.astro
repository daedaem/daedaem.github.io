---
import BaseLayout from '@/layouts/BaseLayout.astro'
const arrow =
  '<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 18l6-6M13 6l6 6"/></svg>'
const rows = [
  { href: '/posts/', label: '글 목록' },
  { href: '/wiki/', label: '학습 위키' },
  { href: '/notes/', label: '학습 노트 아카이브' },
]
---

<BaseLayout title="페이지를 찾을 수 없습니다" noindex searchIndex={false}>
  <div class="page">
    <header class="phead">
      <p class="k">404</p>
      <h1>페이지를 찾을 수 없습니다</h1>
      <p class="lede">
        주소가 바뀌었거나 없는 페이지입니다. 2023년까지의 글은 주소 체계가 바뀌어 <a
          class="text-link"
          href="/notes/">학습 노트 아카이브</a
        >로 옮겼습니다.
      </p>
    </header>
    <ul class="linkrows">
      {
        rows.map((row) => (
          <li>
            <a href={row.href}>
              <span class="row-t">{row.label}</span>
              <Fragment set:html={arrow} />
            </a>
          </li>
        ))
      }
      <li>
        <button type="button" id="notfound-search">
          <span class="row-t">검색</span>
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="m20 20-3.5-3.5"></path>
          </svg>
        </button>
      </li>
    </ul>
  </div>
</BaseLayout>

<script>
  // 주소의 마지막 조각(예: /posts/redis-cache/ → redis cache)을 검색어로 넘겨 검색 대화상자를 연다.
  document.getElementById('notfound-search')?.addEventListener('click', () => {
    const last = decodeURIComponent(location.pathname).split('/').filter(Boolean).pop() ?? ''
    dispatchEvent(new CustomEvent('site-search', { detail: last.replace(/[-_]+/g, ' ') }))
  })
</script>

<style>
  .linkrows {
    margin-top: 0.25rem;
  }
  .linkrows button {
    font: inherit;
    color: inherit;
  }
</style>

---
import BaseLayout from './BaseLayout.astro'
import Comments from '@/components/Comments.astro'
import PostRow from '@/components/PostRow.astro'
import Mark from '@/components/Mark.astro'
import { getCategory } from '@/consts'
import { tagSlug, formatDate } from '@/utils/format'
import { linkableTagSlugs } from '@/utils/tags'

interface Props {
  title: string
  description: string
  date: Date
  updated?: Date
  /** 일이 실제로 있었던 시기. 발행일 앞에 따로 보여 준다 */
  happened?: string
  category?: string
  tags?: string[]
  readingMinutes?: number
  /** 아카이브 글 상단에 안내 배너를 띄운다 */
  archived?: boolean
  /** OG 카드 경로 */
  ogSlug?: string
  /** 본문 헤딩. h2·h3만 목차에 쓴다 */
  headings?: { depth: number; slug: string; text: string }[]
  /** 이전 글(더 오래된 글)과 다음 글(더 새 글) */
  prev?: { href: string; title: string }
  next?: { href: string; title: string }
  /** 이 글을 뺀 나머지 글. 글 안에서 다른 글로 갈 수 있게 목록을 보여 준다 */
  others?: { href: string; title: string; category?: string; date: Date; happened?: string }[]
  /** 원인 한 줄. 이 사이트의 시그니처 블록으로, 제목 아래에 고정된 형태로 나온다 */
  cause?: string
}

const {
  title,
  description,
  date,
  updated,
  happened,
  category,
  tags = [],
  readingMinutes,
  archived = false,
  ogSlug,
  headings = [],
  prev,
  next,
  others = [],
  cause,
} = Astro.props

const linkable = await linkableTagSlugs()
const cat = category ? getCategory(category) : undefined
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={date}
  updatedAt={updated}
  ogSlug={ogSlug}
>
  <article class="wrap post">
    <header>
      <div class="meta">
        {
          !archived && (
            <a class="crumb" href="/posts/">
              글
            </a>
          )
        }
        {!archived && cat && <span class="sep">›</span>}
        {
          cat && (
            <a class="cat" href={`/categories/${cat.id}/`} data-cat={cat.id}>
              {cat.name}
            </a>
          )
        }
        {happened && <span class="happened">{happened}의 일</span>}
        {happened && <span class="sep">·</span>}
        <time datetime={date.toISOString()}>{formatDate(date)} 작성</time>
        {readingMinutes && <span>· {readingMinutes}분</span>}
      </div>
      <h1>{title}</h1>
      {
        cause ? (
          <p class="cause">
            <span class="cause-label">
              <Mark size={15} />
              원인 한 줄
            </span>
            {cause}
          </p>
        ) : (
          description && <p class="lead">{description}</p>
        )
      }
      {
        updated && updated.getTime() !== date.getTime() && (
          <p class="updated muted">최종 수정 {formatDate(updated)}</p>
        )
      }
    </header>

    {
      archived && (
        <aside class="archived">
          <strong>학습 노트 아카이브 (2022~2023)</strong>
          <p>
            개발자로 전환하며 자바스크립트·타입스크립트의 기초를 정리하던 시기의 글입니다. 당시의
            이해 수준을 기록으로 남기기 위해 오탈자만 고쳤고, 지금 보기에 틀린 내용은 지우지 않고
            <s>취소선</s>을 그은 뒤 바로 아래에 바로잡았습니다.
          </p>
          <p>
            <a href="/notes/">노트 전체 보기</a>
          </p>
        </aside>
      )
    }

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="목차">
          <p>목차</p>
          <ul>
            {toc.map((h) => (
              <li class={`d${h.depth}`}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    <div class="body">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) =>
            linkable.has(tagSlug(t)) ? (
              <li>
                <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
              </li>
            ) : (
              <li>#{t}</li>
            ),
          )}
        </ul>
      )
    }

    {
      (prev || next) && (
        <nav class="adjacent" aria-label="이전·다음 글">
          {prev ? (
            <a class="prev" href={prev.href}>
              <span>이전 글</span>
              <strong>{prev.title}</strong>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="next" href={next.href}>
              <span>다음 글</span>
              <strong>{next.title}</strong>
            </a>
          )}
        </nav>
      )
    }

    {
      others.length > 0 && (
        <section class="others" aria-label="다른 글">
          <div class="others-head">
            <h2>다른 글</h2>
            <a href="/posts/">전체 보기 →</a>
          </div>
          <ul class="rows">
            {others.map((o) => (
              <PostRow
                href={o.href}
                title={o.title}
                date={o.date}
                category={o.category}
                happened={o.happened}
              />
            ))}
          </ul>
        </section>
      )
    }

    {!archived && <Comments />}
  </article>
</BaseLayout>

<style>
  .post {
    padding-top: 3rem;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .cat {
    color: var(--text-muted);
    font-weight: 600;
  }
  .cat:hover {
    color: var(--text);
  }
  .crumb {
    color: var(--text-muted);
    font-weight: 600;
  }
  .crumb:hover {
    color: var(--text);
  }
  .sep {
    color: var(--text-dim);
  }

  .others {
    margin-top: 3rem;
  }
  .others-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .others-head h2 {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .others-head a {
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(28px, 4.2vw, 36px);
    line-height: 1.4;
    letter-spacing: -0.035em;
  }

  .lead {
    margin: 0.9rem 0 0;
    color: var(--text-muted);
    font-size: 16.5px;
    line-height: 1.85;
  }

  /* 시그니처 블록. 글마다 같은 자리, 같은 모양으로 원인 한 줄이 온다. */
  .cause {
    margin: 1.1rem 0 0;
    padding: 0.9rem 1.1rem 0.95rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 8px 8px 0;
    background: color-mix(in srgb, var(--accent) 7%, var(--bg-subtle));
    font-size: 16px;
    line-height: 1.75;
    font-weight: 500;
    color: var(--text);
  }
  .cause-label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-right: 0.6rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--accent);
    vertical-align: 0.1em;
    white-space: nowrap;
  }

  .updated {
    margin: 0.5rem 0 0;
    font-size: 0.8125rem;
  }

  .archived {
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }

  .archived strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .archived p {
    margin: 0 0 0.4rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .archived p:last-child {
    margin-bottom: 0;
  }

  .body {
    margin-top: 2.5rem;
  }

  .body :global(h2) {
    margin-top: 3.25rem;
    font-size: 21px;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .body :global(h3) {
    margin-top: 2.5rem;
    font-size: 17.5px;
  }

  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin-block: 1.15rem;
  }

  .body :global(li) {
    margin-block: 0.35rem;
  }

  .body :global(img) {
    display: block;
    margin: 1.75rem auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .body :global(a:hover) {
    color: var(--accent-hover);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 3rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .tags a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .toc {
    margin-top: 2.25rem;
    padding: 1.1rem 1.3rem;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }
  .toc p {
    margin: 0 0 0.5rem;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    margin-block: 0.2rem;
  }
  .toc .d3 {
    padding-left: 1rem;
  }
  .toc a {
    color: var(--text-muted);
  }
  .toc a:hover {
    color: var(--text);
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 2.5rem;
  }
  .adjacent a {
    display: block;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }
  .adjacent a:hover {
    border-color: var(--accent);
  }
  .adjacent .next {
    text-align: right;
  }
  .adjacent span {
    display: block;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .adjacent strong {
    display: block;
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  @media (max-width: 560px) {
    .adjacent {
      grid-template-columns: 1fr;
    }
    .adjacent .next {
      text-align: left;
    }
  }
</style>

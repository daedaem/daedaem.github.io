---
import BaseLayout from './BaseLayout.astro'
import Comments from '@/components/Comments.astro'
import ContentDates from '@/components/ContentDates.astro'
import { SITE, getCategory } from '@/consts'
import { tagSlug } from '@/utils/format'
import { linkableTagSlugs } from '@/utils/tags'
import { sectionLabel } from '@/plugins/rehype-section-numbers.mjs'

interface Props {
  title: string
  description: string
  date: Date
  updated?: Date
  /** 일이 실제로 있었던 시기. 작성·수정일과 별도로 보여 준다 */
  happened?: string
  category?: string
  tags?: string[]
  readingMinutes?: number
  /** 학습 노트 아카이브. 머리에 안내를 띄우고 글쓴이 카드·댓글은 두지 않는다 */
  archived?: boolean
  archiveKind?: 'learning' | 'personal'
  /** OG 카드 경로 */
  ogSlug?: string
  /** 본문 헤딩. h2·h3만 차례에 쓴다 */
  headings?: { depth: number; slug: string; text: string }[]
  /** 이전 글(더 오래된 글)과 다음 글(더 새 글) */
  prev?: { href: string; title: string }
  next?: { href: string; title: string }
  /** 현재 글과 이전·다음을 제외하고 고른 관련 사례 */
  others?: { href: string; title: string; category?: string; date: Date; updated?: Date }[]
  /** 원인 한 줄. 제목 아래 고정된 자리에 나온다 */
  cause?: string
}

const {
  title,
  description,
  date,
  updated,
  happened,
  category,
  tags = [],
  readingMinutes,
  archived = false,
  archiveKind = 'learning',
  ogSlug,
  headings = [],
  prev,
  next,
  others = [],
  cause,
} = Astro.props

const linkable = await linkableTagSlugs()
const cat = category ? getCategory(category) : undefined

// 차례. 사례 글은 h2에 절 번호(01, 02 …)를 붙이며, 본문의 .hn 라벨과 같은 순서다.
let section = 0
const toc = headings
  .filter((h) => h.depth === 2 || h.depth === 3)
  .map((h) => ({ ...h, num: !archived && h.depth === 2 ? sectionLabel(++section) : '' }))
const hasToc = toc.length >= 4

// 본문 첫머리의 고지(rehype-leading-notice가 만든 aside.notice)는 원인 한 줄 아래, 차례 위에 둔다.
const rendered = await Astro.slots.render('default')
const lead = archived
  ? ''
  : (rendered.match(/^\s*(?:<aside class="notice">[\s\S]*?<\/aside>\s*)+/)?.[0] ?? '')
const body = rendered.slice(lead.length)
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={date}
  updatedAt={updated}
  ogSlug={ogSlug}
>
  <div class="page">
    <article class:list={['art', 'post', { 'is-archived': archived }]}>
      <header class="art-head">
        <p class="meta" data-pagefind-ignore>
          {
            archived ? (
              <>
                <a href="/learn/" set:text="학습 기록" />
                <span class="sep" aria-hidden="true" set:text="›" />
                <a href="/notes/" set:text="노트" />
              </>
            ) : (
              <>
                <a href="/posts/" set:text="글" />
                {cat && <span class="sep" aria-hidden="true" set:text="›" />}
                {cat && <a href={`/categories/${cat.id}/`} data-cat={cat.id} set:text={cat.name} />}
                <span class="sep" aria-hidden="true" set:text="·" />
                글쓴이 <a href="/about/" set:text={SITE.author} />
                <span class="sep" aria-hidden="true" set:text="·" />
                백엔드 개발자
              </>
            )
          }
          <span class="sep" aria-hidden="true" set:text="·" />
          <ContentDates
            date={date}
            original={archived}
            dateLabel={archived ? '원문 작성' : ''}
            inline
          />
          {happened && <span class="sep" aria-hidden="true" set:text="·" />}
          {happened && <span class="nowrap" set:text={`사례 시점 ${happened}`} />}
          {readingMinutes && <span class="sep" aria-hidden="true" set:text="·" />}
          {readingMinutes && <span class="nowrap" set:text={`${readingMinutes}분 읽기`} />}
        </p>
        <h1 tabindex="-1">{title}</h1>
      </header>

      {
        cause && (
          <aside class="cause">
            <p class="k">원인 한 줄</p>
            <p>{cause}</p>
          </aside>
        )
      }

      {
        archived && (
          <aside class="notice archived" data-pagefind-ignore>
            <p class="k">
              {archiveKind === 'personal' ? '개인 기록 아카이브' : '학습 노트 아카이브 (2022~2023)'}
            </p>
            {archiveKind === 'personal' ? (
              <p>
                당시의 경험과 생각을 남긴 글입니다. 나중에 덧붙인 내용은 본문에 시점을 구분해
                표시했습니다.
              </p>
            ) : (
              <p>
                개발자로 전환하며 자바스크립트·타입스크립트의 기초를 정리하던 시기의 글입니다.
                당시의 이해 수준을 기록으로 남기기 위해 오탈자를 고치고 짧은 보충만 덧붙였으며, 지금
                보기에 틀린 내용은 지우지 않고 <s>취소선</s>을 그은 뒤 바로 아래에 바로잡았습니다.
              </p>
            )}
            <p>
              <a class="text-link archive-link" href="/notes/">
                노트 전체 보기
              </a>
            </p>
          </aside>
        )
      }

      {lead && <Fragment set:html={lead} />}

      {
        hasToc && (
          <details class="toc" data-pagefind-ignore>
            <summary>
              <span class="k">
                차례 <span class="n">{toc.length}</span>
              </span>
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="m6 9 6 6 6-6" />
              </svg>
            </summary>
            <ol>
              {toc.map((h) => (
                <li class:list={{ d3: h.depth === 3 }}>
                  <a href={`#${h.slug}`}>
                    {h.num && <span class="tn">{h.num}</span>}
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </details>
        )
      }

      {
        /* 넓은 화면의 오른쪽 레일. 초점 순서가 본문보다 앞서도록 차례 바로 뒤에 둔다(배치는 fixed) */
        hasToc && (
          <nav class="rail" aria-label="차례" data-pagefind-ignore>
            <p class="k">차례</p>
            <ol>
              {toc.map((h) => (
                <li class:list={{ d3: h.depth === 3 }}>
                  <a href={`#${h.slug}`}>
                    {h.num && <span class="tn">{h.num}</span>}
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
            <button type="button" class="totop">
              맨 위로
            </button>
          </nav>
        )
      }

      <div class="prose">
        <Fragment set:html={body} />
      </div>

      <footer class="art-end">
        {
          tags.length > 0 && (
            <p class="tags">
              <span class="k">태그</span>
              {tags.map((t) =>
                linkable.has(tagSlug(t)) ? (
                  <a href={`/tags/${tagSlug(t)}/`}>{t}</a>
                ) : (
                  <span class="tag">{t}</span>
                ),
              )}
            </p>
          )
        }

        {
          (prev || next) && (
            <nav class="pn" aria-label="이전·다음 글" data-pagefind-ignore>
              {prev ? (
                <a href={prev.href}>
                  <span class="k">이전 글</span>
                  <span class="pn-t">{prev.title}</span>
                </a>
              ) : (
                <span />
              )}
              {next && (
                <a class="next" href={next.href}>
                  <span class="k">다음 글</span>
                  <span class="pn-t">{next.title}</span>
                </a>
              )}
            </nav>
          )
        }

        {
          !archived && (
            <aside class="author" data-pagefind-ignore>
              <p>
                <strong>{SITE.author}</strong> · 백엔드 개발자
              </p>
              <a href="/about/">
                소개 보기
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14M13 18l6-6M13 6l6 6" />
                </svg>
              </a>
            </aside>
          )
        }

        {
          !archived && (
            <p class="ai" data-pagefind-ignore>
              사례 글은 직접 작성한 업무 기록을 바탕으로, AI의 도움을 받아 재구성하고 문장을
              다듬었습니다.
            </p>
          )
        }

        {
          others.length > 0 && (
            <section class="back" aria-label="이어 읽을 글" data-pagefind-ignore>
              <h2 class="k">이어 읽을 글</h2>
              <ul>
                {others.map((o) => (
                  <li>
                    <a href={o.href}>{o.title}</a>
                    {o.category && getCategory(o.category) && (
                      <span class="k-in">{getCategory(o.category)?.name}</span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          )
        }
      </footer>

      {!archived && <Comments />}
    </article>
  </div>
</BaseLayout>

<script>
  import { initCurrentHeading } from '@/utils/current-heading.mjs'
  import { initTocSheet } from '@/utils/toc-sheet.mjs'
  initCurrentHeading()
  initTocSheet()
  // 레일의 '맨 위로'. 올라간 뒤 초점을 제목에 두어 키보드 위치도 함께 돌아간다.
  document.querySelector<HTMLButtonElement>('.rail .totop')?.addEventListener('click', () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
    scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' })
    document.querySelector<HTMLElement>('.art-head h1')?.focus({ preventScroll: true })
  })
</script>

<style>
  /* 메타 줄의 분류 링크·글쓴이 링크는 밑줄 링크(전역 .meta a). 분류 앞 점은 [data-cat]가 그린다 */
  .meta a[data-cat] {
    white-space: nowrap;
  }
  /* 본문이 제목으로 시작하면 위 선과 여백을 겹쳐 두지 않는다 */
  .prose > :global(h2:first-child) {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  /* 아카이브 안내: 고지와 같은 모양에 라벨 한 줄 */
  .archived .k {
    margin-bottom: 0.35rem;
  }
  .archived p + p {
    margin-top: 0.6em;
  }
  .archive-link {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
  /* 이어 읽을 글. 종류 라벨(.k-in)의 nowrap은 전역 규칙이다 */
  section.back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--control-size);
  }
  section.back a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  @media (max-width: 40em) {
    .art-head h1 {
      /* 좁은 화면 예산: 첫 화면에 메타·제목·원인 한 줄이 들어온다 */
      margin-top: 0.5rem;
    }
  }
</style>

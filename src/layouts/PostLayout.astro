---
import BaseLayout from './BaseLayout.astro'
import Comments from '@/components/Comments.astro'
import PostRow from '@/components/PostRow.astro'
import Mark from '@/components/Mark.astro'
import ContentDates from '@/components/ContentDates.astro'
import { SITE, getCategory } from '@/consts'
import { tagSlug } from '@/utils/format'
import { linkableTagSlugs } from '@/utils/tags'
import { splitEditorialTitle } from '@/utils/editorial.mjs'

interface Props {
  title: string
  description: string
  date: Date
  updated?: Date
  /** 일이 실제로 있었던 시기. 작성·수정일과 별도로 보여 준다 */
  happened?: string
  category?: string
  tags?: string[]
  readingMinutes?: number
  /** 아카이브 글 상단에 안내 배너를 띄운다 */
  archived?: boolean
  archiveKind?: 'learning' | 'personal'
  /** OG 카드 경로 */
  ogSlug?: string
  /** 본문 헤딩. h2·h3만 목차에 쓴다 */
  headings?: { depth: number; slug: string; text: string }[]
  /** 이전 글(더 오래된 글)과 다음 글(더 새 글) */
  prev?: { href: string; title: string }
  next?: { href: string; title: string }
  /** 현재 글과 이전·다음을 제외하고 고른 관련 사례 */
  others?: { href: string; title: string; category?: string; date: Date; updated?: Date }[]
  /** 원인 한 줄. 이 사이트의 시그니처 블록으로, 제목 아래에 고정된 형태로 나온다 */
  cause?: string
}

const {
  title,
  description,
  date,
  updated,
  happened,
  category,
  tags = [],
  readingMinutes,
  archived = false,
  archiveKind = 'learning',
  ogSlug,
  headings = [],
  prev,
  next,
  others = [],
  cause,
} = Astro.props

const linkable = await linkableTagSlugs()
const cat = category ? getCategory(category) : undefined
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3)
const heading = splitEditorialTitle(title)
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={date}
  updatedAt={updated}
  ogSlug={ogSlug}
>
  <article
    class:list={['wrap', 'post', { 'with-toc': toc.length > 2, 'is-archived': archived }]}
    data-code-theme={archived ? 'auto' : 'dark'}
  >
    <header>
      {
        !archived && (
          <nav class="breadcrumbs" aria-label="글 위치" data-pagefind-ignore>
            <a class="crumb" href="/posts/">
              글
            </a>
            {cat && (
              <span class="sep" aria-hidden="true">
                ›
              </span>
            )}
            {cat && (
              <a class="cat" href={`/categories/${cat.id}/`} data-cat={cat.id}>
                {cat.name}
              </a>
            )}
          </nav>
        )
      }
      <h1>
        {
          archived ? (
            title
          ) : (
            <>
              {heading.main + heading.separator}
              {heading.subtitle && <span class="subtitle">{heading.subtitle}</span>}
            </>
          )
        }
      </h1>
      {
        !archived && (
          <div class="author-line" data-pagefind-ignore>
            <a href="/about/">
              <>
                <Mark size={26} />
                <strong>{SITE.author}</strong>
              </>
            </a>
            {readingMinutes && <span>{readingMinutes}분 읽기</span>}
          </div>
        )
      }
      <div class="meta" data-pagefind-ignore>
        <ContentDates date={date} updated={updated} original={archived} compact={!archived} />
        {archived && readingMinutes && <span>{readingMinutes}분</span>}
        {happened && <span class="happened">사례 시점: {happened}</span>}
      </div>
      {!cause && description && <p class="lead">{description}</p>}
    </header>

    {
      cause && (
        <p class="cause">
          <span class="cause-label">원인 한 줄</span>
          {cause}
        </p>
      )
    }

    {
      archived && (
        <aside class="archived" data-pagefind-ignore>
          <strong>
            {archiveKind === 'personal' ? '개인 기록 아카이브' : '학습 노트 아카이브 (2022~2023)'}
          </strong>
          {archiveKind === 'personal' ? (
            <p>
              당시의 경험과 생각을 남긴 글입니다. 나중에 덧붙인 내용은 본문에 시점을 구분해
              표시했습니다.
            </p>
          ) : (
            <p>
              개발자로 전환하며 자바스크립트·타입스크립트의 기초를 정리하던 시기의 글입니다. 당시의
              이해 수준을 기록으로 남기기 위해 오탈자를 고치고 짧은 보충만 덧붙였으며, 지금 보기에
              틀린 내용은 지우지 않고 <s>취소선</s>을 그은 뒤 바로 아래에 바로잡았습니다.
            </p>
          )}
          <p>
            <a href="/notes/">노트 전체 보기</a>
          </p>
        </aside>
      )
    }

    {
      toc.length > 2 && (
        <nav class="toc" aria-label="목차" data-pagefind-ignore>
          <details open>
            <summary>목차</summary>
            <ul>
              {toc.map((h) => (
                <li class={`d${h.depth}`}>
                  <a href={`#${h.slug}`}>{h.text}</a>
                </li>
              ))}
            </ul>
          </details>
        </nav>
      )
    }

    <div class="body">
      <slot />
    </div>

    {
      tags.length > 0 && (
        <ul class="tags">
          {tags.map((t) =>
            linkable.has(tagSlug(t)) ? (
              <li>
                <a href={`/tags/${tagSlug(t)}/`}>#{t}</a>
              </li>
            ) : (
              <li>#{t}</li>
            ),
          )}
        </ul>
      )
    }

    {
      (prev || next) && (
        <nav class="adjacent" aria-label="이전·다음 글" data-pagefind-ignore>
          {prev ? (
            <a class="prev" href={prev.href}>
              <span>이전 글</span>
              <strong>{prev.title}</strong>
            </a>
          ) : (
            <span />
          )}
          {next && (
            <a class="next" href={next.href}>
              <span>다음 글</span>
              <strong>{next.title}</strong>
            </a>
          )}
        </nav>
      )
    }

    {
      others.length > 0 && (
        <section class="others" aria-label="이어 읽을 글" data-pagefind-ignore>
          <div class="others-head">
            <h2>이어 읽을 글</h2>
            <a href="/posts/">전체 보기 →</a>
          </div>
          <ul class="rows">
            {others.map((o) => (
              <PostRow
                href={o.href}
                title={o.title}
                date={o.date}
                updated={o.updated}
                category={o.category}
              />
            ))}
          </ul>
        </section>
      )
    }

    {!archived && <Comments />}
  </article>
</BaseLayout>

<script>
  // 좁은 화면에서는 접힌 목차로 시작한다. JS가 없어도 목차는 그대로 읽을 수 있다.
  const contents = document.querySelector<HTMLDetailsElement>('.post > .toc details')
  const wide = matchMedia('(min-width: 1200px)')
  if (contents) {
    const sync = () => {
      contents.open = wide.matches
    }
    sync()
    wide.addEventListener('change', sync)
  }

  const entries = [...document.querySelectorAll<HTMLAnchorElement>('.post > .toc a[href^="#"]')]
    .map((link) => ({
      link,
      heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
    }))
    .filter((entry) => entry.heading)
  if (entries.length) {
    const updateCurrent = () => {
      const marker = Math.max(128, innerHeight * 0.2)
      const atBottom = scrollY + innerHeight >= document.documentElement.scrollHeight - 2
      const current = atBottom
        ? entries.at(-1)
        : entries.filter(({ heading }) => heading!.getBoundingClientRect().top <= marker).at(-1)
      for (const entry of entries) {
        if (entry === current) entry.link.setAttribute('aria-current', 'location')
        else entry.link.removeAttribute('aria-current')
      }
    }
    // Scrolling across a tall section or jumping several headings must also update the marker.
    let scheduled = false
    const schedule = () => {
      if (scheduled) return
      scheduled = true
      requestAnimationFrame(() => {
        updateCurrent()
        scheduled = false
      })
    }
    addEventListener('scroll', schedule, { passive: true })
    addEventListener('resize', schedule)
    addEventListener('hashchange', schedule)
    updateCurrent()
  }
</script>

<style>
  .post {
    padding-top: var(--page-inset);
  }
  .post > header {
    padding-bottom: 2rem;
  }

  .meta,
  .breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .meta {
    margin-top: 0.8rem;
    gap: 0.4rem 0.8rem;
  }

  .breadcrumbs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--control-size);
    min-width: var(--control-size);
    padding-inline: 0.375rem;
  }

  .cat {
    color: var(--accent);
    font-weight: 600;
  }
  .cat:hover {
    color: var(--text);
  }
  .crumb {
    color: var(--text-muted);
    font-weight: 600;
  }
  .crumb:hover {
    color: var(--text);
  }
  .sep {
    color: var(--text-dim);
  }

  .others {
    margin-top: 3rem;
  }
  .others-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 6px;
  }
  .others-head h2 {
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--text-muted);
  }
  .others-head a {
    font-size: 0.8125rem;
    color: var(--accent);
  }
  .rows {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--border);
  }

  h1 {
    margin: 0.7rem 0 0;
    font-size: clamp(31px, 4.2vw, 48px);
    line-height: 1.3;
    font-weight: 730;
    letter-spacing: -0.035em;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }
  .subtitle {
    display: block;
    color: var(--accent);
    font-size: 0.72em;
    font-weight: 550;
    margin-top: 0.75rem;
    line-height: 1.5;
  }
  .is-archived h1 {
    font-size: clamp(28px, 4.2vw, 36px);
    line-height: 1.4;
  }
  .author-line {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 1.25rem;
    font-size: 13px;
    color: var(--text-muted);
  }
  .author-line a {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: var(--control-size);
  }
  .author-line strong {
    font-weight: 650;
    color: var(--text);
  }

  .lead {
    margin: 0.9rem 0 0;
    color: var(--text-secondary);
    font-size: 16.5px;
    line-height: 1.85;
  }

  /* 시그니처 블록. 글마다 같은 자리, 같은 모양으로 원인 한 줄이 온다. */
  .cause {
    margin: 0;
    padding: 1.375rem 1.5rem;
    border-left: 3px solid var(--accent);
    border-radius: 0 4px 4px 0;
    background: var(--bg-subtle);
    font-size: var(--type-body);
    line-height: 1.85;
    font-weight: 500;
    color: var(--text);
  }
  .cause-label {
    display: block;
    margin-bottom: 0.625rem;
    font-size: 13px;
    font-weight: 650;
    color: var(--accent);
  }

  .happened {
    font-size: var(--type-caption);
    color: var(--text-muted);
  }

  .archived {
    margin-top: 2rem;
    padding: 1rem 1.2rem;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }

  .archived strong {
    display: block;
    margin-bottom: 0.25rem;
  }

  .archived p {
    margin: 0 0 0.4rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .archived p:last-child {
    margin-bottom: 0;
  }

  .body {
    margin-top: 1.75rem;
  }

  /* 첫 공개 범위 안내는 지우거나 접지 않고, 본문과 구분되는 짧은 주석으로 읽힌다. */
  .post:not(:has(.archived)) .body > :global(blockquote:first-child) {
    margin: 0 0 1.5rem;
    padding-block: 0;
    font-size: var(--type-label);
    line-height: 1.65;
  }
  .post:not(:has(.archived)) .body > :global(blockquote:first-child p) {
    margin: 0;
  }

  .body :global(h2) {
    margin-top: 3.25rem;
    font-size: var(--type-article-h2);
    line-height: 1.5;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .body :global(h3) {
    margin-top: 2.5rem;
    font-size: var(--type-article-h3);
    line-height: 1.5;
  }

  .body :global(p),
  .body :global(ul),
  .body :global(ol) {
    margin-block: 1.15rem;
  }

  .body :global(li) {
    margin-block: 0.35rem;
  }

  .body :global(img) {
    display: block;
    margin: 1.75rem auto;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .body :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .body :global(a:hover) {
    color: var(--accent-hover);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 3rem 0 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid var(--border);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .tags a:hover {
    color: var(--text);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 0.2em;
  }

  .toc {
    margin-top: 1.5rem;
    padding: 0.5rem 1rem;
    background: var(--bg-subtle);
    border-radius: var(--radius);
    font-size: 0.875rem;
  }
  .toc summary {
    cursor: pointer;
    min-height: 44px;
    align-content: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text);
  }
  .toc details[open] summary {
    margin-bottom: 0.5rem;
  }
  .toc a {
    display: block;
    padding-block: 0.25rem;
    line-height: 1.65;
  }
  @media (min-width: 1200px) {
    .post.with-toc {
      max-width: var(--measure-wide);
      display: grid;
      grid-template-columns: minmax(0, var(--measure)) minmax(0, 13rem);
      column-gap: 3rem;
      align-items: start;
    }
    .with-toc > :not(.toc) {
      grid-column: 1;
      min-width: 0;
    }
    .with-toc > .toc {
      grid-column: 2;
      grid-row: 2 / span 8;
      position: sticky;
      top: var(--header-clearance);
      max-height: calc(100vh - var(--header-clearance) - 1rem);
      overflow-y: auto;
      margin-top: 0;
      padding: 0.5rem 1rem;
      background: transparent;
      border-left: 1px solid var(--border-strong);
      border-radius: 0;
    }
  }
  .toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .toc li {
    margin-block: 0.2rem;
  }
  .toc .d3 {
    padding-left: 1rem;
  }
  .toc a {
    color: var(--text-muted);
  }
  .toc a:hover {
    color: var(--text);
  }
  .toc a[aria-current='location'] {
    color: var(--accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* 사례 글은 시안의 짙은 코드 면을 사용한다. Shiki의 검증된 다크 토큰을 그대로 재사용한다. */
  .post[data-code-theme='dark'] .body :global(pre.astro-code),
  .post[data-code-theme='dark'] .body :global(pre.astro-code span) {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
  }
  .post[data-code-theme='dark'] .body :global(pre.astro-code) {
    padding: 3.25rem 1.25rem 1.25rem;
    border-color: #454e5c;
    border-radius: 4px;
  }
  .post[data-code-theme='dark'] .body :global(pre.astro-code::before) {
    top: 16px;
    left: 1.25rem;
    right: auto;
    color: #b6c0d0;
  }
  .post[data-code-theme='dark'] .body :global(.copy-code) {
    width: var(--control-size);
    height: var(--control-size);
    top: 3px;
    right: 5px;
    border-color: #454e5c;
    background: #24292e;
    color: #ced7e4;
    opacity: 1;
  }
  .post[data-code-theme='dark'] .body :global(.copy-code:hover),
  .post[data-code-theme='dark'] .body :global(.copy-code[data-copied]) {
    color: #d2e4fc;
    border-color: #abc5e8;
  }
  @media (max-width: 640px) {
    .cause {
      padding: 1.25rem 1.125rem;
    }
    .post > header {
      padding-bottom: 1.75rem;
    }
    .subtitle {
      font-size: 0.75em;
    }
    .post[data-code-theme='dark'] .body :global(pre.astro-code) {
      padding-inline: 1rem;
    }
  }

  .adjacent {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 2.5rem;
  }
  .adjacent a {
    display: block;
    padding: 14px 16px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: border-color 0.15s ease;
  }
  .adjacent a:hover {
    border-color: var(--accent);
  }
  .adjacent .next {
    text-align: right;
  }
  .adjacent span {
    display: block;
    font-size: 0.75rem;
    color: var(--text-dim);
  }
  .adjacent strong {
    display: block;
    margin-top: 4px;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.02em;
  }
  @media (max-width: 560px) {
    .adjacent {
      grid-template-columns: 1fr;
    }
    .adjacent .next {
      text-align: left;
    }
  }
  /* 비교 B: 본문 진입과 읽기 리듬을 우선한다. 아카이브의 당시 표현은 유지한다. */
  .post[data-code-theme='dark'] {
    padding-top: 1.25rem;
  }
  .post[data-code-theme='dark'] > header {
    padding-bottom: 1.5rem;
  }
  .post[data-code-theme='dark'] h1 {
    font-size: clamp(1.75rem, 3.1vw, 2.5rem);
    line-height: 1.45;
    letter-spacing: -0.025em;
  }
  .post[data-code-theme='dark'] .subtitle {
    display: inline;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
    line-height: inherit;
    margin: 0;
  }
  .post[data-code-theme='dark'] .author-line {
    margin-top: 0.75rem;
  }
  .post[data-code-theme='dark'] .cause {
    padding: 0.5rem 0 0.5rem 1.25rem;
    background: transparent;
    border-radius: 0;
  }
  .post[data-code-theme='dark'] .cause-label {
    font-size: var(--type-label);
    margin-bottom: 0.4rem;
  }
  .post[data-code-theme='dark'] .body {
    font-size: 1.0625rem;
    line-height: 1.9;
  }
  .post[data-code-theme='dark'] .toc {
    background: transparent;
    border-block: 1px solid var(--border);
    border-radius: 0;
    padding-inline: 0;
  }
  @media (min-width: 1200px) {
    .post[data-code-theme='dark'].with-toc > .toc {
      grid-row: 1 / span 8;
      padding-left: 1.25rem;
      border-block: 0;
    }
  }
</style>
